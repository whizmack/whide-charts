+import {afterEach,expect,it,vi} from 'vitest';
+import {DrawingToolsManager} from '../lib/chart-plugins/drawing-tools/manager';
+const managers:DrawingToolsManager[]=[];afterEach(()=>{for(const m of managers.splice(0))m.destroy()});
+function fixture(){
+ const bar={time:60,open:100,high:120,low:80,close:110};
+ const preview=vi.fn(),add=vi.fn();
+ const chart={timeScale:()=>({width:()=>420,height:()=>20}),setCrosshairPosition:preview,clearCrosshairPosition:vi.fn()};
+ const series={subscribeDataChanged:vi.fn(),unsubscribeDataChanged:vi.fn(),attachPrimitive:vi.fn(),detachPrimitive:vi.fn(),data:()=>[bar],priceToCoordinate:(p:number)=>200-p};
+ const container=document.createElement("div");container.getBoundingClientRect=()=>({left:0,top:0,width:500,height:300}) as DOMRect;
+ const manager=new DrawingToolsManager({chart,series,container,intervalSec:60,timeframe:"1m",callbacks:{onAdd:add,onToolFinished:vi.fn(),onSelectionChange:vi.fn()}} as any) as any;managers.push(manager);
+ manager.toPoint=(p:{x:number;y:number})=>({time:60,price:200-p.y});
+ manager.primitive={setPreview:vi.fn(),setDrawings:vi.fn(),setSelected:vi.fn()};manager.cb={onAdd:add,onToolFinished:vi.fn(),onSelectionChange:vi.fn()};
+ manager.drawings=[];manager.selectedIds=[];manager.drag=null;manager.placing=null;manager.measureResult=null;manager.styleDefaults={};manager.keyboardEnabled=true;manager.tool='horizontal';manager.intervalSec=60;manager.timeframe='1m';manager.magnetMode='none';manager.lastPointer=null;manager.previewing=false;
+ const move=(y:number)=>manager.handleMouseMove(new MouseEvent('mousemove',{clientX:100,clientY:y}));
+ return {manager,bar,move,preview,add};
+}
+it('previews exactly the OHLC anchor the next click commits',()=>{
+ const {manager,move,preview,add}=fixture();manager.setMagnetMode('strong');move(87);
+ expect(preview).toHaveBeenLastCalledWith(110,60,manager.series);
+ manager.handleMouseDown(new MouseEvent('mousedown',{clientX:100,clientY:87,button:0}));
+ expect(add.mock.calls[0]![0].price).toBe(preview.mock.calls.at(-1)![0]);
+});
+it('weak magnet follows free price outside its threshold and snaps when close',()=>{
+ const {manager,move,preview}=fixture();manager.setMagnetMode('weak');move(20);
+ expect(preview).toHaveBeenLastCalledWith(180,60,manager.series);
+ move(87);expect(preview).toHaveBeenLastCalledWith(110,60,manager.series);
+});
+it('modifier on/off refreshes a stationary cursor and restores its free price',()=>{
+ const {manager,move,preview}=fixture();move(87);expect(preview).not.toHaveBeenCalled();
+ manager.setMagnetMode('weak');expect(preview).toHaveBeenLastCalledWith(110,60,manager.series);
+ manager.setMagnetMode('none');expect(preview).toHaveBeenLastCalledWith(113,60,manager.series);
+});
+it('inactive charts and stale pointers never override another charts crosshair',()=>{
+ const {manager,move,preview}=fixture();manager.setKeyboardEnabled(false);manager.setMagnetMode('strong');move(87);expect(preview).not.toHaveBeenCalled();
+ manager.setKeyboardEnabled(true);move(87);preview.mockClear();
+ manager.handleMouseMove(new MouseEvent('mousemove',{clientX:700,clientY:87}));manager.setMagnetMode('none');expect(preview).not.toHaveBeenCalled();
+});
+it('refreshes the preview against a growing live candle without pointer movement',()=>{
+ const {manager,bar,move,preview}=fixture();manager.setMagnetMode('strong');move(87);
+ bar.close=114;manager.series.subscribeDataChanged.mock.calls[0][0]();
+ expect(preview).toHaveBeenLastCalledWith(114,60,manager.series);
+});
+it('forgets the pointer on blur so releasing Cmd cannot revive a stale preview',()=>{
+ const {manager,move,preview}=fixture();manager.setMagnetMode('strong');move(87);
+ window.dispatchEvent(new Event('blur'));expect(manager.chart.clearCrosshairPosition).toHaveBeenCalledOnce();
+ preview.mockClear();manager.setMagnetMode('none');expect(preview).not.toHaveBeenCalled();
+});
+it('keeps the snapped crosshair after the chart processes a mouse click',()=>{
+ const {manager,move,preview}=fixture();manager.setMagnetMode('strong');move(87);preview.mockClear();
+ manager.handleMouseUp(new MouseEvent('mouseup',{clientX:100,clientY:87,button:0}));
+ expect(preview).toHaveBeenLastCalledWith(110,60,manager.series);
+});
