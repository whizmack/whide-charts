+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { act, cleanup, render } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { updateChartPreferences } from "../hooks/useChartPreferences.ts";
+
+const { createChartMock } = vi.hoisted(() => ({ createChartMock: vi.fn() }));
+
+vi.mock("lightweight-charts", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("lightweight-charts")>()),
+  createChart: createChartMock,
+}));
+
+vi.mock("../lib/chart-plugins/drawing-tools/manager.ts", () => ({
+  DrawingToolsManager: class {
+    destroy = vi.fn();
+    setDrawings = vi.fn();
+    setTool = vi.fn();
+    setMagnetMode = vi.fn();
+    setStyleDefaults = vi.fn();
+    setStayInDrawingMode = vi.fn();
+    setAccountEquity = vi.fn();
+    setKeyboardEnabled = vi.fn();
+    setSelection = vi.fn();
+    updateTimeframe = vi.fn();
+  },
+}));
+
+vi.mock("../services/queries.ts", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../services/queries.ts")>()),
+  useEconomicCalendar: () => ({ data: [] }),
+}));
+
+import { ChartPanel } from "../pages/trading/ChartPanel.tsx";
+
+function createChartHarness() {
+  const rangeChangeHandlers = new Set<(range: null) => void>();
+  const series = {
+    applyOptions: vi.fn(),
+    setData: vi.fn(),
+    setMarkers: vi.fn(),
+    update: vi.fn(),
+    data: vi.fn(() => []),
+    createPriceLine: vi.fn(() => ({ applyOptions: vi.fn(), remove: vi.fn() })),
+    removePriceLine: vi.fn(),
+    priceToCoordinate: vi.fn(() => 10),
+    coordinateToPrice: vi.fn(() => 100),
+    attachPrimitive: vi.fn(),
+    detachPrimitive: vi.fn(),
+  };
+  const priceScale = { applyOptions: vi.fn(), width: vi.fn(() => 80) };
+  const timeScale = {
+    subscribeVisibleLogicalRangeChange: vi.fn((handler) => rangeChangeHandlers.add(handler)),
+    unsubscribeVisibleLogicalRangeChange: vi.fn((handler) => rangeChangeHandlers.delete(handler)),
+    timeToCoordinate: vi.fn(() => 0),
+    resetTimeScale: vi.fn(),
+    scrollToRealTime: vi.fn(),
+  };
+  const chart = {
+    addCandlestickSeries: vi.fn(() => series),
+    addHistogramSeries: vi.fn(() => series),
+    addLineSeries: vi.fn(() => series),
+    priceScale: vi.fn(() => priceScale),
+    timeScale: vi.fn(() => timeScale),
+    applyOptions: vi.fn(),
+    subscribeCrosshairMove: vi.fn(),
+    unsubscribeCrosshairMove: vi.fn(),
+    removeSeries: vi.fn(),
+    remove: vi.fn(),
+  };
+  return { chart, series, timeScale };
+}
+
+const noOp = () => {};
+
+describe("chart settings rendering", () => {
+  beforeEach(() => {
+    localStorage.clear();
+    vi.stubGlobal(
+      "ResizeObserver",
+      class {
+        observe() {}
+        disconnect() {}
+      },
+    );
+  });
+
+  afterEach(() => {
+    cleanup();
+    vi.unstubAllGlobals();
+    vi.clearAllMocks();
+  });
+
+  it("applies settings through chart options without rebuilding the chart", () => {
+    const { chart, series } = createChartHarness();
+    createChartMock.mockReturnValue(chart);
+    const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+    const onChartReady = vi.fn();
+    const view = render(
+      <QueryClientProvider client={client}>
+        <ChartPanel
+          candles={[]}
+          selectedSymbol="BTCUSDT"
+          timeframe="5m"
+          isDark
+          activeIndicators={[]}
+          drawingTool="none"
+          drawings={[]}
+          onAddDrawing={noOp}
+          positions={[]}
+          orders={[]}
+          pipDigits={2}
+          isReplaying
+          showNews={false}
+          showDrawingTools={false}
+          onChartReady={onChartReady}
+        />
+      </QueryClientProvider>,
+    );
+
+    expect(createChartMock).toHaveBeenCalledTimes(1);
+    chart.applyOptions.mockClear();
+
+    act(() => {
+      updateChartPreferences({ colorBackground: "#20252b" });
+    });
+
+    expect(createChartMock).toHaveBeenCalledTimes(1);
+    expect(chart.applyOptions).toHaveBeenCalledWith(
+      expect.objectContaining({
+        layout: expect.objectContaining({
+          background: expect.objectContaining({ color: "#20252b" }),
+        }),
+      }),
+    );
+    expect(series.applyOptions).toHaveBeenCalled();
+    view.unmount();
+    client.clear();
+  });
+});
