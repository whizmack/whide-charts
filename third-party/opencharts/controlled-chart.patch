@@ -0,0 +1,172 @@
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { DrawingLine } from "../pages/trading/constants.ts";
+import { DrawingSettingsDialog } from "../pages/trading/drawing-settings/DrawingSettingsDialog.tsx";
+
+function rectangle(): DrawingLine {
+  return {
+    id: "rectangle-1",
+    type: "rectangle",
+    price: 100,
+    price2: 90,
+    time: 1_700_000_000,
+    time2: 1_700_000_060,
+    color: "#2962ff",
+  };
+}
+
+function position(): DrawingLine {
+  return {
+    id: "position-1",
+    type: "position",
+    side: "long",
+    price: 100,
+    stopPrice: 95,
+    targetPrice: 115,
+    time: 1_700_000_000,
+    time2: 1_700_000_060,
+    color: "#787b86",
+  };
+}
+
+function props(drawing: DrawingLine) {
+  return {
+    drawing,
+    currentTf: "5m",
+    onPreview: vi.fn(),
+    onCommit: vi.fn(),
+    onClose: vi.fn(),
+  };
+}
+
+beforeEach(() => {
+  Object.defineProperty(HTMLDialogElement.prototype, "showModal", {
+    configurable: true,
+    value: vi.fn(function showModal(this: HTMLDialogElement) {
+      this.open = true;
+    }),
+  });
+  Object.defineProperty(HTMLDialogElement.prototype, "close", {
+    configurable: true,
+    value: vi.fn(function close(this: HTMLDialogElement) {
+      this.open = false;
+    }),
+  });
+});
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+});
+
+describe("DrawingSettingsDialog", () => {
+  it("renders a named native modal in the document top layer with contextual tabs", () => {
+    const { container } = render(
+      <div style={{ overflow: "hidden" }}>
+        <DrawingSettingsDialog {...props(rectangle())} />
+      </div>,
+    );
+
+    const dialog = screen.getByRole("dialog", { name: "Rectangle settings" });
+    expect(dialog.tagName).toBe("DIALOG");
+    expect(dialog.parentElement).toBe(document.body);
+    expect(container.contains(dialog)).toBe(false);
+    expect(HTMLDialogElement.prototype.showModal).toHaveBeenCalledOnce();
+    expect(screen.getByRole("tab", { name: "Style" })).toHaveFocus();
+    expect(screen.getAllByRole("tab").map((tab) => tab.textContent)).toEqual([
+      "Style",
+      "Text",
+      "Coordinates",
+      "Visibility",
+    ]);
+  });
+
+  it.each([
+    "Cancel",
+    "Close Rectangle settings",
+  ] as const)("restores the original drawing when dismissed through %s", async (name) => {
+    const user = userEvent.setup();
+    const callbacks = props(rectangle());
+    render(<DrawingSettingsDialog {...callbacks} />);
+
+    await user.click(screen.getByRole("tab", { name: "Text" }));
+    await user.click(screen.getByRole("button", { name }));
+
+    expect(callbacks.onPreview).toHaveBeenLastCalledWith(callbacks.drawing);
+    expect(callbacks.onCommit).not.toHaveBeenCalled();
+    expect(callbacks.onClose).toHaveBeenCalledOnce();
+  });
+
+  it("restores the original drawing when Escape cancels the native dialog", () => {
+    const callbacks = props(rectangle());
+    render(<DrawingSettingsDialog {...callbacks} />);
+    const dialog = screen.getByRole("dialog", { name: "Rectangle settings" });
+
+    fireEvent(dialog, new Event("cancel", { bubbles: false, cancelable: true }));
+
+    expect(callbacks.onPreview).toHaveBeenLastCalledWith(callbacks.drawing);
+    expect(callbacks.onCommit).not.toHaveBeenCalled();
+    expect(callbacks.onClose).toHaveBeenCalledOnce();
+  });
+
+  it("commits one normalized draft and restores focus to the opening control", async () => {
+    const user = userEvent.setup();
+    const opener = document.createElement("button");
+    opener.textContent = "Drawing settings";
+    document.body.append(opener);
+    opener.focus();
+    const callbacks = props(rectangle());
+    render(<DrawingSettingsDialog {...callbacks} />);
+
+    await user.click(screen.getByRole("button", { name: "OK" }));
+
+    expect(callbacks.onCommit).toHaveBeenCalledOnce();
+    expect(callbacks.onCommit).toHaveBeenCalledWith(
+      expect.objectContaining({ id: "rectangle-1", fillOpacity: 0.14, textAlign: "center" }),
+    );
+    expect(callbacks.onPreview).not.toHaveBeenLastCalledWith(callbacks.drawing);
+    expect(callbacks.onClose).toHaveBeenCalledOnce();
+    expect(opener).toHaveFocus();
+    opener.remove();
+  });
+
+  it("announces invalid numeric input and blocks OK", async () => {
+    const user = userEvent.setup();
+    const callbacks = props(position());
+    render(<DrawingSettingsDialog {...callbacks} />);
+
+    const account = screen.getByRole("spinbutton", { name: "Account size" });
+    await user.clear(account);
+    await user.type(account, "0");
+
+    expect(screen.getByText("Account size must be greater than 0")).toHaveAttribute(
+      "role",
+      "alert",
+    );
+    expect(account).toHaveAttribute("aria-invalid", "true");
+    expect(screen.getByRole("button", { name: "OK" })).toBeDisabled();
+    expect(callbacks.onCommit).not.toHaveBeenCalled();
+  });
+
+  it("rolls focus from the last action to the active tab instead of escaping the modal", () => {
+    render(<DrawingSettingsDialog {...props(rectangle())} />);
+    const ok = screen.getByRole("button", { name: "OK" });
+    ok.focus();
+
+    fireEvent.keyDown(screen.getByRole("dialog"), { key: "Tab" });
+
+    expect(screen.getByRole("button", { name: "Rename Rectangle" })).toHaveFocus();
+    expect(screen.getByRole("dialog").contains(document.activeElement)).toBe(true);
+  });
+
+  it("rolls back a preview when selection change or deletion unmounts the dialog", () => {
+    const callbacks = props(rectangle());
+    const { unmount } = render(<DrawingSettingsDialog {...callbacks} />);
+
+    unmount();
+
+    expect(callbacks.onPreview).toHaveBeenLastCalledWith(callbacks.drawing);
+    expect(callbacks.onCommit).not.toHaveBeenCalled();
+  });
+});
