@@ -0,0 +1,143 @@
+import { describe, expect, it, vi } from "vitest";
+import type { DrawingLine } from "../pages/trading/constants.ts";
+import {
+  drawingPresentation,
+  positionLinePresentation,
+  positionReadout,
+  renderEntry,
+  shouldRenderPositionReadout,
+} from "../lib/chart-plugins/drawing-tools/renderers.ts";
+import { resolveEntry, type ResolveCtx } from "../lib/chart-plugins/drawing-tools/resolve.ts";
+import { shouldAppendAxisViews, sortDrawingsForRender } from "../lib/chart-plugins/drawing-tools/drawings-primitive.ts";
+
+function drawing(patch: Partial<DrawingLine>): DrawingLine {
+  return { id: "drawing-1", type: "rectangle", price: 100, color: "#9c27b0", ...patch };
+}
+
+describe("drawing renderer presentation", () => {
+  it("applies enabled Fibonacci values and per-level colours", () => {
+    const context = {
+      intervalSec: 60,
+      data: [{ time: 60 }, { time: 120 }],
+      chart: { timeScale: () => ({ width: () => 500, timeToCoordinate: (time: number) => time }) },
+      series: {
+        data: () => [{ time: 60 }, { time: 120 }],
+        priceToCoordinate: (price: number) => 200 - price,
+        priceFormatter: () => ({ format: (price: number) => price.toFixed(1) }),
+      },
+    } as unknown as ResolveCtx;
+    const entry = resolveEntry(drawing({
+      type: "fibonacci",
+      time: 60,
+      time2: 120,
+      price2: 80,
+      fibLevelStyles: [
+        { value: 0, enabled: false, color: "#111111" },
+        { value: 0.5, enabled: true, color: "#123456" },
+      ],
+    }), context, "normal");
+    expect(entry.fibLevels).toEqual([expect.objectContaining({ level: 0.5, color: "#123456", price: 90 })]);
+  });
+  it("resolves Rectangle border, background opacity and text alignment", () => {
+    expect(drawingPresentation(drawing({
+      opacity: 0.65,
+      fillColor: "#441155",
+      fillOpacity: 0.28,
+      textAlign: "right",
+      textPlacement: "inside",
+    }))).toMatchObject({
+      strokeColor: "rgba(156, 39, 176, 0.65)",
+      fillColor: "rgba(68, 17, 85, 0.28)",
+      textAlign: "right",
+      textPlacement: "inside",
+    });
+  });
+
+  it("uses semantic range and Position colours with legacy fallbacks", () => {
+    expect(drawingPresentation(drawing({
+      type: "date-price-range",
+      positiveColor: "#00aa88",
+      negativeColor: "#cc3355",
+      labelColor: "#eeeeee",
+    }))).toMatchObject({ positiveColor: "#00aa88", negativeColor: "#cc3355", labelColor: "#eeeeee" });
+
+    expect(drawingPresentation(drawing({ type: "position" }))).toMatchObject({
+      stopColor: "#f23645",
+      targetColor: "#089981",
+      stopFillOpacity: 0.2,
+      targetFillOpacity: 0.2,
+      labelColor: "#ffffff",
+    });
+  });
+
+  it("changes Position readouts for compact and risk-reward stat preferences", () => {
+    const info = { accountEquity: 10_000, priceFormat: (price: number) => price.toFixed(1) };
+    const value = drawing({ type: "position", side: "long", stopPrice: 95, targetPrice: 115 });
+    expect(positionReadout({ ...value, statsMode: "risk-reward", compactStats: true }, info)).toEqual([
+      "Long · RR 3.00",
+    ]);
+    expect(positionReadout({ ...value, statsMode: "price-offsets", compactStats: false }, info)).toEqual([
+      "Long  RR 3.00",
+      "T 115.0  +15.00%",
+      "S 95.0  -5.00%",
+      "Risk $100 · Qty 20.00",
+    ]);
+    expect(positionReadout({
+      ...value,
+      accountSize: 20_000,
+      riskValue: 2,
+      riskUnit: "percent",
+      statsMode: "amounts",
+    }, { ...info, accountEquity: 0 })).toEqual([
+      "Long  RR 3.00",
+      "Target $1200",
+      "Stop $400",
+      "Risk $400 · Qty 80.00",
+    ]);
+  });
+
+  it("applies Position line presentation, price-label and always-show preferences", () => {
+    const value = drawing({
+      type: "position",
+      width: 4,
+      lineStyle: "dotted",
+      opacity: 0.5,
+      showPriceLabels: false,
+      alwaysShowStats: false,
+    });
+    expect(positionLinePresentation(value)).toEqual({ color: "rgba(156, 39, 176, 0.5)", width: 4, dash: [2, 3] });
+    expect(shouldAppendAxisViews(value, true)).toBe(false);
+    expect(shouldRenderPositionReadout(value, "normal")).toBe(false);
+    expect(shouldRenderPositionReadout(value, "selected")).toBe(true);
+    expect(shouldRenderPositionReadout({ ...value, alwaysShowStats: true }, "normal")).toBe(true);
+  });
+
+  it("sorts drawing render order stably by z-index", () => {
+    const values = [
+      drawing({ id: "default-a" }),
+      drawing({ id: "front", zIndex: 2 }),
+      drawing({ id: "back", zIndex: -1 }),
+      drawing({ id: "default-b" }),
+    ];
+    expect(sortDrawingsForRender(values).map((value) => value.id)).toEqual(["back", "default-a", "default-b", "front"]);
+  });
+
+  it("renders attached Rectangle text using placement and alignment settings", () => {
+    const context = {
+      save: vi.fn(), restore: vi.fn(), beginPath: vi.fn(), fill: vi.fn(), stroke: vi.fn(),
+      fillRect: vi.fn(), strokeRect: vi.fn(), setLineDash: vi.fn(), moveTo: vi.fn(), lineTo: vi.fn(),
+      arc: vi.fn(), fillText: vi.fn(), measureText: (text: string) => ({ width: text.length * 6 }),
+    };
+    renderEntry({
+      context,
+      horizontalPixelRatio: 1,
+      verticalPixelRatio: 1,
+      bitmapSize: { width: 500, height: 300 },
+      mediaSize: { width: 500, height: 300 },
+    } as never, {
+      d: drawing({ type: "rectangle", text: "Breakout", textAlign: "right", textPlacement: "above" }),
+      x1: 100, y1: 100, x2: 300, y2: 200, state: "normal",
+    }, { accountEquity: 0, priceFormat: String });
+    expect(context.fillText).toHaveBeenCalledWith("Breakout", 296, 78);
+  });
+});
