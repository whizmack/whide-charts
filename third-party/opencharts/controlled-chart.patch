@@ -0,0 +1,62 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { act, cleanup, renderHook } from "@testing-library/react";
+import { safeStorage } from "../lib/safe-storage.ts";
+import {
+  commitChartPreferencesPreview,
+  discardChartPreferencesPreview,
+  getChartPreferencesFromStorage,
+  setChartPreferencesPreview,
+  updateChartPreferences,
+  useChartPreferences,
+} from "../hooks/useChartPreferences.ts";
+
+describe("chart settings preview", () => {
+  beforeEach(() => localStorage.clear());
+  afterEach(() => {
+    cleanup();
+    vi.restoreAllMocks();
+    discardChartPreferencesPreview();
+  });
+
+  it("previews settings without writing persistent storage", () => {
+    const hook = renderHook(() => useChartPreferences());
+    const original = getChartPreferencesFromStorage();
+    const draft = { ...original, colorBackground: "#20252b" };
+
+    act(() => setChartPreferencesPreview(draft));
+
+    expect(hook.result.current.colorBackground).toBe("#20252b");
+    expect(getChartPreferencesFromStorage().colorBackground).toBe("");
+    expect(localStorage.getItem("trader_prefs")).toBeNull();
+  });
+
+  it("commits the preview once", () => {
+    const original = getChartPreferencesFromStorage();
+    const draft = { ...original, colorBackground: "#20252b", priceScaleTopMargin: 0.3 };
+    act(() => setChartPreferencesPreview(draft));
+    const write = vi.spyOn(safeStorage, "setItem");
+
+    act(() => commitChartPreferencesPreview(draft));
+
+    expect(write).toHaveBeenCalledTimes(1);
+    expect(getChartPreferencesFromStorage()).toMatchObject({
+      colorBackground: "#20252b",
+      priceScaleTopMargin: 0.3,
+    });
+  });
+
+  it("discards the preview without changing stored settings", () => {
+    updateChartPreferences({ colorBackground: "#141920" });
+    const hook = renderHook(() => useChartPreferences());
+    const draft = { ...getChartPreferencesFromStorage(), colorBackground: "#20252b" };
+
+    act(() => setChartPreferencesPreview(draft));
+    expect(hook.result.current.colorBackground).toBe("#20252b");
+    const beforeDiscard = localStorage.getItem("trader_prefs");
+
+    act(() => discardChartPreferencesPreview());
+
+    expect(hook.result.current.colorBackground).toBe("#141920");
+    expect(localStorage.getItem("trader_prefs")).toBe(beforeDiscard);
