+import { fireEvent, render, screen } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+import type { DrawingLine } from "../pages/trading/constants.ts";
+import { DrawingFloatingToolbar } from "../pages/trading/drawing-settings/DrawingFloatingToolbar.tsx";
+import {
+  clampDrawingToolbar,
+  toolbarControlsFor,
+} from "../pages/trading/drawing-settings/toolbarModel.ts";
+
+function drawing(type: DrawingLine["type"], patch: Partial<DrawingLine> = {}): DrawingLine {
+  return { id: `${type}-1`, type, time: 1_700_000_000, price: 100, color: "#2962ff", ...patch };
+}
+
+describe("drawing floating toolbar model", () => {
+  it.each([
+    ["rectangle", ["border", "fill", "text", "visibility", "order"]],
+    ["position", ["line", "text", "stop-color", "target-color", "stats"]],
+    ["trendline", ["line", "text", "extend"]],
+    ["brush", ["line", "smooth", "close"]],
+    ["price-range", ["text", "positive-color", "negative-color"]],
+    ["text", ["text-color", "font-size", "bold", "italic"]],
+  ] as const)("returns contextual controls for %s", (type, expected) => {
+    expect(toolbarControlsFor(drawing(type))).toEqual(expect.arrayContaining([...expected]));
+  });
+
+  it("places above the selection, falls below when needed, and clamps horizontally", () => {
+    const bounds = { left: 40, top: 50, width: 350, height: 280 };
+    const size = { width: 260, height: 48 };
+    expect(clampDrawingToolbar({ x: 370, y: 180 }, bounds, size)).toMatchObject({ x: 122, y: 120, side: "above" });
+    expect(clampDrawingToolbar({ x: 80, y: 70 }, bounds, size)).toMatchObject({ x: 48, y: 82, side: "below" });
+  });
+
+  it("keeps a wide toolbar inside a 390px chart with an overflow affordance", () => {
+    const position = clampDrawingToolbar(
+      { x: 195, y: 160 },
+      { left: 0, top: 0, width: 390, height: 300 },
+      { width: 520, height: 48 },
+    );
+    expect(position).toMatchObject({ x: 8, maxWidth: 374 });
+  });
+});
+
+describe("drawing floating toolbar UI", () => {
+  it("portals into the scoped OpenCharts root so packaged styles apply", () => {
+    const root = document.createElement("div");
+    root.className = "opencharts";
+    document.body.append(root);
+    render(<DrawingFloatingToolbar drawing={drawing("rectangle")} anchor={{ x: 200, y: 160 }} bounds={{ left: 0, top: 0, width: 390, height: 300 }} onUpdate={() => {}} onClone={() => {}} onOpenSettings={() => {}} onRemove={() => {}} />);
+    const toolbar = screen.getByRole("toolbar", { name: "Selected drawing" });
+    expect(toolbar.parentElement).toBe(root);
+    expect(toolbar).toHaveClass("drawing-alignment-surface");
+    root.remove();
+  });
+
+  it("exposes named Settings, Lock and Delete actions", () => {
+    const onUpdate = vi.fn();
+    const onOpenSettings = vi.fn();
+    const onRemove = vi.fn();
+    render(<DrawingFloatingToolbar drawing={drawing("rectangle")} anchor={{ x: 200, y: 160 }} bounds={{ left: 0, top: 0, width: 390, height: 300 }} onUpdate={onUpdate} onClone={() => {}} onOpenSettings={onOpenSettings} onRemove={onRemove} />);
+
+    fireEvent.click(screen.getByRole("button", { name: "Lock drawing" }));
+    fireEvent.click(screen.getByRole("button", { name: "Hide drawing" }));
+    fireEvent.click(screen.getByRole("button", { name: "Bring drawing forward" }));
+    fireEvent.click(screen.getByRole("button", { name: "Open drawing settings" }));
+    fireEvent.click(screen.getByRole("button", { name: "Delete drawing" }));
+    expect(onUpdate).toHaveBeenCalledWith(expect.objectContaining({ locked: true }));
+    expect(onUpdate).toHaveBeenCalledWith(expect.objectContaining({ hidden: true }));
+    expect(onUpdate).toHaveBeenCalledWith(expect.objectContaining({ zIndex: 1 }));
+    expect(onOpenSettings).toHaveBeenCalledOnce();
+    expect(onRemove).toHaveBeenCalledOnce();
+  });
+
+  it("starts dragging only from the toolbar grip", () => {
+    render(<DrawingFloatingToolbar drawing={drawing("trendline")} anchor={{ x: 220, y: 170 }} bounds={{ left: 0, top: 0, width: 500, height: 320 }} onUpdate={() => {}} onClone={() => {}} onOpenSettings={() => {}} onRemove={() => {}} />);
+    const toolbar = screen.getByRole("toolbar", { name: "Selected drawing" });
+    const initial = toolbar.getAttribute("style");
+    const pointer = (type: string, x: number, y: number, pointerId: number) => {
+      const event = new Event(type, { bubbles: true });
+      Object.defineProperties(event, { clientX: { value: x }, clientY: { value: y }, pointerId: { value: pointerId } });
+      return event;
+    };
+    fireEvent(screen.getByRole("button", { name: "Line style" }), pointer("pointerdown", 80, 80, 1));
+    fireEvent(window, pointer("pointermove", 180, 180, 1));
+    expect(toolbar.getAttribute("style")).toBe(initial);
+
+    fireEvent(screen.getByRole("button", { name: "Move drawing toolbar" }), pointer("pointerdown", 80, 80, 2));
+    fireEvent(window, pointer("pointermove", 120, 110, 2));
+    expect(toolbar.getAttribute("style")).not.toBe(initial);
+  });
+
+  it("cleans up drag listeners when the toolbar unmounts", () => {
+    const remove = vi.spyOn(window, "removeEventListener");
+    const { unmount } = render(<DrawingFloatingToolbar drawing={drawing("rectangle")} anchor={{ x: 220, y: 170 }} bounds={{ left: 0, top: 0, width: 500, height: 320 }} onUpdate={() => {}} onClone={() => {}} onOpenSettings={() => {}} onRemove={() => {}} />);
+    const event = new Event("pointerdown", { bubbles: true });
+    Object.defineProperties(event, { clientX: { value: 80 }, clientY: { value: 80 }, pointerId: { value: 9 } });
+    fireEvent(screen.getByRole("button", { name: "Move drawing toolbar" }), event);
+    unmount();
+    expect(remove).toHaveBeenCalledWith("pointermove", expect.any(Function));
+    expect(remove).toHaveBeenCalledWith("pointerup", expect.any(Function));
+    expect(remove).toHaveBeenCalledWith("pointercancel", expect.any(Function));
+  });
+});
