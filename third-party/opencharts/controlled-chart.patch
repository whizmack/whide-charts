+import {describe,expect,it} from 'vitest';
+import * as geometryModule from '../lib/chart-plugins/drawing-tools/geometry';
+import * as publicApiModule from '../index';
+
+type Point={x:number;y:number};
+type DataPoint={time:number;price:number};
+type GeometryApi={
+ simplifyPath?:(points:Point[],tolerance:number)=>Point[];
+ quadraticPoint?:(start:Point,control:Point,end:Point,t:number)=>Point;
+ distToPolyline?:(point:Point,line:Point[])=>number;
+ distToQuadratic?:(point:Point,start:Point,control:Point,end:Point)=>number;
+ translateDataPoints?:(points:DataPoint[],timeDelta:number,priceDelta:number)=>DataPoint[];
+ rangeStats?:(startTime:number,endTime:number,startPrice:number,endPrice:number,barTimes:number[])=>{
