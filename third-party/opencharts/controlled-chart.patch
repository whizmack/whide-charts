index 0000000..b187d60
--- /dev/null
+++ b/src/pages/trading/chartSettingsTemplates.ts
@@ -0,0 +1,132 @@
+import {
+  getChartPreferencesFromStorage,
+  TEMPLATE_PREF_KEYS,
+  updateChartPreferences,
+  type ChartPreferences,
+  type TemplatePrefKey,
+} from "../../hooks/useChartPreferences.ts";
+import { readTraderPrefs } from "../../hooks/useTraderPreferences.ts";
+import { useAuthStore } from "../../services/store.tsx";
+
+export interface ChartSettingsTemplate {
+  id: string;
+  name: string;
+  preferences: Partial<ChartPreferences>;
+}
+
+const ENUM_VALUES: Partial<Record<TemplatePrefKey, readonly string[]>> = {
+  displayTimezone: [],
+  priceScaleMode: ["normal", "logarithmic", "percentage", "indexedTo100"],
+  priceScaleSide: ["right", "left"],
+  timeScaleDateFormat: ["locale", "yyyy-MM-dd", "dd MMM yyyy", "MMM dd, yyyy"],
+  timeScaleTimeFormat: ["24-hour", "12-hour"],
+  timeScaleSecondsVisible: ["auto"],
+  timeScaleRightOffset: ["default"],
+  watermarkMode: ["none", "symbol", "symbol-timeframe"],
+  crosshairLineStyle: ["solid", "dotted", "dashed", "large-dashed"],
+  chartBackgroundMode: ["solid", "transparent"],
+};
+
+function isTemplateValue(key: TemplatePrefKey, value: unknown): boolean {
+  const defaults = getChartPreferencesFromStorage();
+  const expected = defaults[key];
+  if (key === "pricePrecision") {
+    return value === "default" || (typeof value === "number" && Number.isInteger(value) && value >= 0 && value <= 8);
+  }
+  if (key === "priceScaleTopMargin" || key === "priceScaleBottomMargin") {
+    return typeof value === "number" && Number.isFinite(value) && value >= 0 && value <= 0.45;
+  }
+  if (key === "scaleTextSize") return typeof value === "number" && Number.isFinite(value) && value >= 8 && value <= 20;
+  if (key === "timeScaleRightOffset") {
+    return value === "default" || (typeof value === "number" && Number.isInteger(value) && value >= 0 && value <= 50);
+  }
+  if (key === "timeScaleSecondsVisible") return value === "auto" || typeof value === "boolean";
+  if (key === "displayTimezone") {
+    if (typeof value !== "string") return false;
+    try {
+      new Intl.DateTimeFormat("en", { timeZone: value });
+      return true;
+    } catch {
+      return false;
+    }
+  }
+  if (typeof value !== typeof expected) return false;
+  if (key.startsWith("color") || key.startsWith("candle")) {
+    return value === "" || (typeof value === "string" && /^#(?:[\da-f]{3}|[\da-f]{6}|[\da-f]{8})$/i.test(value));
+  }
+  if (typeof value === "string") {
+    const allowed = ENUM_VALUES[key];
+    return allowed ? allowed.includes(value) : true;
+  }
+  return true;
+}
+
+function supportedPreferences(value: unknown): Partial<ChartPreferences> {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return {};
+  const input = value as Record<string, unknown>;
+  const result: Partial<ChartPreferences> = {};
+  for (const key of TEMPLATE_PREF_KEYS) {
+    if (Object.hasOwn(input, key) && isTemplateValue(key, input[key])) {
+      Object.assign(result, { [key]: input[key] });
+    }
+  }
+  return result;
+}
+
+function parseTemplates(raw: string | undefined): ChartSettingsTemplate[] {
+  if (!raw) return [];
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) return [];
+    return parsed.flatMap((entry): ChartSettingsTemplate[] => {
+      if (!entry || typeof entry !== "object") return [];
+      const candidate = entry as Record<string, unknown>;
+      if (typeof candidate.id !== "string" || typeof candidate.name !== "string" || !candidate.name.trim()) return [];
+      return [{
+        id: candidate.id,
+        name: candidate.name.trim(),
+        preferences: supportedPreferences(candidate.preferences),
+      }];
+    });
+  } catch {
+    return [];
+  }
+}
+
+function writeTemplates(templates: ChartSettingsTemplate[]): void {
+  updateChartPreferences({
+    chartSettingsTemplates: JSON.stringify(templates),
+  } as unknown as Partial<ChartPreferences>);
+}
+
+function newTemplateId(): string {
+  if (typeof crypto !== "undefined" && typeof crypto.randomUUID === "function") return crypto.randomUUID();
+  return `chart-settings-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
+}
+
+export function readChartSettingsTemplates(): ChartSettingsTemplate[] {
+  const userId = useAuthStore.getState().user?.id;
+  return parseTemplates(readTraderPrefs(userId).chartSettingsTemplates);
+}
+
+export function saveChartSettingsTemplate(name: string, prefs: ChartPreferences): ChartSettingsTemplate[] {
+  const normalizedName = name.trim();
+  const current = readChartSettingsTemplates();
+  if (!normalizedName) return current;
+  const matching = current.find((template) => template.name.toLocaleLowerCase() === normalizedName.toLocaleLowerCase());
+  const template: ChartSettingsTemplate = {
+    id: matching?.id ?? newTemplateId(),
+    name: normalizedName,
+    preferences: supportedPreferences(prefs),
+  };
+  const next = [template, ...current.filter((entry) => entry.id !== template.id && entry.name.toLocaleLowerCase() !== normalizedName.toLocaleLowerCase())];
+  writeTemplates(next);
+  return next;
+}
+
+export function deleteChartSettingsTemplate(id: string): ChartSettingsTemplate[] {
+  const current = readChartSettingsTemplates();
+  const next = current.filter((template) => template.id !== id);
+  if (next.length !== current.length) writeTemplates(next);
+  return next;
+}
