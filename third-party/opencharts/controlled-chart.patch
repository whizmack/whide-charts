+import { describe, expect, it } from "vitest";
+import type { DrawingLine } from "../pages/trading/constants";
+import { hitTest } from "../lib/chart-plugins/drawing-tools/hit-test";
+import { resolveEntry, type ResolveCtx } from "../lib/chart-plugins/drawing-tools/resolve";
+
+const context = {
+  intervalSec: 60,
+  data: [{ time: 60 }, { time: 120 }, { time: 180 }],
+  chart: {
+    timeScale: () => ({
+      width: () => 500,
+      timeToCoordinate: (time: number) => time,
+      logicalToCoordinate: (logical: number) => logical * 60 + 60,
+    }),
+  },
+  series: {
+    data: () => [{ time: 60 }, { time: 120 }, { time: 180 }],
+    priceToCoordinate: (price: number) => 200 - price,
+    priceFormatter: () => ({ format: (price: number) => price.toFixed(1) }),
+  },
+} as unknown as ResolveCtx;
+
+function drawing(overrides: Partial<DrawingLine>): DrawingLine {
+  return { id: "d", type: "brush", price: 100, color: "#2962ff", ...overrides };
+}
+
+describe("drawing pack resolving and hit testing", () => {
+  it("resolves every freehand point and hits both an indexed anchor and path body", () => {
+    const entry = resolveEntry(
+      drawing({ points: [{ time: 60, price: 100 }, { time: 120, price: 110 }, { time: 180, price: 100 }] }),
+      context,
+      "selected",
+    );
+    expect(entry.points).toEqual([{ x: 60, y: 100 }, { x: 120, y: 90 }, { x: 180, y: 100 }]);
+    expect(hitTest([entry], { x: 120, y: 90 })).toEqual({
+      id: "d",
+      region: { kind: "point", pointIndex: 1, timeKey: null, priceKey: null },
+    });
+    expect(hitTest([entry], { x: 90, y: 97 })).toEqual({ id: "d", region: { kind: "body" } });
+  });
+
+  it("resolves a curve control anchor and hits its quadratic stroke", () => {
+    const entry = resolveEntry(
+      drawing({ type: "curve", time: 60, price: 100, controlTime: 120, controlPrice: 120, time2: 180, price2: 100 }),
+      context,
+      "selected",
+    );
+    expect(entry.control).toEqual({ x: 120, y: 80 });
+    expect(hitTest([entry], { x: 120, y: 90 })).toEqual({ id: "d", region: { kind: "body" } });
+  });
+
+  it("derives range labels from loaded bar timestamps", () => {
+    const entry = resolveEntry(
+      drawing({ type: "date-price-range", time: 60, price: 100, time2: 180, price2: 120 }),
+      context,
+      "selected",
+    );
+    expect(entry.stats).toEqual(["+20.0 (20.00%)", "2 bars", "2m"]);
+
+    const compact = resolveEntry(
+      drawing({ type: "date-price-range", time: 60, price: 100, time2: 180, price2: 120, rangeLabelMode: "compact" }),
+      context,
+      "selected",
+    );
+    expect(compact.stats).toEqual(["+20.0 (20.00%) · 2 bars · 2m"]);
+  });
+
+  it("treats Date Range as a full-height time band and Note as a compact marker", () => {
+    const dateRange = resolveEntry(
+      drawing({ type: "date-range", time: 60, price: 100, time2: 180, price2: 120 }),
+      context,
+      "normal",
+    );
+    expect(hitTest([dateRange], { x: 120, y: 600 })).toEqual({ id: "d", region: { kind: "body" } });
+
+    const note = resolveEntry(
+      drawing({ type: "note", time: 60, price: 100, text: "A deliberately long note" }),
+      context,
+      "normal",
+    );
+    expect(hitTest([note], { x: 64, y: 104 })).not.toBeNull();
+    expect(hitTest([note], { x: 150, y: 104 })).toBeNull();
+  });
+});
