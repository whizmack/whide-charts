+import { beforeEach, describe, expect, it } from "vitest";
+import { useAuthStore } from "../services/store.tsx";
+import { readTraderPrefs, getTraderPrefsStorageKey } from "../hooks/useTraderPreferences.ts";
+import { getChartPreferencesFromStorage, updateChartPreferences } from "../hooks/useChartPreferences.ts";
+import {
+  deleteChartSettingsTemplate,
+  readChartSettingsTemplates,
+  saveChartSettingsTemplate,
+} from "../pages/trading/chartSettingsTemplates.ts";
+
+describe("local chart settings templates", () => {
+  beforeEach(() => localStorage.clear());
+
+  it("saves and lists named chart settings templates", () => {
+    const prefs = getChartPreferencesFromStorage();
+    const templates = saveChartSettingsTemplate("Night desk", {
+      ...prefs,
+      colorBackground: "#141920",
+      showVerticalGrid: false,
+    });
+
+    expect(templates).toHaveLength(1);
+    expect(templates[0]).toMatchObject({
+      name: "Night desk",
+      preferences: { colorBackground: "#141920", showVerticalGrid: false },
+    });
+    expect(readChartSettingsTemplates()).toEqual(templates);
+    expect(readTraderPrefs().chartSettingsTemplates).toBeDefined();
+  });
+
+  it("preserves weekday-label visibility in a settings template", () => {
+    const prefs = getChartPreferencesFromStorage();
+    const templates = saveChartSettingsTemplate("Weekdays", {
+      ...prefs,
+      timeScaleShowDayOfWeek: false,
+    });
+
+    expect(templates[0]!.preferences.timeScaleShowDayOfWeek).toBe(false);
+  });
+
+  it("preserves price scale inversion in a settings template", () => {
+    const prefs = getChartPreferencesFromStorage();
+    const templates = saveChartSettingsTemplate("Inverted", {
+      ...prefs,
+      priceScaleInverted: true,
+    });
+
+    expect(templates[0]!.preferences.priceScaleInverted).toBe(true);
+  });
+
+  it("preserves overlapping-label behavior in a settings template", () => {
+    const prefs = getChartPreferencesFromStorage();
+    const templates = saveChartSettingsTemplate("Compact labels", {
+      ...prefs,
+      noOverlappingLabels: false,
+    });
+
+    expect(templates[0]!.preferences.noOverlappingLabels).toBe(false);
+  });
+
+  it("replaces a same-name template without duplicates", () => {
+    const defaults = getChartPreferencesFromStorage();
+    const initial = saveChartSettingsTemplate("Scalp", { ...defaults, colorBackground: "#111111" });
+    const updated = saveChartSettingsTemplate("Scalp", { ...defaults, colorBackground: "#222222" });
+
+    expect(updated).toHaveLength(1);
+    expect(updated[0]!.id).toBe(initial[0]!.id);
+    expect(updated[0]!.preferences.colorBackground).toBe("#222222");
+  });
+
+  it("loads only supported chart preference keys", () => {
+    const key = getTraderPrefsStorageKey(useAuthStore.getState().user?.id);
+    localStorage.setItem(key, JSON.stringify({
+      chartSettingsTemplates: JSON.stringify([{
+        id: "fixture",
+        name: "Imported",
+        preferences: { colorBackground: "#20252b", drawings: [{ id: "never" }], replayCursor: 42 },
+      }]),
+    }));
+
+    expect(readChartSettingsTemplates()[0]!.preferences).toEqual({ colorBackground: "#20252b" });
+  });
+
+  it("deletes a template without changing the active preferences", () => {
+    updateChartPreferences({ colorBackground: "#141920" });
+    const before = getChartPreferencesFromStorage();
+    const template = saveChartSettingsTemplate("Temporary", before)[0]!;
+
+    expect(deleteChartSettingsTemplate(template.id)).toEqual([]);
+    expect(getChartPreferencesFromStorage()).toEqual(before);
+  });
+});
