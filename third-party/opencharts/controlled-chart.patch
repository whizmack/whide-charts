diff --git a/src/pages/trading/chart-settings/SettingsControls.tsx b/src/pages/trading/chart-settings/SettingsControls.tsx
new file mode 100644
index 0000000..a2322ec
--- /dev/null
+++ b/src/pages/trading/chart-settings/SettingsControls.tsx
@@ -0,0 +1,146 @@
+import { useEffect, useId, useState, type ReactNode } from "react";
+import { TradingViewColorPicker } from "../../../components/TradingViewColorPicker.tsx";
+
+export interface SettingsTabProps<P> {
+  prefs: P;
+  onChange: (patch: Partial<P>) => void;
+}
+
+export function SettingsSection({ children }: { children: ReactNode }) {
+  return <h3 className="chart-settings-section-title">{children}</h3>;
+}
+
+export function SettingsCheckRow({
+  label,
+  checked,
+  onChange,
+  hint,
+  indent = false,
+}: {
+  label: string;
+  checked: boolean;
+  onChange: (value: boolean) => void;
+  hint?: string;
+  indent?: boolean;
+}) {
+  const id = useId();
+  return (
+    <label className={`chart-settings-check-row${indent ? " is-indented" : ""}`} htmlFor={id}>
+      <input id={id} type="checkbox" checked={checked} onChange={(event) => onChange(event.target.checked)} />
+      <span className="chart-settings-label-copy">
+        <span>{label}</span>
+        {hint ? <small>{hint}</small> : null}
+      </span>
+    </label>
+  );
+}
+
+export function SettingsSelectRow({
+  label,
+  value,
+  options,
+  onChange,
+}: {
+  label: string;
+  value: string;
+  options: Array<{ value: string; label: string }>;
+  onChange: (value: string) => void;
+}) {
+  const id = useId();
+  return (
+    <label className="chart-settings-field-row" htmlFor={id}>
+      <span>{label}</span>
+      <select id={id} value={value} onChange={(event) => onChange(event.target.value)}>
+        {options.map((option) => <option key={option.value} value={option.value}>{option.label}</option>)}
+      </select>
+    </label>
+  );
+}
+
+export function SettingsColorRow({
+  label,
+  value,
+  fallback,
+  onChange,
+}: {
+  label: string;
+  value: string;
+  fallback: string;
+  onChange: (value: string) => void;
+}) {
+  const id = useId();
+  return (
+    <div className="chart-settings-color-row">
+      <label htmlFor={id}>{label}</label>
+      <span className="chart-settings-color-control">
+        <TradingViewColorPicker label={label} value={value || fallback} onChange={onChange} className="chart-settings-color-picker" />
+        {value ? <button type="button" aria-label={`Use default ${label.toLowerCase()}`} onClick={() => onChange("")}>Reset</button> : null}
+      </span>
+    </div>
+  );
+}
+
+export function SettingsColorPair({
+  label,
+  bullish,
+  bearish,
+  bullishFallback,
+  bearishFallback,
+  onBullishChange,
+  onBearishChange,
+}: {
+  label: string;
+  bullish: string;
+  bearish: string;
+  bullishFallback: string;
+  bearishFallback: string;
+  onBullishChange: (value: string) => void;
+  onBearishChange: (value: string) => void;
+}) {
+  return (
+    <div className="chart-settings-color-pair-row">
+      <span>{label}</span>
+      <div className="chart-settings-color-pair">
+        <TradingViewColorPicker label={"Bullish " + label.toLowerCase() + " color"} value={bullish || bullishFallback} onChange={onBullishChange} className="chart-settings-color-picker" />
+        <TradingViewColorPicker label={"Bearish " + label.toLowerCase() + " color"} value={bearish || bearishFallback} onChange={onBearishChange} className="chart-settings-color-picker" />
+      </div>
+    </div>
+  );
+}
+
+export function SettingsNumberRow({
+  label,
+  value,
+  min,
+  max,
+  step = 1,
+  unit,
+  onChange,
+}: {
+  label: string;
+  value: number;
+  min: number;
+  max: number;
+  step?: number;
+  unit?: string;
+  onChange: (value: number) => void;
+}) {
+  const id = useId();
+  const [inputValue, setInputValue] = useState(String(value));
+  useEffect(() => setInputValue(String(value)), [value]);
+  return (
+    <label className="chart-settings-field-row" htmlFor={id}>
+      <span>{label}</span>
+      <span className="chart-settings-number-control">
+        <input id={id} type="number" value={inputValue} min={min} max={max} step={step} onChange={(event) => {
+          const raw = event.target.value;
+          setInputValue(raw);
+          if (raw === "") return;
+          const next = Number(raw);
+          if (Number.isFinite(next)) onChange(next);
+        }} />
+        {unit ? <small>{unit}</small> : null}
+      </span>
+    </label>
+  );
+}
