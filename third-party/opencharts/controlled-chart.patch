index 0000000..fe07a7f
--- /dev/null
+++ b/src/pages/trading/drawing-settings/DrawingSettingsDialog.tsx
@@ -0,0 +1,175 @@
+import { Pencil, X } from "lucide-react";
+import { useEffect, useRef, useState, type KeyboardEvent, type PointerEvent } from "react";
+import { createPortal } from "react-dom";
+import type { DrawingLine } from "../constants.ts";
+import { settingsTabsFor, type DrawingSettingsTab } from "../drawingSettingsModel.ts";
+import { useDrawingSettingsDraft } from "./useDrawingSettingsDraft.ts";
+import { CoordinatesTab } from "./CoordinatesTab.tsx";
+import { PositionInputsTab } from "./PositionInputsTab.tsx";
+import { drawingPortalRoot } from "./portalRoot.ts";
+import { StyleTab } from "./StyleTab.tsx";
+import { TabList } from "./SettingsControls.tsx";
+import { TextTab } from "./TextTab.tsx";
+import { VisibilityTab } from "./VisibilityTab.tsx";
+import { getTemplates, setTypeDefault } from "../drawingStyles.ts";
+import "./settings.css";
+
+export interface DrawingSettingsDialogProps {
+  drawing: DrawingLine;
+  currentTf: string;
+  onPreview: (drawing: DrawingLine) => void;
+  onCommit: (drawing: DrawingLine) => void;
+  onClose: () => void;
+}
+
+function toolName(drawing: DrawingLine): string {
+  if (drawing.type === "position") {
+    return drawing.side === "short" ? "Short Position" : "Long Position";
+  }
+  return drawing.type
+    .split("-")
+    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
+    .join(" ");
+}
+
+function tabName(tab: DrawingSettingsTab): string {
+  return tab.charAt(0).toUpperCase() + tab.slice(1);
+}
+
+function focusable(dialog: HTMLDialogElement): HTMLElement[] {
+  return Array.from(
+    dialog.querySelectorAll<HTMLElement>(
+      'button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex="0"]',
+    ),
+  ).filter((element) => element.getAttribute("aria-hidden") !== "true");
+}
+
+export function DrawingSettingsDialog({
+  drawing,
+  currentTf: _currentTf,
+  onPreview,
+  onCommit,
+  onClose,
+}: DrawingSettingsDialogProps) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const firstTabRef = useRef<HTMLButtonElement>(null);
+  const frameRef = useRef<HTMLElement>(null);
+  const dragRef = useRef<{ pointerId: number; startX: number; startY: number; originX: number; originY: number } | null>(null);
+  const tabs = settingsTabsFor(drawing.type);
+  const [activeTab, setActiveTab] = useState<DrawingSettingsTab>(tabs[0]!);
+  const [renaming, setRenaming] = useState(false);
+  const [offset, setOffset] = useState({ x: 0, y: 0 });
+  const { draft, errors, canCommit, update, cancel, commit } = useDrawingSettingsDraft(
+    drawing,
+    onPreview,
+    onCommit,
+    onClose,
+  );
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (!dialog.open) dialog.showModal();
+    firstTabRef.current?.focus();
+    return () => {
+      if (dialog.open) dialog.close();
+    };
+  }, []);
+
+  const onKeyDown = (event: KeyboardEvent<HTMLDialogElement>) => {
+    if (event.key !== "Tab") return;
+    const items = focusable(event.currentTarget);
+    if (items.length === 0) return;
+    const first = items[0]!;
+    const last = items[items.length - 1]!;
+    if (!event.shiftKey && document.activeElement === last) {
+      event.preventDefault();
+      first.focus();
+    } else if (event.shiftKey && document.activeElement === first) {
+      event.preventDefault();
+      last.focus();
+    }
+  };
+
+  const startDrag = (event: PointerEvent<HTMLElement>) => {
+    if ((event.target as HTMLElement).closest("button,input")) return;
+    dragRef.current = { pointerId: event.pointerId, startX: event.clientX, startY: event.clientY, originX: offset.x, originY: offset.y };
+    event.currentTarget.setPointerCapture?.(event.pointerId);
+  };
+  const moveDrag = (event: PointerEvent<HTMLElement>) => {
+    const drag = dragRef.current;
+    const frame = frameRef.current;
+    if (!drag || drag.pointerId !== event.pointerId || !frame) return;
+    const maxX = Math.max(0, (window.innerWidth - frame.offsetWidth) / 2 - 8);
+    const maxY = Math.max(0, (window.innerHeight - frame.offsetHeight) / 2 - 8);
+    setOffset({
+      x: Math.max(-maxX, Math.min(maxX, drag.originX + event.clientX - drag.startX)),
+      y: Math.max(-maxY, Math.min(maxY, drag.originY + event.clientY - drag.startY)),
+    });
+  };
+  const stopDrag = (event: PointerEvent<HTMLElement>) => {
+    if (dragRef.current?.pointerId === event.pointerId) dragRef.current = null;
+  };
+
+  const name = toolName(drawing);
+  return createPortal(
+    <dialog
+      ref={dialogRef}
+      className="opencharts drawing-settings-dialog"
+      aria-label={`${name} settings`}
+      data-drawing-type={drawing.type}
+      onCancel={(event) => {
+        event.preventDefault();
+        cancel();
+      }}
+      onKeyDown={onKeyDown}
+    >
+      <section ref={frameRef} className="drawing-settings-frame" aria-labelledby="drawing-settings-title" style={{ transform: `translate(calc(-50% + ${offset.x}px), calc(-50% + ${offset.y}px))` }}>
+        <header className="drawing-settings-header" onPointerDown={startDrag} onPointerMove={moveDrag} onPointerUp={stopDrag} onPointerCancel={stopDrag}>
+          <div className="flex items-center gap-2">
+            {renaming ? <input className="drawing-settings-title-input" aria-label="Drawing name" value={draft.name ?? name} autoFocus onChange={(event) => update({ name: event.target.value })} onBlur={() => setRenaming(false)} onKeyDown={(event) => { if (event.key === "Enter") setRenaming(false); }}/>:<h2 id="drawing-settings-title" className="drawing-settings-title">{draft.name || name}</h2>}
+            <button type="button" className="drawing-settings-icon-button" aria-label={`Rename ${name}`} onClick={() => setRenaming(true)}>
+              <Pencil aria-hidden="true" size={17} strokeWidth={1.5} />
+            </button>
+          </div>
+          <button
+            type="button"
+            className="drawing-settings-icon-button"
+            aria-label={`Close ${name} settings`}
+            onClick={cancel}
+          >
+            <X aria-hidden="true" size={22} strokeWidth={1.5} />
+          </button>
+        </header>
+
+        <TabList tabs={tabs} active={activeTab} onChange={setActiveTab} initialFocusRef={firstTabRef}/>
+
+        <div className="drawing-settings-body" role="tabpanel" aria-label={tabName(activeTab)} data-drawing-tab={activeTab}>
+          {activeTab === "inputs" && <PositionInputsTab draft={draft} errors={errors} update={update}/>}
+          {activeTab === "style" && <StyleTab draft={draft} errors={errors} update={update}/>}
+          {activeTab === "text" && <TextTab draft={draft} update={update}/>}
+          {activeTab === "coordinates" && <CoordinatesTab draft={draft} errors={errors} update={update}/>}
+          {activeTab === "visibility" && <VisibilityTab draft={draft} currentTf={_currentTf} update={update}/>}
+        </div>
+
+        <footer className="drawing-settings-footer">
+          <select className="drawing-settings-select max-w-36" aria-label="Template" defaultValue="" onChange={(event) => { if (event.target.value === "__default") setTypeDefault(draft.type, draft); else { const template = getTemplates().find((item) => item.name === event.target.value); if (template) update(template.style); } event.currentTarget.value = ""; }}>
+            <option value="">Template</option>{getTemplates().map((template) => <option key={template.name} value={template.name}>{template.name}</option>)}<option value="__default">Set as default</option>
+          </select>
+          <div className="drawing-settings-footer-actions">
+            <button type="button" className="drawing-settings-button" onClick={cancel}>Cancel</button>
+            <button
+              type="button"
+              className="drawing-settings-button drawing-settings-button--primary"
+              disabled={!canCommit}
+              onClick={commit}
+            >
+              OK
+            </button>
+          </div>
+        </footer>
+      </section>
+    </dialog>,
+    drawingPortalRoot(),
+  );
+}
diff --git a/src/pages/trading/drawing-settings/PositionInputsTab.tsx b/src/pages/trading/drawing-settings/PositionInputsTab.tsx
new file mode 100644
index 0000000..19ee497
--- /dev/null
+++ b/src/pages/trading/drawing-settings/PositionInputsTab.tsx
