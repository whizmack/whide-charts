index 0000000..7f2a7a8
--- /dev/null
+++ b/src/pages/trading/drawing-settings/toolbarModel.ts
@@ -0,0 +1,52 @@
+import type { DrawingLine, DrawingType } from "../constants.ts";
+
+export type DrawingToolbarControl =
+  | "line" | "border" | "fill" | "text" | "extend" | "smooth" | "close"
+  | "stop-color" | "target-color" | "stats" | "positive-color" | "negative-color"
+  | "text-color" | "font-size" | "bold" | "italic"
+  | "visibility" | "order"
+  | "clone" | "settings" | "lock" | "delete" | "more";
+
+const TEXT = new Set<DrawingType>(["text", "anchored-text", "note"]);
+const FREEHAND = new Set<DrawingType>(["brush", "highlighter", "path", "curve"]);
+const RANGE = new Set<DrawingType>(["price-range", "date-range", "date-price-range"]);
+const SHAPE = new Set<DrawingType>(["rectangle", "ellipse", "triangle", "channel"]);
+
+export function toolbarControlsFor(drawing: DrawingLine): DrawingToolbarControl[] {
+  let contextual: DrawingToolbarControl[];
+  if (drawing.type === "position") contextual = ["line", "text", "stop-color", "target-color", "stats"];
+  else if (TEXT.has(drawing.type)) contextual = ["text-color", "font-size", "bold", "italic"];
+  else if (RANGE.has(drawing.type)) contextual = ["text", "positive-color", "negative-color"];
+  else if (FREEHAND.has(drawing.type)) contextual = ["line", "smooth", "close"];
+  else if (SHAPE.has(drawing.type)) contextual = ["border", "fill", "text", "visibility", "order"];
+  else contextual = ["line", "text", "extend"];
+  return [...contextual, "clone", "settings", "lock", "delete", "more"];
+}
+
+export interface ToolbarPoint { x: number; y: number }
+export interface ToolbarBounds { left: number; top: number; width: number; height: number }
+export interface ToolbarSize { width: number; height: number }
+export interface ToolbarPlacement extends ToolbarPoint { side: "above" | "below"; maxWidth: number }
+
+export function clampDrawingToolbar(
+  anchor: ToolbarPoint,
+  bounds: ToolbarBounds,
+  size: ToolbarSize,
+): ToolbarPlacement {
+  const inset = 8;
+  const gap = 12;
+  const maxWidth = Math.max(0, bounds.width - inset * 2);
+  const renderedWidth = Math.min(size.width, maxWidth);
+  const minX = bounds.left + inset;
+  const maxX = bounds.left + bounds.width - inset - renderedWidth;
+  const preferredY = anchor.y - size.height - gap;
+  const side = preferredY >= bounds.top + inset ? "above" : "below";
+  const rawY = side === "above" ? preferredY : anchor.y + gap;
+  const maxY = bounds.top + bounds.height - inset - size.height;
+  return {
+    x: Math.round(Math.min(Math.max(anchor.x - renderedWidth / 2, minX), Math.max(minX, maxX))),
+    y: Math.round(Math.min(Math.max(rawY, bounds.top + inset), Math.max(bounds.top + inset, maxY))),
+    side,
+    maxWidth,
+  };
+}
diff --git a/src/pages/trading/drawing-settings/useDrawingSettingsDraft.ts b/src/pages/trading/drawing-settings/useDrawingSettingsDraft.ts
new file mode 100644
index 0000000..925559c
--- /dev/null
+++ b/src/pages/trading/drawing-settings/useDrawingSettingsDraft.ts
@@ -0,0 +1,80 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import type { DrawingLine } from "../constants.ts";
+import {
+  type DrawingSettingsDraft,
+  normalizeDrawingSettings,
+  validateDrawingSettings,
+} from "../drawingSettingsModel.ts";
+
+export interface DrawingSettingsDraftController {
+  draft: DrawingSettingsDraft;
+  errors: ReturnType<typeof validateDrawingSettings>;
+  canCommit: boolean;
+  update: (patch: Partial<DrawingSettingsDraft>) => void;
+  cancel: () => void;
+  commit: () => void;
+}
+
+export function useDrawingSettingsDraft(
+  drawing: DrawingLine,
+  onPreview: (drawing: DrawingLine) => void,
+  onCommit: (drawing: DrawingLine) => void,
+  onClose: () => void,
+): DrawingSettingsDraftController {
+  const originalRef = useRef<DrawingLine>({ ...drawing });
+  const openerRef = useRef<HTMLElement | null>(
+    typeof document === "undefined" ? null : document.activeElement as HTMLElement | null,
+  );
+  const finalizedRef = useRef(false);
+  const onPreviewRef = useRef(onPreview);
+  const onCommitRef = useRef(onCommit);
+  const onCloseRef = useRef(onClose);
+  const [draft, setDraft] = useState<DrawingSettingsDraft>(() => normalizeDrawingSettings(drawing));
+
+  useEffect(() => {
+    onPreviewRef.current = onPreview;
+    onCommitRef.current = onCommit;
+    onCloseRef.current = onClose;
+  });
+
+  const restoreFocus = useCallback(() => {
+    if (openerRef.current?.isConnected) openerRef.current.focus();
+  }, []);
+
+  const cancel = useCallback(() => {
+    if (finalizedRef.current) return;
+    finalizedRef.current = true;
+    onPreviewRef.current(originalRef.current);
+    onCloseRef.current();
+    restoreFocus();
+  }, [restoreFocus]);
+
+  useEffect(
+    () => () => {
+      if (!finalizedRef.current) onPreviewRef.current(originalRef.current);
+      restoreFocus();
+    },
+    [restoreFocus],
+  );
+
+  const update = useCallback((patch: Partial<DrawingSettingsDraft>) => {
+    setDraft((current) => {
+      const next = { ...current, ...patch };
+      onPreviewRef.current(next);
+      return next;
+    });
+  }, []);
+
+  const errors = useMemo(() => validateDrawingSettings(draft), [draft]);
+  const canCommit = Object.keys(errors).length === 0;
+
+  const commit = useCallback(() => {
+    if (finalizedRef.current || Object.keys(validateDrawingSettings(draft)).length > 0) return;
+    finalizedRef.current = true;
+    onCommitRef.current(draft);
+    onCloseRef.current();
+    restoreFocus();
+  }, [draft, restoreFocus]);
+
+  return { draft, errors, canCommit, update, cancel, commit };
+}
diff --git a/src/pages/trading/drawingSettingsModel.ts b/src/pages/trading/drawingSettingsModel.ts
new file mode 100644
index 0000000..27fba52
--- /dev/null
+++ b/src/pages/trading/drawingSettingsModel.ts
@@ -0,0 +1,245 @@
+import type {
+  DrawingLine,
+  DrawingQuantityPrecision,
+  DrawingRiskUnit,
+  DrawingStatsMode,
+  DrawingTextAlign,
+  DrawingTextPlacement,
+  DrawingType,
+  DrawingVisibilityUnit,
+  DrawingVisibilityRules,
+} from "./constants.ts";
+
+export type DrawingSettingsTab = "inputs" | "style" | "text" | "coordinates" | "visibility";
+
+export type DrawingSettingsDraft = DrawingLine & {
+  opacity: number;
+  fillColor: string;
+  fillOpacity: number;
+  textAlign: DrawingTextAlign;
+  textPlacement: DrawingTextPlacement;
+  visibility: "all" | "tf";
+  visibilityRules: DrawingVisibilityRules;
+  positiveColor: string;
+  negativeColor: string;
+  labelColor: string;
+  rangeLabelMode: "compact" | "full";
+  accountSize: number;
+  lotSize: number;
+  leverage: number;
+  riskValue: number;
+  riskUnit: DrawingRiskUnit;
+  quantityPrecision: DrawingQuantityPrecision;
+  tickSize: number;
+  stopColor: string;
+  targetColor: string;
+  stopFillOpacity: number;
+  targetFillOpacity: number;
+  showPriceLabels: boolean;
+  statsMode: DrawingStatsMode;
+  compactStats: boolean;
+  alwaysShowStats: boolean;
+};
+
+export type DrawingSettingsErrors = Partial<Record<keyof DrawingSettingsDraft, string>>;
+
+export interface PositionMetrics {
+  riskAmount: number;
+  quantity: number;
+  notional: number;
+  margin: number;
+  targetAmount: number;
+  targetDistance: number;
+  targetPercent: number;
+  targetTicks: number;
+  stopAmount: number;
+  stopDistance: number;
+  stopPercent: number;
+  stopTicks: number;
+  riskReward: number;
+}
+
+const TEXT_TABS: readonly DrawingSettingsTab[] = ["text", "style", "coordinates", "visibility"];
+const STANDARD_TABS: readonly DrawingSettingsTab[] = ["style", "text", "coordinates", "visibility"];
+const COMPACT_TABS: readonly DrawingSettingsTab[] = ["style", "coordinates", "visibility"];
+const POSITION_TABS: readonly DrawingSettingsTab[] = ["inputs", "style", "visibility"];
+
+const TEXT_TYPES = new Set<DrawingType>(["text", "anchored-text", "note"]);
+const COMPACT_TYPES = new Set<DrawingType>([
+  "fibonacci",
+  "fibextension",
+  "price-range",
+  "date-range",
+  "date-price-range",
+  "position",
+]);
+
+function finite(value: number | undefined, fallback: number): number {
+  return typeof value === "number" && Number.isFinite(value) ? value : fallback;
+}
+
+function positive(value: number | undefined, fallback: number): number {
+  return typeof value === "number" && Number.isFinite(value) && value > 0 ? value : fallback;
+}
+
+function unitInterval(value: number | undefined, fallback: number): number {
+  const next = finite(value, fallback);
+  return Math.min(1, Math.max(0, next));
+}
+
+export function settingsTabsFor(type: DrawingType): DrawingSettingsTab[] {
+  if (type === "position") return [...POSITION_TABS];
+  if (TEXT_TYPES.has(type)) return [...TEXT_TABS];
+  if (COMPACT_TYPES.has(type)) return [...COMPACT_TABS];
+  return [...STANDARD_TABS];
+}
+
+function visibilityUnitFor(timeframe: string): DrawingVisibilityUnit {
+  if (/t$/i.test(timeframe)) return "ticks";
+  if (/r$/i.test(timeframe)) return "ranges";
+  if (/s$/i.test(timeframe)) return "seconds";
+  if (/m$/.test(timeframe)) return "minutes";
+  if (/h$/i.test(timeframe)) return "hours";
+  if (/d$/i.test(timeframe)) return "days";
+  if (/w$/i.test(timeframe)) return "weeks";
+  if (/M$/.test(timeframe)) return "months";
+  return "minutes";
+}
+
+export function isDrawingVisibleOnTimeframe(drawing: DrawingLine, timeframe: string): boolean {
+  if (drawing.visibility === "tf" && drawing.createdTf !== timeframe) return false;
+  const rules = drawing.visibilityRules;
+  return rules ? rules[visibilityUnitFor(timeframe)] !== false : true;
+}
+
+export function normalizeDrawingSettings(drawing: DrawingLine): DrawingSettingsDraft {
+  const riskValue = positive(drawing.riskValue, positive(drawing.riskPct, 1));
+  return {
+    ...drawing,
+    opacity: unitInterval(drawing.opacity, 1),
+    fillColor: drawing.fillColor ?? drawing.color,
+    fillOpacity: unitInterval(drawing.fillOpacity, 0.14),
+    textAlign: drawing.textAlign ?? "center",
+    textPlacement: drawing.textPlacement ?? "inside",
+    visibility: drawing.visibility === "tf" ? "tf" : "all",
+    visibilityRules: drawing.visibilityRules ?? {
+      ticks: true,
+      seconds: true,
+      minutes: true,
+      hours: true,
+      days: true,
+      weeks: true,
+      months: true,
+      ranges: true,
+    },
+    positiveColor: drawing.positiveColor ?? "#089981",
+    negativeColor: drawing.negativeColor ?? "#f23645",
+    labelColor: drawing.labelColor ?? "#ffffff",
+    rangeLabelMode: drawing.rangeLabelMode ?? "full",
+    accountSize: positive(drawing.accountSize, 1_000),
+    lotSize: positive(drawing.lotSize, 1),
+    leverage: positive(drawing.leverage, 1),
+    riskValue,
+    riskUnit: drawing.riskUnit === "currency" ? "currency" : "percent",
+    quantityPrecision: drawing.quantityPrecision ?? "default",
+    tickSize: positive(drawing.tickSize, 0.1),
+    stopColor: drawing.stopColor ?? "#f23645",
+    targetColor: drawing.targetColor ?? "#089981",
+    stopFillOpacity: unitInterval(drawing.stopFillOpacity, 0.2),
+    targetFillOpacity: unitInterval(drawing.targetFillOpacity, 0.2),
+    showPriceLabels: drawing.showPriceLabels ?? true,
+    statsMode: drawing.statsMode ?? "price-offsets",
+    compactStats: drawing.compactStats ?? false,
+    alwaysShowStats: drawing.alwaysShowStats ?? false,
+  };
+}
+
+function validatePositive(
+  errors: DrawingSettingsErrors,
+  field: "accountSize" | "lotSize" | "leverage" | "riskValue",
+  value: number,
+  message: string,
+): void {
+  if (!Number.isFinite(value) || value <= 0) errors[field] = message;
+}
+
+export function validateDrawingSettings(draft: DrawingSettingsDraft): DrawingSettingsErrors {
+  const errors: DrawingSettingsErrors = {};
+  if (!Number.isFinite(draft.price)) errors.price = "Price must be a finite value";
+  for (const field of ["time", "price2", "time2", "price3", "time3", "controlPrice", "controlTime"] as const) {
+    const value = draft[field];
+    if (value !== undefined && !Number.isFinite(value)) {
+      errors[field] = `${field.toLowerCase().includes("time") ? "Bar" : "Price"} must be a finite value`;
+    }
+  }
+  if (draft.points?.some((point) => !Number.isFinite(point.time) || !Number.isFinite(point.price))) {
+    errors.points = "First and last points must use finite price and bar values";
+  }
+  if (draft.fibLevelStyles?.some((level) => !Number.isFinite(level.value))) {
+    errors.fibLevelStyles = "Fibonacci level values must be finite";
+  }
+  if (draft.type !== "position") return errors;
+
+  validatePositive(errors, "accountSize", draft.accountSize, "Account size must be greater than 0");
+  validatePositive(errors, "lotSize", draft.lotSize, "Lot size must be greater than 0");
+  validatePositive(
+    errors,
+    "leverage",
+    draft.leverage,
+    "Leverage must be a finite value greater than 0",
+  );
+  validatePositive(errors, "riskValue", draft.riskValue, "Risk must be greater than 0");
+
+  const stop = draft.stopPrice;
+  const target = draft.targetPrice;
+  if (typeof stop !== "number" || !Number.isFinite(stop)) errors.stopPrice = "Stop price is required";
+  if (typeof target !== "number" || !Number.isFinite(target)) {
+    errors.targetPrice = "Target price is required";
+  }
+  if (!Number.isFinite(draft.price) || draft.price <= 0) errors.price = "Entry price must be greater than 0";
+
+  if (Number.isFinite(draft.price) && typeof stop === "number" && Number.isFinite(stop)) {
+    if (draft.side === "short" && stop <= draft.price) {
+      errors.stopPrice = "Stop must be above entry for a short position";
+    } else if (draft.side !== "short" && stop >= draft.price) {
+      errors.stopPrice = "Stop must be below entry for a long position";
+    }
+  }
+  if (Number.isFinite(draft.price) && typeof target === "number" && Number.isFinite(target)) {
+    if (draft.side === "short" && target >= draft.price) {
+      errors.targetPrice = "Target must be below entry for a short position";
+    } else if (draft.side !== "short" && target <= draft.price) {
+      errors.targetPrice = "Target must be above entry for a long position";
+    }
+  }
+  return errors;
+}
+
+export function positionMetrics(draft: DrawingSettingsDraft): PositionMetrics | null {
+  if (draft.type !== "position" || Object.keys(validateDrawingSettings(draft)).length > 0) return null;
+  const stop = draft.stopPrice as number;
+  const target = draft.targetPrice as number;
+  const short = draft.side === "short";
+  const stopDistance = short ? stop - draft.price : draft.price - stop;
+  const targetDistance = short ? draft.price - target : target - draft.price;
+  const riskAmount = draft.riskUnit === "currency"
+    ? draft.riskValue
+    : draft.accountSize * draft.riskValue / 100;
+  const quantity = riskAmount / (stopDistance * draft.lotSize);
+  const notional = quantity * draft.lotSize * draft.price;
+  return {
+    riskAmount,
+    quantity,
+    notional,
+    margin: notional / draft.leverage,
+    targetAmount: quantity * draft.lotSize * targetDistance,
+    targetDistance,
+    targetPercent: targetDistance / draft.price * 100,
+    targetTicks: targetDistance / draft.tickSize,
+    stopAmount: riskAmount,
+    stopDistance,
+    stopPercent: stopDistance / draft.price * 100,
+    stopTicks: stopDistance / draft.tickSize,
+    riskReward: targetDistance / stopDistance,
+  };
+}
