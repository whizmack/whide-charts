+  if (draft.points && draft.points.length > 0) {
+    const lastIndex = draft.points.length - 1;
+    const first = draft.points[0]!;
+    const last = draft.points[lastIndex]!;
+    const updatePoint = (index: number, patch: { time?: number; price?: number }) => update({ points: draft.points!.map((point, pointIndex) => pointIndex === index ? { ...point, ...patch } : point) });
+    return <div className="drawing-settings-stack"><SectionLabel>{draft.points.length} points</SectionLabel><Anchor index="First point" price={first.price} time={first.time} priceError={errors.points} timeError={errors.points} onPrice={(price) => updatePoint(0,{price})} onTime={(time) => updatePoint(0,{time})}/>{lastIndex > 0 && <Anchor index="Last point" price={last.price} time={last.time} priceError={errors.points} timeError={errors.points} onPrice={(price) => updatePoint(lastIndex,{price})} onTime={(time) => updatePoint(lastIndex,{time})}/>}</div>;
+  }
+  return <div className="drawing-settings-stack">
+    <Anchor index="#1" price={draft.price} time={draft.time} priceError={errors.price} timeError={errors.time} onPrice={(price) => update({ price })} onTime={(time) => update({ time })}/>
+    {(draft.price2 != null || draft.time2 != null) && <Anchor index="#2" price={draft.price2} time={draft.time2} priceError={errors.price2} timeError={errors.time2} onPrice={(price2) => update({ price2 })} onTime={(time2) => update({ time2 })}/>}
+    {(draft.price3 != null || draft.time3 != null) && <Anchor index="#3" price={draft.price3} time={draft.time3} priceError={errors.price3} timeError={errors.time3} onPrice={(price3) => update({ price3 })} onTime={(time3) => update({ time3 })}/>}
+    {draft.type === "curve" && <Anchor index="Control" price={draft.controlPrice} time={draft.controlTime} priceError={errors.controlPrice} timeError={errors.controlTime} onPrice={(controlPrice) => update({ controlPrice })} onTime={(controlTime) => update({ controlTime })}/>}
+  </div>;
+}
diff --git a/src/pages/trading/drawing-settings/DrawingFloatingToolbar.tsx b/src/pages/trading/drawing-settings/DrawingFloatingToolbar.tsx
new file mode 100644
index 0000000..ac9fec0
--- /dev/null
+++ b/src/pages/trading/drawing-settings/DrawingFloatingToolbar.tsx
@@ -0,0 +1,134 @@
+import {
+  Bold,
+  Copy,
+  BringToFront,
+  Ellipsis,
+  Eye,
+  EyeOff,
+  GripVertical,
+  Italic,
+  Lock,
+  LockOpen,
+  Settings2,
+  Trash2,
+  Type,
+} from "lucide-react";
+import { useEffect, useLayoutEffect, useMemo, useRef, useState } from "react";
+import { createPortal } from "react-dom";
+import type { DrawingLine, DrawingLineStyle } from "../constants.ts";
+import {
+  clampDrawingToolbar,
+  toolbarControlsFor,
+  type ToolbarBounds,
+  type ToolbarPoint,
+} from "./toolbarModel.ts";
+import { drawingPortalRoot } from "./portalRoot.ts";
+import "./settings.css";
+
+export interface DrawingToolbarProps {
+  drawing: DrawingLine;
+  anchor: ToolbarPoint;
+  bounds: ToolbarBounds;
+  onUpdate: (drawing: DrawingLine) => void;
+  onClone: () => void;
+  onRemove: () => void;
+  onOpenSettings: () => void;
+}
+
+const NEXT_LINE: Record<DrawingLineStyle, DrawingLineStyle> = { solid: "dashed", dashed: "dotted", dotted: "solid" };
+
+function ToolButton({ label, active, danger, onClick, children }: { label: string; active?: boolean; danger?: boolean; onClick: () => void; children: React.ReactNode }) {
+  return <button type="button" aria-label={label} title={label} aria-pressed={active} className={`drawing-floating-button${active ? " is-active" : ""}${danger ? " is-danger" : ""}`} onClick={onClick}>{children}</button>;
+}
+
+function ColorTool({ label, value, onChange }: { label: string; value: string; onChange: (value: string) => void }) {
+  return <label className="drawing-floating-color" title={label} aria-label={label} style={{ "--toolbar-color": value } as React.CSSProperties}><input aria-label={label} type="color" value={value} onChange={(event) => onChange(event.target.value)} /></label>;
+}
+
+export function DrawingFloatingToolbar({ drawing, anchor, bounds, onUpdate, onClone, onRemove, onOpenSettings }: DrawingToolbarProps) {
+  const controls = useMemo(() => new Set(toolbarControlsFor(drawing)), [drawing]);
+  const ref = useRef<HTMLDivElement>(null);
+  const dragRef = useRef<{ pointerId: number; x: number; y: number; dx: number; dy: number } | null>(null);
+  const dragCleanupRef = useRef<(() => void) | null>(null);
+  const [size, setSize] = useState({ width: 520, height: 48 });
+  const [offset, setOffset] = useState({ x: 0, y: 0 });
+  const patch = (next: Partial<DrawingLine>) => onUpdate({ ...drawing, ...next });
+
+  useLayoutEffect(() => {
+    const element = ref.current;
+    if (!element) return;
+    const measure = () => setSize({ width: element.scrollWidth, height: element.offsetHeight || 48 });
+    measure();
+    if (typeof ResizeObserver === "undefined") return;
+    const observer = new ResizeObserver(measure);
+    observer.observe(element);
+    return () => observer.disconnect();
+  }, [drawing.type]);
+
+  useEffect(() => () => dragCleanupRef.current?.(), []);
+
+  const placement = clampDrawingToolbar({ x: anchor.x + offset.x, y: anchor.y + offset.y }, bounds, size);
+
+  const beginDrag = (event: React.PointerEvent<HTMLButtonElement>) => {
+    event.preventDefault();
+    dragCleanupRef.current?.();
+    const pointerId = Number.isFinite(event.pointerId) ? event.pointerId : 0;
+    const startX = Number.isFinite(event.clientX) ? event.clientX : 0;
+    const startY = Number.isFinite(event.clientY) ? event.clientY : 0;
+    dragRef.current = { pointerId, x: startX, y: startY, dx: offset.x, dy: offset.y };
+    const move = (next: PointerEvent) => {
+      const drag = dragRef.current;
+      const nextPointerId = Number.isFinite(next.pointerId) ? next.pointerId : 0;
+      if (!drag || nextPointerId !== drag.pointerId) return;
+      const nextX = Number.isFinite(next.clientX) ? next.clientX : drag.x;
+      const nextY = Number.isFinite(next.clientY) ? next.clientY : drag.y;
+      setOffset({ x: drag.dx + nextX - drag.x, y: drag.dy + nextY - drag.y });
+    };
+    let finish: (next: PointerEvent) => void;
+    const cleanup = () => {
+      dragRef.current = null;
+      window.removeEventListener("pointermove", move);
+      window.removeEventListener("pointerup", finish);
+      window.removeEventListener("pointercancel", finish);
+      dragCleanupRef.current = null;
+    };
+    finish = (next: PointerEvent) => {
+      const nextPointerId = Number.isFinite(next.pointerId) ? next.pointerId : 0;
+      if (dragRef.current?.pointerId !== nextPointerId) return;
+      cleanup();
+    };
+    dragCleanupRef.current = cleanup;
+    window.addEventListener("pointermove", move);
+    window.addEventListener("pointerup", finish);
+    window.addEventListener("pointercancel", finish);
+  };
+
+  const toolbar = <div ref={ref} role="toolbar" aria-label="Selected drawing" className="drawing-floating-toolbar drawing-alignment-surface" style={{ left: placement.x, top: placement.y, maxWidth: placement.maxWidth }}>
+    <button type="button" aria-label="Move drawing toolbar" title="Move toolbar" className="drawing-floating-grip" onPointerDown={beginDrag}><GripVertical aria-hidden="true" /></button>
+    <div className="drawing-floating-scroll">
+      {(controls.has("line") || controls.has("border")) && <><ColorTool label={controls.has("border") ? "Border color" : "Line color"} value={drawing.color} onChange={(color) => patch({ color })} /><ToolButton label="Line style" onClick={() => patch({ lineStyle: NEXT_LINE[drawing.lineStyle ?? "solid"] })}><span className={`drawing-floating-line drawing-floating-line--${drawing.lineStyle ?? "solid"}`} /></ToolButton><button type="button" aria-label="Line width" className="drawing-floating-width" onClick={() => patch({ width: (drawing.width ?? 2) >= 4 ? 1 : (drawing.width ?? 2) + 1 })}><span />{drawing.width ?? 2}px</button></>}
+      {controls.has("fill") && <ColorTool label="Fill color" value={drawing.fillColor ?? drawing.color} onChange={(fillColor) => patch({ fillColor })} />}
+      {controls.has("positive-color") && <ColorTool label="Positive color" value={drawing.positiveColor ?? "#089981"} onChange={(positiveColor) => patch({ positiveColor })} />}
+      {controls.has("negative-color") && <ColorTool label="Negative color" value={drawing.negativeColor ?? "#f23645"} onChange={(negativeColor) => patch({ negativeColor })} />}
+      {controls.has("stop-color") && <ColorTool label="Stop color" value={drawing.stopColor ?? "#f23645"} onChange={(stopColor) => patch({ stopColor })} />}
+      {controls.has("target-color") && <ColorTool label="Target color" value={drawing.targetColor ?? "#089981"} onChange={(targetColor) => patch({ targetColor })} />}
+      {(controls.has("text") || controls.has("text-color")) && <ToolButton label="Text style" onClick={onOpenSettings}><Type aria-hidden="true" /></ToolButton>}
+      {controls.has("font-size") && <button type="button" aria-label="Font size" className="drawing-floating-text-value" onClick={() => patch({ fontSize: (drawing.fontSize ?? 14) >= 24 ? 10 : (drawing.fontSize ?? 14) + 2 })}>{drawing.fontSize ?? 14}</button>}
+      {controls.has("bold") && <ToolButton label="Bold" active={drawing.bold} onClick={() => patch({ bold: !drawing.bold })}><Bold aria-hidden="true" /></ToolButton>}
+      {controls.has("italic") && <ToolButton label="Italic" active={drawing.italic} onClick={() => patch({ italic: !drawing.italic })}><Italic aria-hidden="true" /></ToolButton>}
+      {controls.has("extend") && <ToolButton label="Extend line" active={drawing.extendLeft || drawing.extendRight} onClick={() => patch({ extendLeft: !drawing.extendLeft, extendRight: !drawing.extendRight })}><span className="drawing-floating-extend">↔</span></ToolButton>}
+      {controls.has("smooth") && <ToolButton label="Smooth path" active={drawing.smooth} onClick={() => patch({ smooth: !drawing.smooth })}><span className="drawing-floating-glyph">⌁</span></ToolButton>}
+      {controls.has("close") && <ToolButton label="Close path" active={drawing.closed} onClick={() => patch({ closed: !drawing.closed })}><span className="drawing-floating-glyph">◇</span></ToolButton>}
+      {controls.has("stats") && <ToolButton label="Position stats" active={drawing.alwaysShowStats} onClick={() => patch({ alwaysShowStats: !drawing.alwaysShowStats })}><span className="drawing-floating-glyph">%</span></ToolButton>}
+      {controls.has("visibility") && <ToolButton label={drawing.hidden ? "Show drawing" : "Hide drawing"} active={!drawing.hidden} onClick={() => patch({ hidden: !drawing.hidden })}>{drawing.hidden ? <EyeOff aria-hidden="true" /> : <Eye aria-hidden="true" />}</ToolButton>}
+      {controls.has("order") && <ToolButton label="Bring drawing forward" onClick={() => patch({ zIndex: (drawing.zIndex ?? 0) + 1 })}><BringToFront aria-hidden="true" /></ToolButton>}
+      <span className="drawing-floating-separator" />
+      <ToolButton label="Clone drawing" onClick={onClone}><Copy aria-hidden="true" /></ToolButton>
+      <ToolButton label="Open drawing settings" onClick={onOpenSettings}><Settings2 aria-hidden="true" /></ToolButton>
+      <ToolButton label={drawing.locked ? "Unlock drawing" : "Lock drawing"} active={drawing.locked} onClick={() => patch({ locked: !drawing.locked })}>{drawing.locked ? <Lock aria-hidden="true" /> : <LockOpen aria-hidden="true" />}</ToolButton>
+      <ToolButton label="Delete drawing" danger onClick={onRemove}><Trash2 aria-hidden="true" /></ToolButton>
+      <ToolButton label="More drawing actions" onClick={onOpenSettings}><Ellipsis aria-hidden="true" /></ToolButton>
+    </div>
+  </div>;
+  return createPortal(toolbar, drawingPortalRoot());
+}
diff --git a/src/pages/trading/drawing-settings/DrawingSettingsDialog.tsx b/src/pages/trading/drawing-settings/DrawingSettingsDialog.tsx
new file mode 100644
index 0000000..fe07a7f
--- /dev/null
+++ b/src/pages/trading/drawing-settings/DrawingSettingsDialog.tsx
@@ -0,0 +1,175 @@
+import { Pencil, X } from "lucide-react";
+import { useEffect, useRef, useState, type KeyboardEvent, type PointerEvent } from "react";
+import { createPortal } from "react-dom";
+import type { DrawingLine } from "../constants.ts";
+import { settingsTabsFor, type DrawingSettingsTab } from "../drawingSettingsModel.ts";
+import { useDrawingSettingsDraft } from "./useDrawingSettingsDraft.ts";
+import { CoordinatesTab } from "./CoordinatesTab.tsx";
+import { PositionInputsTab } from "./PositionInputsTab.tsx";
+import { drawingPortalRoot } from "./portalRoot.ts";
+import { StyleTab } from "./StyleTab.tsx";
+import { TabList } from "./SettingsControls.tsx";
+import { TextTab } from "./TextTab.tsx";
+import { VisibilityTab } from "./VisibilityTab.tsx";
+import { getTemplates, setTypeDefault } from "../drawingStyles.ts";
+import "./settings.css";
+
+export interface DrawingSettingsDialogProps {
+  drawing: DrawingLine;
+  currentTf: string;
+  onPreview: (drawing: DrawingLine) => void;
+  onCommit: (drawing: DrawingLine) => void;
+  onClose: () => void;
+}
+
+function toolName(drawing: DrawingLine): string {
+  if (drawing.type === "position") {
+    return drawing.side === "short" ? "Short Position" : "Long Position";
+  }
+  return drawing.type
+    .split("-")
+    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
+    .join(" ");
+}
+
+function tabName(tab: DrawingSettingsTab): string {
+  return tab.charAt(0).toUpperCase() + tab.slice(1);
+}
+
+function focusable(dialog: HTMLDialogElement): HTMLElement[] {
+  return Array.from(
+    dialog.querySelectorAll<HTMLElement>(
+      'button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex="0"]',
+    ),
+  ).filter((element) => element.getAttribute("aria-hidden") !== "true");
+}
+
+export function DrawingSettingsDialog({
+  drawing,
+  currentTf: _currentTf,
+  onPreview,
+  onCommit,
+  onClose,
+}: DrawingSettingsDialogProps) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const firstTabRef = useRef<HTMLButtonElement>(null);
+  const frameRef = useRef<HTMLElement>(null);
+  const dragRef = useRef<{ pointerId: number; startX: number; startY: number; originX: number; originY: number } | null>(null);
+  const tabs = settingsTabsFor(drawing.type);
+  const [activeTab, setActiveTab] = useState<DrawingSettingsTab>(tabs[0]!);
+  const [renaming, setRenaming] = useState(false);
+  const [offset, setOffset] = useState({ x: 0, y: 0 });
+  const { draft, errors, canCommit, update, cancel, commit } = useDrawingSettingsDraft(
+    drawing,
+    onPreview,
+    onCommit,
+    onClose,
+  );
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (!dialog.open) dialog.showModal();
+    firstTabRef.current?.focus();
+    return () => {
+      if (dialog.open) dialog.close();
+    };
+  }, []);
+
+  const onKeyDown = (event: KeyboardEvent<HTMLDialogElement>) => {
+    if (event.key !== "Tab") return;
+    const items = focusable(event.currentTarget);
+    if (items.length === 0) return;
+    const first = items[0]!;
+    const last = items[items.length - 1]!;
+    if (!event.shiftKey && document.activeElement === last) {
+      event.preventDefault();
+      first.focus();
+    } else if (event.shiftKey && document.activeElement === first) {
+      event.preventDefault();
+      last.focus();
+    }
+  };
+
+  const startDrag = (event: PointerEvent<HTMLElement>) => {
+    if ((event.target as HTMLElement).closest("button,input")) return;
+    dragRef.current = { pointerId: event.pointerId, startX: event.clientX, startY: event.clientY, originX: offset.x, originY: offset.y };
+    event.currentTarget.setPointerCapture?.(event.pointerId);
+  };
+  const moveDrag = (event: PointerEvent<HTMLElement>) => {
+    const drag = dragRef.current;
+    const frame = frameRef.current;
+    if (!drag || drag.pointerId !== event.pointerId || !frame) return;
+    const maxX = Math.max(0, (window.innerWidth - frame.offsetWidth) / 2 - 8);
+    const maxY = Math.max(0, (window.innerHeight - frame.offsetHeight) / 2 - 8);
+    setOffset({
+      x: Math.max(-maxX, Math.min(maxX, drag.originX + event.clientX - drag.startX)),
+      y: Math.max(-maxY, Math.min(maxY, drag.originY + event.clientY - drag.startY)),
+    });
+  };
+  const stopDrag = (event: PointerEvent<HTMLElement>) => {
+    if (dragRef.current?.pointerId === event.pointerId) dragRef.current = null;
+  };
+
+  const name = toolName(drawing);
+  return createPortal(
+    <dialog
+      ref={dialogRef}
+      className="opencharts drawing-settings-dialog"
+      aria-label={`${name} settings`}
+      data-drawing-type={drawing.type}
+      onCancel={(event) => {
+        event.preventDefault();
+        cancel();
+      }}
+      onKeyDown={onKeyDown}
+    >
+      <section ref={frameRef} className="drawing-settings-frame" aria-labelledby="drawing-settings-title" style={{ transform: `translate(calc(-50% + ${offset.x}px), calc(-50% + ${offset.y}px))` }}>
+        <header className="drawing-settings-header" onPointerDown={startDrag} onPointerMove={moveDrag} onPointerUp={stopDrag} onPointerCancel={stopDrag}>
+          <div className="flex items-center gap-2">
+            {renaming ? <input className="drawing-settings-title-input" aria-label="Drawing name" value={draft.name ?? name} autoFocus onChange={(event) => update({ name: event.target.value })} onBlur={() => setRenaming(false)} onKeyDown={(event) => { if (event.key === "Enter") setRenaming(false); }}/>:<h2 id="drawing-settings-title" className="drawing-settings-title">{draft.name || name}</h2>}
+            <button type="button" className="drawing-settings-icon-button" aria-label={`Rename ${name}`} onClick={() => setRenaming(true)}>
+              <Pencil aria-hidden="true" size={17} strokeWidth={1.5} />
+            </button>
+          </div>
+          <button
+            type="button"
+            className="drawing-settings-icon-button"
+            aria-label={`Close ${name} settings`}
+            onClick={cancel}
+          >
+            <X aria-hidden="true" size={22} strokeWidth={1.5} />
+          </button>
+        </header>
+
+        <TabList tabs={tabs} active={activeTab} onChange={setActiveTab} initialFocusRef={firstTabRef}/>
+
+        <div className="drawing-settings-body" role="tabpanel" aria-label={tabName(activeTab)} data-drawing-tab={activeTab}>
+          {activeTab === "inputs" && <PositionInputsTab draft={draft} errors={errors} update={update}/>}
+          {activeTab === "style" && <StyleTab draft={draft} errors={errors} update={update}/>}
+          {activeTab === "text" && <TextTab draft={draft} update={update}/>}
+          {activeTab === "coordinates" && <CoordinatesTab draft={draft} errors={errors} update={update}/>}
+          {activeTab === "visibility" && <VisibilityTab draft={draft} currentTf={_currentTf} update={update}/>}
+        </div>
+
+        <footer className="drawing-settings-footer">
+          <select className="drawing-settings-select max-w-36" aria-label="Template" defaultValue="" onChange={(event) => { if (event.target.value === "__default") setTypeDefault(draft.type, draft); else { const template = getTemplates().find((item) => item.name === event.target.value); if (template) update(template.style); } event.currentTarget.value = ""; }}>
+            <option value="">Template</option>{getTemplates().map((template) => <option key={template.name} value={template.name}>{template.name}</option>)}<option value="__default">Set as default</option>
+          </select>
+          <div className="drawing-settings-footer-actions">
+            <button type="button" className="drawing-settings-button" onClick={cancel}>Cancel</button>
+            <button
+              type="button"
+              className="drawing-settings-button drawing-settings-button--primary"
+              disabled={!canCommit}
+              onClick={commit}
+            >
+              OK
+            </button>
+          </div>
+        </footer>
+      </section>
+    </dialog>,
+    drawingPortalRoot(),
+  );
+}
diff --git a/src/pages/trading/drawing-settings/PositionInputsTab.tsx b/src/pages/trading/drawing-settings/PositionInputsTab.tsx
new file mode 100644
index 0000000..19ee497
--- /dev/null
+++ b/src/pages/trading/drawing-settings/PositionInputsTab.tsx
@@ -0,0 +1,22 @@
+import type { DrawingSettingsDraft } from "../drawingSettingsModel.ts";
+import { positionMetrics } from "../drawingSettingsModel.ts";
+import { NumberField, SectionLabel, SelectField } from "./SettingsControls.tsx";
+
+export function PositionInputsTab({ draft, errors, update }: { draft: DrawingSettingsDraft; errors: Partial<Record<keyof DrawingSettingsDraft,string>>; update: (patch: Partial<DrawingSettingsDraft>) => void }) {
+  const metrics = positionMetrics(draft);
+  return <div className="drawing-settings-stack drawing-settings-position-inputs">
+    <NumberField label="Account size" value={draft.accountSize} error={errors.accountSize} onChange={(accountSize) => update({ accountSize })}/>
+    <NumberField label="Lot size" value={draft.lotSize} error={errors.lotSize} onChange={(lotSize) => update({ lotSize })}/>
+    <div className="drawing-settings-split-field"><NumberField label="Risk" value={draft.riskValue} error={errors.riskValue} onChange={(riskValue) => update({ riskValue })}/><SelectField label="Risk unit" value={draft.riskUnit} onChange={(riskUnit) => update({ riskUnit: riskUnit as DrawingSettingsDraft["riskUnit"] })}><option value="percent">%</option><option value="currency">Currency</option></SelectField></div>
+    <NumberField label="Entry price" value={draft.price} error={errors.price} onChange={(price) => update({ price })}/>
+    <NumberField label="Leverage" value={draft.leverage} error={errors.leverage} onChange={(leverage) => update({ leverage })}/>
+    <SectionLabel>Profit level</SectionLabel>
+    <NumberField label="Target price" value={draft.targetPrice} error={errors.targetPrice} onChange={(targetPrice) => update({ targetPrice })}/>
+    <div className="drawing-settings-derived"><span>Target ticks</span><strong>{metrics?.targetTicks.toFixed(0) ?? "—"}</strong></div>
+    <SectionLabel>Stop level</SectionLabel>
+    <NumberField label="Stop price" value={draft.stopPrice} error={errors.stopPrice} onChange={(stopPrice) => update({ stopPrice })}/>
+    <div className="drawing-settings-derived"><span>Stop ticks</span><strong>{metrics?.stopTicks.toFixed(0) ?? "—"}</strong></div>
+    <SelectField label="QTY precision" value={draft.quantityPrecision} onChange={(quantityPrecision) => update({ quantityPrecision: quantityPrecision === "default" ? "default" : Number(quantityPrecision) as DrawingSettingsDraft["quantityPrecision"] })}><option value="default">Default</option>{[0,1,2,3,4,5,6].map((item) => <option key={item} value={item}>{item}</option>)}</SelectField>
+    {metrics && <div className="drawing-settings-position-summary" role="status"><strong>Risk/reward {metrics.riskReward.toFixed(2)}</strong><span>Risk {metrics.riskAmount.toFixed(2)} · Qty {metrics.quantity.toFixed(2)} · Margin {metrics.margin.toFixed(2)}</span></div>}
+  </div>;
+}
diff --git a/src/pages/trading/drawing-settings/SettingsControls.tsx b/src/pages/trading/drawing-settings/SettingsControls.tsx
new file mode 100644
index 0000000..202ee29
--- /dev/null
+++ b/src/pages/trading/drawing-settings/SettingsControls.tsx
@@ -0,0 +1,123 @@
+import { useId, useRef, type ReactNode, type RefObject } from "react";
+import type { DrawingLineStyle } from "../constants.ts";
+import type { DrawingSettingsTab } from "../drawingSettingsModel.ts";
+
+export function SettingsField({ label, children, className = "" }: { label: ReactNode; children: ReactNode; className?: string }) {
+  return <div className={`drawing-settings-field ${className}`.trim()}><span>{label}</span><div className="drawing-settings-control">{children}</div></div>;
+}
+
+export function NumberField({ label, value, onChange, error, step = "any" }: {
+  label: string;
+  value: number | undefined;
+  onChange: (value: number) => void;
+  error?: string;
+  step?: number | "any";
+}) {
+  const id = useId();
+  const errorId = `${id}-error`;
+  return <div className="drawing-settings-field">
+    <label htmlFor={id}>{label}</label>
+    <input id={id} className="drawing-settings-input drawing-settings-value" type="number" inputMode="decimal" step={step}
+      value={value != null && Number.isFinite(value) ? value : ""}
+      aria-invalid={Boolean(error)} aria-describedby={error ? errorId : undefined}
+      onChange={(event) => onChange(event.target.value === "" ? Number.NaN : Number(event.target.value))}/>
+    {error && <p id={errorId} className="drawing-settings-error" role="alert">{error}</p>}
+  </div>;
+}
+
+export function SelectField({ label, value, onChange, children }: {
+  label: string;
+  value: string | number;
+  onChange: (value: string) => void;
+  children: ReactNode;
+}) {
+  const id = useId();
+  return <div className="drawing-settings-field">
+    <label htmlFor={id}>{label}</label>
+    <select id={id} className="drawing-settings-select drawing-settings-value" value={value} onChange={(event) => onChange(event.target.value)}>{children}</select>
+  </div>;
+}
+
+export function CheckboxField({ label, checked, onChange, children }: {
+  label: string;
+  checked: boolean;
+  onChange: (checked: boolean) => void;
+  children?: ReactNode;
+}) {
+  return <div className="drawing-settings-check-row">
+    <label className="drawing-settings-check">
+      <input type="checkbox" checked={checked} onChange={(event) => onChange(event.target.checked)}/>
+      <span aria-hidden="true" className="drawing-settings-check-mark" />
+      <span>{label}</span>
+    </label>
+    {children && <div className="drawing-settings-check-control">{children}</div>}
+  </div>;
+}
+
+export function ColorControl({ label, value, onChange, opacity, onOpacity }: {
+  label: string;
+  value: string;
+  onChange: (value: string) => void;
+  opacity?: number;
+  onOpacity?: (value: number) => void;
+}) {
+  const id = useId();
+  return <div className="drawing-settings-color-control">
+    <label className="drawing-settings-color-swatch" htmlFor={id} style={{ "--swatch": value } as React.CSSProperties}>
+      <span className="sr-only">{label}</span>
+      <input id={id} aria-label={label} type="color" value={value} onChange={(event) => onChange(event.target.value)}/>
+    </label>
+    {onOpacity && <input className="drawing-settings-opacity" aria-label={`${label} opacity`} type="range" min="0" max="1" step="0.05" value={opacity ?? 1} onChange={(event) => onOpacity(Number(event.target.value))}/>}
+  </div>;
+}
+
+export function LineControl({ label, color, width, style, opacity, onChange }: {
+  label: string;
+  color: string;
+  width: number;
+  style: DrawingLineStyle;
+  opacity: number;
+  onChange: (patch: { color?: string; width?: number; lineStyle?: DrawingLineStyle; opacity?: number }) => void;
+}) {
+  return <fieldset className="drawing-settings-line-control" aria-label={label}>
+    <ColorControl label={`${label} color`} value={color} onChange={(next) => onChange({ color: next })} opacity={opacity} onOpacity={(next) => onChange({ opacity: next })}/>
+    <select aria-label={`${label} width`} value={width} onChange={(event) => onChange({ width: Number(event.target.value) })}>
+      {[1,2,3,4].map((item) => <option key={item} value={item}>{item}px</option>)}
+    </select>
+    <select aria-label={`${label} style`} value={style} onChange={(event) => onChange({ lineStyle: event.target.value as DrawingLineStyle })}>
+      <option value="solid">Solid</option><option value="dashed">Dashed</option><option value="dotted">Dotted</option>
+    </select>
+    <span className={`drawing-settings-line-preview drawing-settings-line-preview--${style}`} style={{ color }} aria-hidden="true" />
+  </fieldset>;
+}
+
+export function SectionLabel({ children }: { children: ReactNode }) {
+  return <h3 className="drawing-settings-section-label">{children}</h3>;
+}
+
+export function TabList({ tabs, active, onChange, initialFocusRef }: {
+  tabs: DrawingSettingsTab[];
+  active: DrawingSettingsTab;
+  onChange: (tab: DrawingSettingsTab) => void;
+  initialFocusRef: RefObject<HTMLButtonElement | null>;
+}) {
+  const refs = useRef(new Map<DrawingSettingsTab, HTMLButtonElement>());
+  const activate = (tab: DrawingSettingsTab) => { onChange(tab); refs.current.get(tab)?.focus(); };
+  return <div className="drawing-settings-tabs" role="tablist" aria-label="Drawing settings sections">
+    {tabs.map((tab, index) => <button key={tab}
+      ref={(node) => { if (node) { refs.current.set(tab, node); if (index === 0) (initialFocusRef as React.MutableRefObject<HTMLButtonElement | null>).current = node; } }}
+      type="button" role="tab" aria-selected={active === tab} tabIndex={active === tab ? 0 : -1}
+      className="drawing-settings-tab" onClick={() => onChange(tab)}
+      onKeyDown={(event) => {
+        const current = tabs.indexOf(tab);
+        let next = -1;
+        if (event.key === "ArrowRight") next = (current + 1) % tabs.length;
+        if (event.key === "ArrowLeft") next = (current - 1 + tabs.length) % tabs.length;
+        if (event.key === "Home") next = 0;
+        if (event.key === "End") next = tabs.length - 1;
+        if (next >= 0) { event.preventDefault(); activate(tabs[next]!); }
+      }}>
+      {tab.charAt(0).toUpperCase() + tab.slice(1)}
+    </button>)}
+  </div>;
+}
diff --git a/src/pages/trading/drawing-settings/StyleTab.tsx b/src/pages/trading/drawing-settings/StyleTab.tsx
new file mode 100644
index 0000000..ee00d3d
--- /dev/null
+++ b/src/pages/trading/drawing-settings/StyleTab.tsx
@@ -0,0 +1,98 @@
+import type { DrawingFibLevelStyle } from "../constants.ts";
+import { FIB_COLORS, FIB_EXT_LEVELS, FIB_LEVELS } from "../../../lib/chart-plugins/drawing-tools/resolve.ts";
+import type { DrawingSettingsDraft, DrawingSettingsErrors } from "../drawingSettingsModel.ts";
+import { CheckboxField, ColorControl, LineControl, SectionLabel, SelectField, SettingsField } from "./SettingsControls.tsx";
+
+type Update = (patch: Partial<DrawingSettingsDraft>) => void;
+const SHAPES = new Set(["rectangle", "ellipse", "triangle", "channel"]);
+const RANGES = new Set(["price-range", "date-range", "date-price-range"]);
+const TEXTS = new Set(["text", "anchored-text", "note"]);
+
+function BaseLine({ draft, update, label = "Lines" }: { draft: DrawingSettingsDraft; update: Update; label?: string }) {
+  return <SettingsField label={label}><LineControl label={label} color={draft.color} width={draft.width ?? 2} style={draft.lineStyle ?? "solid"} opacity={draft.opacity} onChange={(patch) => update(patch)}/></SettingsField>;
+}
+
+function Extend({ draft, update }: { draft: DrawingSettingsDraft; update: Update }) {
+  const value = draft.extendLeft && draft.extendRight ? "both" : draft.extendLeft ? "left" : draft.extendRight ? "right" : "none";
+  return <SelectField label="Extend" value={value} onChange={(next) => update({ extendLeft: next === "left" || next === "both", extendRight: next === "right" || next === "both" })}>
+    <option value="none">Don't extend</option><option value="left">Extend left</option><option value="right">Extend right</option><option value="both">Extend both</option>
+  </SelectField>;
+}
+
+function ShapeStyle({ draft, update }: { draft: DrawingSettingsDraft; update: Update }) {
+  return <div className="drawing-settings-stack">
+    {draft.type === "rectangle" && <Extend draft={draft} update={update}/>}
+    <SettingsField label="Border"><LineControl label="Border" color={draft.color} width={draft.width ?? 2} style={draft.lineStyle ?? "solid"} opacity={draft.opacity} onChange={(patch) => update(patch)}/></SettingsField>
+    {draft.type === "channel" && <CheckboxField label="Middle line" checked={Boolean(draft.secondaryColor)} onChange={(checked) => update({ secondaryColor: checked ? draft.color : undefined })}>
+      <LineControl label="Middle line" color={draft.secondaryColor ?? draft.color} width={draft.secondaryWidth ?? 1} style={draft.secondaryLineStyle ?? "dashed"} opacity={draft.opacity} onChange={(patch) => update({ secondaryColor: patch.color ?? draft.secondaryColor ?? draft.color, secondaryWidth: patch.width, secondaryLineStyle: patch.lineStyle })}/>
+    </CheckboxField>}
+    <CheckboxField label="Background" checked={(draft.fillOpacity ?? 0) > 0} onChange={(checked) => update({ fillOpacity: checked ? Math.max(draft.fillOpacity, 0.14) : 0 })}>
+      <ColorControl label="Background color" value={draft.fillColor} onChange={(fillColor) => update({ fillColor })} opacity={draft.fillOpacity} onOpacity={(fillOpacity) => update({ fillOpacity })}/>
+    </CheckboxField>
+  </div>;
+}
+
+function PositionStyle({ draft, update }: { draft: DrawingSettingsDraft; update: Update }) {
+  return <div className="drawing-settings-stack">
+    <BaseLine draft={draft} update={update}/>
+    <SettingsField label="Stop color"><ColorControl label="Stop color" value={draft.stopColor} onChange={(stopColor) => update({ stopColor })} opacity={draft.stopFillOpacity} onOpacity={(stopFillOpacity) => update({ stopFillOpacity })}/></SettingsField>
+    <SettingsField label="Target color"><ColorControl label="Target color" value={draft.targetColor} onChange={(targetColor) => update({ targetColor })} opacity={draft.targetFillOpacity} onOpacity={(targetFillOpacity) => update({ targetFillOpacity })}/></SettingsField>
+    <SettingsField label="Text"><ColorControl label="Text color" value={draft.labelColor} onChange={(labelColor) => update({ labelColor })}/><select className="drawing-settings-select drawing-settings-select--compact" aria-label="Text size" value={draft.fontSize ?? 12} onChange={(event) => update({ fontSize: Number(event.target.value) })}>{[10,11,12,14,16,18].map((size) => <option key={size} value={size}>{size}</option>)}</select></SettingsField>
+    <CheckboxField label="Price labels" checked={draft.showPriceLabels} onChange={(showPriceLabels) => update({ showPriceLabels })}/>
+    <SectionLabel>Info</SectionLabel>
+    <SelectField label="Stats" value={draft.statsMode} onChange={(statsMode) => update({ statsMode: statsMode as DrawingSettingsDraft["statsMode"] })}>
+      <option value="price-offsets">TP price offset, TP/SL amounts</option><option value="risk-reward">Risk/reward ratio</option><option value="amounts">Amounts</option><option value="all">All stats</option>
+    </SelectField>
+    <CheckboxField label="Compact stats mode" checked={draft.compactStats} onChange={(compactStats) => update({ compactStats })}/>
+    <CheckboxField label="Always show stats" checked={draft.alwaysShowStats} onChange={(alwaysShowStats) => update({ alwaysShowStats })}/>
+  </div>;
+}
+
+function RangeStyle({ draft, update }: { draft: DrawingSettingsDraft; update: Update }) {
+  return <div className="drawing-settings-stack">
+    <BaseLine draft={draft} update={update}/>
+    <SettingsField label="Positive color"><ColorControl label="Positive color" value={draft.positiveColor} onChange={(positiveColor) => update({ positiveColor })}/></SettingsField>
+    <SettingsField label="Negative color"><ColorControl label="Negative color" value={draft.negativeColor} onChange={(negativeColor) => update({ negativeColor })}/></SettingsField>
+    <SettingsField label="Background"><ColorControl label="Background color" value={draft.fillColor} onChange={(fillColor) => update({ fillColor })} opacity={draft.fillOpacity} onOpacity={(fillOpacity) => update({ fillOpacity })}/></SettingsField>
+    <SettingsField label="Label color"><ColorControl label="Label color" value={draft.labelColor} onChange={(labelColor) => update({ labelColor })}/></SettingsField>
+    <SelectField label="Label mode" value={draft.rangeLabelMode} onChange={(rangeLabelMode) => update({ rangeLabelMode: rangeLabelMode as "compact" | "full" })}><option value="full">Full</option><option value="compact">Compact</option></SelectField>
+  </div>;
+}
+
+function FibonacciStyle({ draft, errors, update }: { draft: DrawingSettingsDraft; errors: DrawingSettingsErrors; update: Update }) {
+  const defaults = draft.type === "fibextension" ? FIB_EXT_LEVELS : FIB_LEVELS;
+  const levels: DrawingFibLevelStyle[] = draft.fibLevelStyles?.length
+    ? draft.fibLevelStyles
+    : (draft.fibLevels ?? defaults).map((value, index) => ({
+        value,
+        enabled: true,
+        color: FIB_COLORS[index] ?? draft.color,
+      }));
+  const updateLevel = (index: number, patch: Partial<DrawingFibLevelStyle>) => {
+    update({ fibLevelStyles: levels.map((level, levelIndex) => levelIndex === index ? { ...level, ...patch } : level) });
+  };
+  return <div className="drawing-settings-stack">
+    <BaseLine draft={draft} update={update}/>
+    <fieldset className="drawing-settings-levels" aria-label="Levels">
+      <legend>Levels</legend>
+      {levels.map((level, index) => <div className="drawing-settings-level-row" key={index}>
+        <label className="drawing-settings-level-toggle">
+          <input aria-label={`Enable level ${index + 1}`} type="checkbox" checked={level.enabled} onChange={(event) => updateLevel(index, { enabled: event.target.checked })}/>
+          <span aria-hidden="true" className="drawing-settings-check-mark" />
+        </label>
+        <input className="drawing-settings-input drawing-settings-level-value" aria-label={`Level ${index + 1} value`} type="number" step="any" value={Number.isFinite(level.value) ? level.value : ""} onChange={(event) => updateLevel(index, { value: event.target.value === "" ? Number.NaN : Number(event.target.value) })}/>
+        <ColorControl label={`Level ${index + 1} color`} value={level.color ?? FIB_COLORS[index] ?? draft.color} onChange={(color) => updateLevel(index, { color })}/>
+      </div>)}
+      {errors.fibLevelStyles && <p className="drawing-settings-error" role="alert">{errors.fibLevelStyles}</p>}
+    </fieldset>
+  </div>;
+}
+
+export function StyleTab({ draft, errors, update }: { draft: DrawingSettingsDraft; errors: DrawingSettingsErrors; update: Update }) {
+  if (draft.type === "position") return <PositionStyle draft={draft} update={update}/>;
+  if (SHAPES.has(draft.type)) return <ShapeStyle draft={draft} update={update}/>;
+  if (RANGES.has(draft.type)) return <RangeStyle draft={draft} update={update}/>;
+  if (draft.type === "fibonacci" || draft.type === "fibextension") return <FibonacciStyle draft={draft} errors={errors} update={update}/>;
+  if (TEXTS.has(draft.type)) return <div className="drawing-settings-stack"><SettingsField label={draft.type === "note" ? "Marker" : "Text color"}><ColorControl label={draft.type === "note" ? "Marker color" : "Text color"} value={draft.color} onChange={(color) => update({ color })}/></SettingsField><CheckboxField label="Background" checked={Boolean(draft.textBg)} onChange={(textBg) => update({ textBg })}/><CheckboxField label="Border" checked={Boolean(draft.textBorder)} onChange={(textBorder) => update({ textBorder })}/></div>;
+  return <div className="drawing-settings-stack"><BaseLine draft={draft} update={update}/>{(draft.type === "trendline" || draft.type === "horizontal") && <Extend draft={draft} update={update}/>} {(draft.type === "trendline" || draft.type === "arrow") && <><CheckboxField label="Start arrow" checked={Boolean(draft.arrowStart)} onChange={(arrowStart) => update({ arrowStart })}/><CheckboxField label="End arrow" checked={Boolean(draft.arrowEnd)} onChange={(arrowEnd) => update({ arrowEnd })}/></>}</div>;
+}
