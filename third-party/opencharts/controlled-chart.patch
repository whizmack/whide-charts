+import type { DrawingSettingsDraft } from "../drawingSettingsModel.ts";
+import { positionMetrics } from "../drawingSettingsModel.ts";
+import { NumberField, SectionLabel, SelectField } from "./SettingsControls.tsx";
+
+export function PositionInputsTab({ draft, errors, update }: { draft: DrawingSettingsDraft; errors: Partial<Record<keyof DrawingSettingsDraft,string>>; update: (patch: Partial<DrawingSettingsDraft>) => void }) {
+  const metrics = positionMetrics(draft);
+  return <div className="drawing-settings-stack drawing-settings-position-inputs">
+    <NumberField label="Account size" value={draft.accountSize} error={errors.accountSize} onChange={(accountSize) => update({ accountSize })}/>
+    <NumberField label="Lot size" value={draft.lotSize} error={errors.lotSize} onChange={(lotSize) => update({ lotSize })}/>
+    <div className="drawing-settings-split-field"><NumberField label="Risk" value={draft.riskValue} error={errors.riskValue} onChange={(riskValue) => update({ riskValue })}/><SelectField label="Risk unit" value={draft.riskUnit} onChange={(riskUnit) => update({ riskUnit: riskUnit as DrawingSettingsDraft["riskUnit"] })}><option value="percent">%</option><option value="currency">Currency</option></SelectField></div>
+    <NumberField label="Entry price" value={draft.price} error={errors.price} onChange={(price) => update({ price })}/>
+    <NumberField label="Leverage" value={draft.leverage} error={errors.leverage} onChange={(leverage) => update({ leverage })}/>
+    <SectionLabel>Profit level</SectionLabel>
+    <NumberField label="Target price" value={draft.targetPrice} error={errors.targetPrice} onChange={(targetPrice) => update({ targetPrice })}/>
+    <div className="drawing-settings-derived"><span>Target ticks</span><strong>{metrics?.targetTicks.toFixed(0) ?? "—"}</strong></div>
+    <SectionLabel>Stop level</SectionLabel>
+    <NumberField label="Stop price" value={draft.stopPrice} error={errors.stopPrice} onChange={(stopPrice) => update({ stopPrice })}/>
+    <div className="drawing-settings-derived"><span>Stop ticks</span><strong>{metrics?.stopTicks.toFixed(0) ?? "—"}</strong></div>
+    <SelectField label="QTY precision" value={draft.quantityPrecision} onChange={(quantityPrecision) => update({ quantityPrecision: quantityPrecision === "default" ? "default" : Number(quantityPrecision) as DrawingSettingsDraft["quantityPrecision"] })}><option value="default">Default</option>{[0,1,2,3,4,5,6].map((item) => <option key={item} value={item}>{item}</option>)}</SelectField>
+    {metrics && <div className="drawing-settings-position-summary" role="status"><strong>Risk/reward {metrics.riskReward.toFixed(2)}</strong><span>Risk {metrics.riskAmount.toFixed(2)} · Qty {metrics.quantity.toFixed(2)} · Margin {metrics.margin.toFixed(2)}</span></div>}
+  </div>;
+}
diff --git a/src/pages/trading/drawing-settings/SettingsControls.tsx b/src/pages/trading/drawing-settings/SettingsControls.tsx
new file mode 100644
index 0000000..c07205a
--- /dev/null
+++ b/src/pages/trading/drawing-settings/SettingsControls.tsx
@@ -0,0 +1,119 @@
+import { useId, useRef, type ReactNode, type RefObject } from "react";
+import type { DrawingLineStyle } from "../constants.ts";
+import { TradingViewColorPicker } from "../../../components/TradingViewColorPicker.tsx";
+import type { DrawingSettingsTab } from "../drawingSettingsModel.ts";
+
+export function SettingsField({ label, children, className = "" }: { label: ReactNode; children: ReactNode; className?: string }) {
+  return <div className={`drawing-settings-field ${className}`.trim()}><span>{label}</span><div className="drawing-settings-control">{children}</div></div>;
+}
+
+export function NumberField({ label, value, onChange, error, step = "any" }: {
+  label: string;
+  value: number | undefined;
+  onChange: (value: number) => void;
+  error?: string;
+  step?: number | "any";
+}) {
+  const id = useId();
+  const errorId = `${id}-error`;
+  return <div className="drawing-settings-field">
+    <label htmlFor={id}>{label}</label>
+    <input id={id} className="drawing-settings-input drawing-settings-value" type="number" inputMode="decimal" step={step}
+      value={value != null && Number.isFinite(value) ? value : ""}
+      aria-invalid={Boolean(error)} aria-describedby={error ? errorId : undefined}
+      onChange={(event) => onChange(event.target.value === "" ? Number.NaN : Number(event.target.value))}/>
+    {error && <p id={errorId} className="drawing-settings-error" role="alert">{error}</p>}
+  </div>;
+}
+
+export function SelectField({ label, value, onChange, children }: {
+  label: string;
+  value: string | number;
+  onChange: (value: string) => void;
+  children: ReactNode;
+}) {
+  const id = useId();
+  return <div className="drawing-settings-field">
+    <label htmlFor={id}>{label}</label>
+    <select id={id} className="drawing-settings-select drawing-settings-value" value={value} onChange={(event) => onChange(event.target.value)}>{children}</select>
+  </div>;
+}
+
+export function CheckboxField({ label, checked, onChange, children }: {
+  label: string;
+  checked: boolean;
+  onChange: (checked: boolean) => void;
+  children?: ReactNode;
+}) {
+  return <div className="drawing-settings-check-row">
+    <label className="drawing-settings-check">
+      <input type="checkbox" checked={checked} onChange={(event) => onChange(event.target.checked)}/>
+      <span aria-hidden="true" className="drawing-settings-check-mark" />
+      <span>{label}</span>
+    </label>
+    {children && <div className="drawing-settings-check-control">{children}</div>}
+  </div>;
+}
+
+export function ColorControl({ label, value, onChange, opacity, onOpacity }: {
+  label: string;
+  value: string;
+  onChange: (value: string) => void;
+  opacity?: number;
+  onOpacity?: (value: number) => void;
+}) {
+  return <div className="drawing-settings-color-control">
+    <TradingViewColorPicker label={label} value={value} onChange={onChange} opacity={opacity} onOpacity={onOpacity} className="drawing-settings-color-picker"/>
+  </div>;
+}
+
+export function LineControl({ label, color, width, style, opacity, onChange }: {
+  label: string;
+  color: string;
+  width: number;
+  style: DrawingLineStyle;
+  opacity: number;
+  onChange: (patch: { color?: string; width?: number; lineStyle?: DrawingLineStyle; opacity?: number }) => void;
+}) {
+  return <fieldset className="drawing-settings-line-control" aria-label={label}>
+    <ColorControl label={`${label} color`} value={color} onChange={(next) => onChange({ color: next })} opacity={opacity} onOpacity={(next) => onChange({ opacity: next })}/>
+    <select aria-label={`${label} width`} value={width} onChange={(event) => onChange({ width: Number(event.target.value) })}>
+      {[1,2,3,4].map((item) => <option key={item} value={item}>{item}px</option>)}
+    </select>
+    <select aria-label={`${label} style`} value={style} onChange={(event) => onChange({ lineStyle: event.target.value as DrawingLineStyle })}>
+      <option value="solid">Solid</option><option value="dashed">Dashed</option><option value="dotted">Dotted</option>
+    </select>
+    <span className={`drawing-settings-line-preview drawing-settings-line-preview--${style}`} style={{ color }} aria-hidden="true" />
+  </fieldset>;
+}
+
+export function SectionLabel({ children }: { children: ReactNode }) {
+  return <h3 className="drawing-settings-section-label">{children}</h3>;
+}
+
+export function TabList({ tabs, active, onChange, initialFocusRef }: {
+  tabs: DrawingSettingsTab[];
+  active: DrawingSettingsTab;
+  onChange: (tab: DrawingSettingsTab) => void;
+  initialFocusRef: RefObject<HTMLButtonElement | null>;
+}) {
+  const refs = useRef(new Map<DrawingSettingsTab, HTMLButtonElement>());
+  const activate = (tab: DrawingSettingsTab) => { onChange(tab); refs.current.get(tab)?.focus(); };
+  return <div className="drawing-settings-tabs" role="tablist" aria-label="Drawing settings sections">
+    {tabs.map((tab, index) => <button key={tab}
+      ref={(node) => { if (node) { refs.current.set(tab, node); if (index === 0) (initialFocusRef as React.MutableRefObject<HTMLButtonElement | null>).current = node; } }}
+      type="button" role="tab" aria-selected={active === tab} tabIndex={active === tab ? 0 : -1}
+      className="drawing-settings-tab" onClick={() => onChange(tab)}
+      onKeyDown={(event) => {
+        const current = tabs.indexOf(tab);
+        let next = -1;
+        if (event.key === "ArrowRight") next = (current + 1) % tabs.length;
+        if (event.key === "ArrowLeft") next = (current - 1 + tabs.length) % tabs.length;
+        if (event.key === "Home") next = 0;
+        if (event.key === "End") next = tabs.length - 1;
+        if (next >= 0) { event.preventDefault(); activate(tabs[next]!); }
+      }}>
+      {tab.charAt(0).toUpperCase() + tab.slice(1)}
+    </button>)}
+  </div>;
+}
diff --git a/src/pages/trading/drawing-settings/StyleTab.tsx b/src/pages/trading/drawing-settings/StyleTab.tsx
new file mode 100644
index 0000000..ee00d3d
--- /dev/null
+++ b/src/pages/trading/drawing-settings/StyleTab.tsx
@@ -0,0 +1,98 @@
+import type { DrawingFibLevelStyle } from "../constants.ts";
+import { FIB_COLORS, FIB_EXT_LEVELS, FIB_LEVELS } from "../../../lib/chart-plugins/drawing-tools/resolve.ts";
+import type { DrawingSettingsDraft, DrawingSettingsErrors } from "../drawingSettingsModel.ts";
+import { CheckboxField, ColorControl, LineControl, SectionLabel, SelectField, SettingsField } from "./SettingsControls.tsx";
+
+type Update = (patch: Partial<DrawingSettingsDraft>) => void;
+const SHAPES = new Set(["rectangle", "ellipse", "triangle", "channel"]);
+const RANGES = new Set(["price-range", "date-range", "date-price-range"]);
+const TEXTS = new Set(["text", "anchored-text", "note"]);
+
+function BaseLine({ draft, update, label = "Lines" }: { draft: DrawingSettingsDraft; update: Update; label?: string }) {
+  return <SettingsField label={label}><LineControl label={label} color={draft.color} width={draft.width ?? 2} style={draft.lineStyle ?? "solid"} opacity={draft.opacity} onChange={(patch) => update(patch)}/></SettingsField>;
+}
+
+function Extend({ draft, update }: { draft: DrawingSettingsDraft; update: Update }) {
+  const value = draft.extendLeft && draft.extendRight ? "both" : draft.extendLeft ? "left" : draft.extendRight ? "right" : "none";
+  return <SelectField label="Extend" value={value} onChange={(next) => update({ extendLeft: next === "left" || next === "both", extendRight: next === "right" || next === "both" })}>
+    <option value="none">Don't extend</option><option value="left">Extend left</option><option value="right">Extend right</option><option value="both">Extend both</option>
+  </SelectField>;
+}
+
+function ShapeStyle({ draft, update }: { draft: DrawingSettingsDraft; update: Update }) {
+  return <div className="drawing-settings-stack">
+    {draft.type === "rectangle" && <Extend draft={draft} update={update}/>}
+    <SettingsField label="Border"><LineControl label="Border" color={draft.color} width={draft.width ?? 2} style={draft.lineStyle ?? "solid"} opacity={draft.opacity} onChange={(patch) => update(patch)}/></SettingsField>
+    {draft.type === "channel" && <CheckboxField label="Middle line" checked={Boolean(draft.secondaryColor)} onChange={(checked) => update({ secondaryColor: checked ? draft.color : undefined })}>
+      <LineControl label="Middle line" color={draft.secondaryColor ?? draft.color} width={draft.secondaryWidth ?? 1} style={draft.secondaryLineStyle ?? "dashed"} opacity={draft.opacity} onChange={(patch) => update({ secondaryColor: patch.color ?? draft.secondaryColor ?? draft.color, secondaryWidth: patch.width, secondaryLineStyle: patch.lineStyle })}/>
+    </CheckboxField>}
+    <CheckboxField label="Background" checked={(draft.fillOpacity ?? 0) > 0} onChange={(checked) => update({ fillOpacity: checked ? Math.max(draft.fillOpacity, 0.14) : 0 })}>
+      <ColorControl label="Background color" value={draft.fillColor} onChange={(fillColor) => update({ fillColor })} opacity={draft.fillOpacity} onOpacity={(fillOpacity) => update({ fillOpacity })}/>
+    </CheckboxField>
+  </div>;
+}
+
+function PositionStyle({ draft, update }: { draft: DrawingSettingsDraft; update: Update }) {
+  return <div className="drawing-settings-stack">
+    <BaseLine draft={draft} update={update}/>
+    <SettingsField label="Stop color"><ColorControl label="Stop color" value={draft.stopColor} onChange={(stopColor) => update({ stopColor })} opacity={draft.stopFillOpacity} onOpacity={(stopFillOpacity) => update({ stopFillOpacity })}/></SettingsField>
+    <SettingsField label="Target color"><ColorControl label="Target color" value={draft.targetColor} onChange={(targetColor) => update({ targetColor })} opacity={draft.targetFillOpacity} onOpacity={(targetFillOpacity) => update({ targetFillOpacity })}/></SettingsField>
+    <SettingsField label="Text"><ColorControl label="Text color" value={draft.labelColor} onChange={(labelColor) => update({ labelColor })}/><select className="drawing-settings-select drawing-settings-select--compact" aria-label="Text size" value={draft.fontSize ?? 12} onChange={(event) => update({ fontSize: Number(event.target.value) })}>{[10,11,12,14,16,18].map((size) => <option key={size} value={size}>{size}</option>)}</select></SettingsField>
+    <CheckboxField label="Price labels" checked={draft.showPriceLabels} onChange={(showPriceLabels) => update({ showPriceLabels })}/>
+    <SectionLabel>Info</SectionLabel>
+    <SelectField label="Stats" value={draft.statsMode} onChange={(statsMode) => update({ statsMode: statsMode as DrawingSettingsDraft["statsMode"] })}>
+      <option value="price-offsets">TP price offset, TP/SL amounts</option><option value="risk-reward">Risk/reward ratio</option><option value="amounts">Amounts</option><option value="all">All stats</option>
+    </SelectField>
+    <CheckboxField label="Compact stats mode" checked={draft.compactStats} onChange={(compactStats) => update({ compactStats })}/>
+    <CheckboxField label="Always show stats" checked={draft.alwaysShowStats} onChange={(alwaysShowStats) => update({ alwaysShowStats })}/>
+  </div>;
+}
+
+function RangeStyle({ draft, update }: { draft: DrawingSettingsDraft; update: Update }) {
+  return <div className="drawing-settings-stack">
+    <BaseLine draft={draft} update={update}/>
+    <SettingsField label="Positive color"><ColorControl label="Positive color" value={draft.positiveColor} onChange={(positiveColor) => update({ positiveColor })}/></SettingsField>
+    <SettingsField label="Negative color"><ColorControl label="Negative color" value={draft.negativeColor} onChange={(negativeColor) => update({ negativeColor })}/></SettingsField>
+    <SettingsField label="Background"><ColorControl label="Background color" value={draft.fillColor} onChange={(fillColor) => update({ fillColor })} opacity={draft.fillOpacity} onOpacity={(fillOpacity) => update({ fillOpacity })}/></SettingsField>
+    <SettingsField label="Label color"><ColorControl label="Label color" value={draft.labelColor} onChange={(labelColor) => update({ labelColor })}/></SettingsField>
+    <SelectField label="Label mode" value={draft.rangeLabelMode} onChange={(rangeLabelMode) => update({ rangeLabelMode: rangeLabelMode as "compact" | "full" })}><option value="full">Full</option><option value="compact">Compact</option></SelectField>
+  </div>;
+}
+
+function FibonacciStyle({ draft, errors, update }: { draft: DrawingSettingsDraft; errors: DrawingSettingsErrors; update: Update }) {
+  const defaults = draft.type === "fibextension" ? FIB_EXT_LEVELS : FIB_LEVELS;
+  const levels: DrawingFibLevelStyle[] = draft.fibLevelStyles?.length
+    ? draft.fibLevelStyles
+    : (draft.fibLevels ?? defaults).map((value, index) => ({
+        value,
+        enabled: true,
+        color: FIB_COLORS[index] ?? draft.color,
+      }));
+  const updateLevel = (index: number, patch: Partial<DrawingFibLevelStyle>) => {
+    update({ fibLevelStyles: levels.map((level, levelIndex) => levelIndex === index ? { ...level, ...patch } : level) });
+  };
+  return <div className="drawing-settings-stack">
+    <BaseLine draft={draft} update={update}/>
+    <fieldset className="drawing-settings-levels" aria-label="Levels">
+      <legend>Levels</legend>
+      {levels.map((level, index) => <div className="drawing-settings-level-row" key={index}>
+        <label className="drawing-settings-level-toggle">
+          <input aria-label={`Enable level ${index + 1}`} type="checkbox" checked={level.enabled} onChange={(event) => updateLevel(index, { enabled: event.target.checked })}/>
+          <span aria-hidden="true" className="drawing-settings-check-mark" />
+        </label>
+        <input className="drawing-settings-input drawing-settings-level-value" aria-label={`Level ${index + 1} value`} type="number" step="any" value={Number.isFinite(level.value) ? level.value : ""} onChange={(event) => updateLevel(index, { value: event.target.value === "" ? Number.NaN : Number(event.target.value) })}/>
+        <ColorControl label={`Level ${index + 1} color`} value={level.color ?? FIB_COLORS[index] ?? draft.color} onChange={(color) => updateLevel(index, { color })}/>
+      </div>)}
+      {errors.fibLevelStyles && <p className="drawing-settings-error" role="alert">{errors.fibLevelStyles}</p>}
+    </fieldset>
+  </div>;
+}
+
+export function StyleTab({ draft, errors, update }: { draft: DrawingSettingsDraft; errors: DrawingSettingsErrors; update: Update }) {
+  if (draft.type === "position") return <PositionStyle draft={draft} update={update}/>;
+  if (SHAPES.has(draft.type)) return <ShapeStyle draft={draft} update={update}/>;
+  if (RANGES.has(draft.type)) return <RangeStyle draft={draft} update={update}/>;
+  if (draft.type === "fibonacci" || draft.type === "fibextension") return <FibonacciStyle draft={draft} errors={errors} update={update}/>;
+  if (TEXTS.has(draft.type)) return <div className="drawing-settings-stack"><SettingsField label={draft.type === "note" ? "Marker" : "Text color"}><ColorControl label={draft.type === "note" ? "Marker color" : "Text color"} value={draft.color} onChange={(color) => update({ color })}/></SettingsField><CheckboxField label="Background" checked={Boolean(draft.textBg)} onChange={(textBg) => update({ textBg })}/><CheckboxField label="Border" checked={Boolean(draft.textBorder)} onChange={(textBorder) => update({ textBorder })}/></div>;
+  return <div className="drawing-settings-stack"><BaseLine draft={draft} update={update}/>{(draft.type === "trendline" || draft.type === "horizontal") && <Extend draft={draft} update={update}/>} {(draft.type === "trendline" || draft.type === "arrow") && <><CheckboxField label="Start arrow" checked={Boolean(draft.arrowStart)} onChange={(arrowStart) => update({ arrowStart })}/><CheckboxField label="End arrow" checked={Boolean(draft.arrowEnd)} onChange={(arrowEnd) => update({ arrowEnd })}/></>}</div>;
+}
diff --git a/src/pages/trading/drawing-settings/TextTab.tsx b/src/pages/trading/drawing-settings/TextTab.tsx
new file mode 100644
index 0000000..768cc85
--- /dev/null
+++ b/src/pages/trading/drawing-settings/TextTab.tsx
@@ -0,0 +1,25 @@
+import { Bold, Italic } from "lucide-react";
+import type { DrawingSettingsDraft } from "../drawingSettingsModel.ts";
+import { CheckboxField, ColorControl, SettingsField } from "./SettingsControls.tsx";
+
+export function TextTab({ draft, update }: { draft: DrawingSettingsDraft; update: (patch: Partial<DrawingSettingsDraft>) => void }) {
+  return <div className="drawing-settings-stack">
+    <div className="drawing-settings-format-bar">
+      <ColorControl label="Text color" value={draft.color} onChange={(color) => update({ color })}/>
+      <select className="drawing-settings-select drawing-settings-select--compact" aria-label="Font size" value={draft.fontSize ?? 14} onChange={(event) => update({ fontSize: Number(event.target.value) })}>
+        {[8,10,11,12,14,16,18,20,24,28,32,40,48].map((size) => <option key={size} value={size}>{size}</option>)}
+      </select>
+      <button type="button" className="drawing-settings-format-button" aria-label="Bold" aria-pressed={Boolean(draft.bold)} onClick={() => update({ bold: !draft.bold })}><Bold aria-hidden="true" size={18}/></button>
+      <button type="button" className="drawing-settings-format-button" aria-label="Italic" aria-pressed={Boolean(draft.italic)} onClick={() => update({ italic: !draft.italic })}><Italic aria-hidden="true" size={18}/></button>
+    </div>
+    <label className="drawing-settings-textarea-label"><span className="sr-only">Text</span><textarea className="drawing-settings-textarea" aria-label="Text" value={draft.text ?? ""} placeholder="Add text" onChange={(event) => update({ text: event.target.value })}/></label>
+    <SettingsField label="Text alignment">
+      <div className="drawing-settings-inline-selects">
+        <select className="drawing-settings-select" aria-label="Text placement" value={draft.textPlacement} onChange={(event) => update({ textPlacement: event.target.value as DrawingSettingsDraft["textPlacement"] })}><option value="inside">Inside</option><option value="outside">Outside</option><option value="above">Above</option><option value="below">Below</option></select>
+        <select className="drawing-settings-select" aria-label="Text alignment" value={draft.textAlign} onChange={(event) => update({ textAlign: event.target.value as DrawingSettingsDraft["textAlign"] })}><option value="left">Left</option><option value="center">Center</option><option value="right">Right</option></select>
+      </div>
+    </SettingsField>
+    <CheckboxField label="Background" checked={Boolean(draft.textBg)} onChange={(textBg) => update({ textBg })}><ColorControl label="Text background color" value={draft.textBgColor ?? "#1e222d"} onChange={(textBgColor) => update({ textBgColor, textBg: true })}/></CheckboxField>
+    <CheckboxField label="Border" checked={Boolean(draft.textBorder)} onChange={(textBorder) => update({ textBorder })}><ColorControl label="Text border color" value={draft.textBorderColor ?? draft.color} onChange={(textBorderColor) => update({ textBorderColor, textBorder: true })}/></CheckboxField>
+  </div>;
+}
diff --git a/src/pages/trading/drawing-settings/VisibilityTab.tsx b/src/pages/trading/drawing-settings/VisibilityTab.tsx
new file mode 100644
index 0000000..64b84d4
--- /dev/null
+++ b/src/pages/trading/drawing-settings/VisibilityTab.tsx
@@ -0,0 +1,12 @@
+import type { DrawingVisibilityUnit } from "../constants.ts";
+import type { DrawingSettingsDraft } from "../drawingSettingsModel.ts";
+import { CheckboxField, SelectField } from "./SettingsControls.tsx";
+
+const UNITS: Array<[DrawingVisibilityUnit, string]> = [["ticks","Ticks"],["seconds","Seconds"],["minutes","Minutes"],["hours","Hours"],["days","Days"],["weeks","Weeks"],["months","Months"],["ranges","Ranges"]];
+
+export function VisibilityTab({ draft, currentTf, update }: { draft: DrawingSettingsDraft; currentTf: string; update: (patch: Partial<DrawingSettingsDraft>) => void }) {
