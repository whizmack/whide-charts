+.drawing-floating-line--dotted { border-block-start-style: dotted; }
+.drawing-floating-width { grid-auto-flow: column; gap: 0.28rem; padding-inline: 0.45rem; font-size: 0.8rem; }
+.drawing-floating-width span { width: 1.2rem; border-block-start: 2px solid currentColor; }
