+
+/** Reduce pointer samples while preserving visible corners. */
+export function simplifyPath(points: Pt[], tolerance: number): Pt[] {
+  const unique = points.filter(
+    (point, index) => index === 0 || dist(point, points[index - 1]!) > 0,
+  );
+  if (unique.length <= 2) return unique;
+
+  const simplify = (start: number, end: number): Pt[] => {
+    let furthestIndex = -1;
+    let furthestDistance = tolerance;
+    for (let index = start + 1; index < end; index += 1) {
+      const distance = distToSegment(unique[index]!, unique[start]!, unique[end]!);
+      if (distance > furthestDistance) {
+        furthestDistance = distance;
+        furthestIndex = index;
+      }
+    }
+    if (furthestIndex < 0) return [unique[start]!, unique[end]!];
+    return [
+      ...simplify(start, furthestIndex).slice(0, -1),
+      ...simplify(furthestIndex, end),
+    ];
+  };
+
+  return simplify(0, unique.length - 1);
+}
+
+export function quadraticPoint(start: Pt, control: Pt, end: Pt, t: number): Pt {
+  const inverse = 1 - t;
+  return {
+    x: inverse * inverse * start.x + 2 * inverse * t * control.x + t * t * end.x,
+    y: inverse * inverse * start.y + 2 * inverse * t * control.y + t * t * end.y,
+  };
+}
+
+export function distToPolyline(point: Pt, line: Pt[]): number {
+  if (line.length === 0) return Number.POSITIVE_INFINITY;
+  if (line.length === 1) return dist(point, line[0]!);
+  let result = Number.POSITIVE_INFINITY;
+  for (let index = 1; index < line.length; index += 1) {
+    result = Math.min(result, distToSegment(point, line[index - 1]!, line[index]!));
+  }
+  return result;
+}
+
+export function distToQuadratic(point: Pt, start: Pt, control: Pt, end: Pt): number {
+  const segments = 32;
+  let previous = start;
+  let result = Number.POSITIVE_INFINITY;
+  for (let index = 1; index <= segments; index += 1) {
+    const current = quadraticPoint(start, control, end, index / segments);
+    result = Math.min(result, distToSegment(point, previous, current));
+    previous = current;
+  }
+  return result;
+}
+
+export function translateDataPoints<T extends { time: number; price: number }>(
+  points: T[],
+  timeDelta: number,
+  priceDelta: number,
+): T[] {
+  return points.map((point) => ({
+    ...point,
+    time: point.time + timeDelta,
+    price: point.price + priceDelta,
+  }));
+}
+
+export interface RangeStats {
+  priceChange: number;
+  percentChange: number;
+  bars: number;
+  durationSec: number;
+}
+
+export function rangeStats(
+  startTime: number,
+  endTime: number,
+  startPrice: number,
+  endPrice: number,
+  barTimes: number[],
+): RangeStats {
+  const priceChange = endPrice - startPrice;
+  const minTime = Math.min(startTime, endTime);
+  const maxTime = Math.max(startTime, endTime);
+  const visibleBars = barTimes.filter((time) => time >= minTime && time <= maxTime).length;
+  return {
+    priceChange,
+    percentChange: startPrice === 0 ? 0 : (priceChange / startPrice) * 100,
+    bars: Math.max(0, visibleBars - 1),
+    durationSec: maxTime - minTime,
+  };
+}
