+import { afterEach, describe, expect, it, vi } from "vitest";
+import { DrawingToolsManager } from "../lib/chart-plugins/drawing-tools/manager";
+
+const liveManagers: DrawingToolsManager[] = [];
+afterEach(() => {
+  for (const manager of liveManagers.splice(0)) manager.destroy();
+});
+
+function managerFixture() {
+  const manager = Object.create(DrawingToolsManager.prototype) as any;
+  manager.timeframe = "5m";
+  manager.intervalSec = 300;
+  manager.styleDefaults = {};
+  manager.drawings = [];
+  manager.selectedIds = [];
+  manager.placing = null;
+  manager.freehand = null;
+  manager.stayInMode = false;
+  manager.primitive = { setPreview: vi.fn(), setDrawings: vi.fn(), setSelected: vi.fn() };
+  manager.cb = { onAdd: vi.fn(), onToolFinished: vi.fn(), onSelectionChange: vi.fn() };
+  manager.applyCursor = vi.fn();
+  manager.toPoint = ({ x, y }: { x: number; y: number }) => ({ time: x, price: y });
+  manager.pointFor = (point: { x: number; y: number }) => ({ time: point.x, price: point.y });
+  return manager;
+}
+
+function liveManagerFixture() {
+  const callbacks = { onAdd: vi.fn(), onToolFinished: vi.fn(), onSelectionChange: vi.fn() };
+  const chart = {
+    timeScale: () => ({ width: () => 500, height: () => 20 }),
+    priceScale: () => ({ width: () => 0 }),
+    clearCrosshairPosition: vi.fn(),
+  };
+  const series = {
+    attachPrimitive: vi.fn(), detachPrimitive: vi.fn(),
+    subscribeDataChanged: vi.fn(), unsubscribeDataChanged: vi.fn(),
+  };
+  const container = document.createElement("div");
+  const manager = new DrawingToolsManager({
+    chart, series, container, intervalSec: 60, timeframe: "1m", callbacks,
+  } as any) as any;
+  liveManagers.push(manager);
+  manager.primitive = { setPreview: vi.fn(), setDrawings: vi.fn(), setSelected: vi.fn() };
+  manager.cb = callbacks;
+  manager.posFromClient = (x: number, y: number) => ({ x, y });
+  manager.pointFor = (point: { x: number; y: number }) => ({ time: point.x, price: point.y });
+  manager.applyCursor = vi.fn();
+  return manager;
+}
+
+describe("drawing pack placement", () => {
+  it("selects a completed drawing while stay-in-drawing-mode keeps the tool armed", () => {
+    const manager = managerFixture();
+    manager.stayInMode = true;
+    manager.tool = "trendline";
+    manager.commitDrawing({ id: "new-line", type: "trendline", time: 1, price: 10, time2: 2, price2: 20, color: "#fff" });
+    expect(manager.cb.onSelectionChange).toHaveBeenCalledWith(["new-line"]);
+    expect(manager.tool).toBe("trendline");
+  });
+
+  it("builds TradingView-like defaults for freehand and annotation tools", () => {
+    const manager = managerFixture();
+    const a = { time: 60, price: 100 };
+    const b = { time: 120, price: 110 };
+    expect(manager.buildNew("highlighter", a, b)).toMatchObject({ type: "highlighter", width: 12 });
+    expect(manager.buildNew("anchored-text", a, b)).toMatchObject({ type: "anchored-text", text: "Text" });
+    expect(manager.buildNew("note", a, b)).toMatchObject({ type: "note", text: "Note", textBg: true });
+    expect(manager.buildNew("date-price-range", a, b)).toMatchObject({
+      type: "date-price-range", time: 60, price: 100, time2: 120, price2: 110,
+    });
+  });
+
+  it("collects freehand samples and commits them on pointer release", () => {
+    const manager = managerFixture();
+    manager.tool = "brush";
+    const event = { shiftKey: false, preventDefault: vi.fn(), stopPropagation: vi.fn() };
+    manager.placementStart({ x: 10, y: 20 }, event);
+    manager.placingMove({ x: 20, y: 30 }, false);
+    manager.placingMove({ x: 30, y: 40 }, false);
+    manager.finishFreehand();
+    expect(manager.cb.onAdd).toHaveBeenCalledWith(expect.objectContaining({
+      type: "brush",
+      points: [{ time: 10, price: 20 }, { time: 30, price: 40 }],
+    }));
+  });
+
+  it("applies anchor snapping only to freehand endpoints and bounds dense samples", () => {
+    const manager = managerFixture();
+    manager.tool = "brush";
+    const pointFor = vi.fn((point: { x: number; y: number }) => ({ time: point.x, price: point.y + 1000 }));
+    const toPoint = vi.fn((point: { x: number; y: number }) => ({ time: point.x, price: point.y }));
+    manager.pointFor = pointFor;
+    manager.toPoint = toPoint;
+    const event = { shiftKey: false, preventDefault: vi.fn(), stopPropagation: vi.fn() };
+    manager.placementStart({ x: 10, y: 20 }, event);
+    for (let index = 1; index <= 1400; index += 1) {
+      manager.placingMove({ x: 10 + index * 2, y: 20 + (index % 7) }, false);
+    }
+    expect(manager.freehand.samples.length).toBeLessThanOrEqual(1024);
+    manager.finishFreehand();
+    const created = manager.cb.onAdd.mock.calls[0]![0];
+    expect(created.points.length).toBeLessThanOrEqual(512);
+    expect(created.points[0].price).toBe(1020);
+    expect(created.points.at(-1).price).toBeGreaterThan(1000);
+    expect(created.points.slice(1, -1).some((point: { price: number }) => point.price < 1000)).toBe(true);
+    expect(toPoint).toHaveBeenCalled();
+  });
+
+  it("cancels every unfinished drawing and preview on window blur", () => {
+    const manager = liveManagerFixture();
+    manager.tool = "brush";
+    manager.freehand = { samples: [{ data: { time: 1, price: 2 }, pixel: { x: 1, y: 2 } }] };
+    manager.placing = { p1: { time: 1, price: 2 }, startX: 1, startY: 2, points: [{ time: 1, price: 2 }] };
+    manager.previewing = false;
+    manager.handleBlur();
+    expect(manager.freehand).toBeNull();
+    expect(manager.placing).toBeNull();
+    expect(manager.primitive.setPreview).toHaveBeenLastCalledWith(null);
+    expect(manager.cb.onAdd).not.toHaveBeenCalled();
+  });
+
+  it("does not prematurely commit multi-click tools on touch end", () => {
+    const manager = liveManagerFixture();
+    manager.tool = "curve";
+    manager.placing = { p1: { time: 1, price: 2 }, startX: 1, startY: 2, points: [{ time: 1, price: 2 }] };
+    manager.handleTouchEnd({ changedTouches: [{ clientX: 20, clientY: 30 }] } as unknown as TouchEvent);
+    expect(manager.cb.onAdd).not.toHaveBeenCalled();
+    expect(manager.placing).not.toBeNull();
+  });
+
+  it("moves every path vertex and the curve control point with a body drag", () => {
+    const manager = managerFixture();
+    manager.shiftPoint = (x: number, y: number, dx: number, dy: number) => ({ time: x + dx, price: y + dy });
+    const path = manager.shiftDrawing(
+      { id: "p", type: "path", color: "#fff", price: 1, points: [{ time: 1, price: 2 }, { time: 3, price: 4 }] },
+      { points: [{ x: 1, y: 2 }, { x: 3, y: 4 }], x1: null, y1: null, x2: null, y2: null },
+      5,
+      6,
+    );
+    expect(path.points).toEqual([{ time: 6, price: 8 }, { time: 8, price: 10 }]);
+    expect(path).toMatchObject({ time: 6, price: 8, time2: 8, price2: 10 });
+
+    const curve = manager.shiftDrawing(
+      { id: "c", type: "curve", color: "#fff", price: 2, time: 1, price2: 4, time2: 3, controlTime: 2, controlPrice: 5 },
+      { x1: 1, y1: 2, x2: 3, y2: 4, control: { x: 2, y: 5 } },
+      5,
+      6,
+    );
+    expect(curve).toMatchObject({ time: 6, price: 8, time2: 8, price2: 10, controlTime: 7, controlPrice: 11 });
+  });
+
+  it("uses one data-space delta for every path and curve point on nonlinear scales", () => {
+    const manager = managerFixture();
+    manager.shiftPoint = vi.fn().mockReturnValue({ time: 11, price: 20 });
+    const path = manager.shiftDrawing(
+      { id: "p", type: "path", color: "#fff", time: 1, price: 2, time2: 3, price2: 4, points: [{ time: 1, price: 2 }, { time: 3, price: 4 }] },
+      { points: [{ x: 10, y: 20 }, { x: 30, y: 900 }], x1: null, y1: null, x2: null, y2: null },
+      5,
+      6,
+    );
+    expect(path.points).toEqual([{ time: 11, price: 20 }, { time: 13, price: 22 }]);
+    expect(manager.shiftPoint).toHaveBeenCalledTimes(1);
+
+    manager.shiftPoint.mockClear();
+    const curve = manager.shiftDrawing(
+      { id: "c", type: "curve", color: "#fff", time: 1, price: 2, time2: 3, price2: 4, controlTime: 2, controlPrice: 5 },
+      { x1: 10, y1: 20, x2: 30, y2: 900, control: { x: 20, y: 200 } },
+      5,
+      6,
+    );
+    expect(curve).toMatchObject({ time: 11, price: 20, time2: 13, price2: 22, controlTime: 12, controlPrice: 23 });
+    expect(manager.shiftPoint).toHaveBeenCalledTimes(1);
+  });
+});
