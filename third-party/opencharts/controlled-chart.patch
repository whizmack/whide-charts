+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { DrawingLine, DrawingType } from "../pages/trading/constants.ts";
+import { DrawingSettingsDialog } from "../pages/trading/drawing-settings/DrawingSettingsDialog.tsx";
+
+function drawing(type: DrawingType, patch: Partial<DrawingLine> = {}): DrawingLine {
+  return {
+    id: `${type}-1`,
+    type,
+    price: 100,
+    price2: 90,
+    price3: type === "channel" ? 110 : undefined,
+    time: 1_700_000_000,
+    time2: 1_700_000_060,
+    time3: type === "channel" ? 1_700_000_000 : undefined,
+    color: "#2962ff",
+    ...patch,
+  };
+}
+
+function renderDialog(value: DrawingLine) {
+  const callbacks = { onPreview: vi.fn(), onCommit: vi.fn(), onClose: vi.fn() };
+  return { ...render(
+    <DrawingSettingsDialog
+      drawing={value}
+      currentTf="5m"
+      {...callbacks}
+    />,
+  ), callbacks };
+}
+
+beforeEach(() => {
+  Object.defineProperty(HTMLDialogElement.prototype, "showModal", {
+    configurable: true,
+    value: vi.fn(function showModal(this: HTMLDialogElement) { this.open = true; }),
+  });
+  Object.defineProperty(HTMLDialogElement.prototype, "close", {
+    configurable: true,
+    value: vi.fn(function close(this: HTMLDialogElement) { this.open = false; }),
+  });
+});
+
+afterEach(() => { cleanup(); vi.restoreAllMocks(); });
+
+describe("shape settings", () => {
+  it("matches the Rectangle Style, Text, Coordinates and Visibility structure", async () => {
+    const user = userEvent.setup();
+    renderDialog(drawing("rectangle"));
+
+    expect(screen.getByRole("dialog", { name: "Rectangle settings" })).toHaveAttribute("data-drawing-type", "rectangle");
+    expect(screen.getByRole("tabpanel", { name: "Style" })).toHaveAttribute("data-drawing-tab", "style");
+    expect(screen.getByLabelText("Extend")).toBeInTheDocument();
+    expect(screen.getByLabelText("Extend")).toHaveClass("drawing-settings-value");
+    expect(screen.getByRole("group", { name: "Border" })).toBeInTheDocument();
+    expect(screen.getByRole("checkbox", { name: "Background" })).toBeChecked();
+    expect(screen.getByRole("checkbox", { name: "Background" }).nextElementSibling).toHaveClass("drawing-settings-check-mark");
+
+    await user.click(screen.getByRole("tab", { name: "Text" }));
+    expect(screen.getByRole("tabpanel", { name: "Text" })).toHaveAttribute("data-drawing-tab", "text");
+    expect(screen.getByRole("textbox", { name: "Text" })).toBeInTheDocument();
+    expect(screen.getByLabelText("Text placement")).toHaveValue("inside");
+    expect(screen.getByLabelText("Text alignment")).toHaveValue("center");
+    expect(screen.getByText("Text alignment", { selector: ".drawing-settings-field > span" })).toBeInTheDocument();
+    expect(screen.getByLabelText("Text placement").parentElement).toHaveClass("drawing-settings-inline-selects");
+
+    await user.click(screen.getByRole("tab", { name: "Coordinates" }));
+    expect(screen.getByRole("spinbutton", { name: "#1 price" })).toHaveValue(100);
+    expect(screen.getByRole("spinbutton", { name: "#1 price" })).toHaveClass("drawing-settings-value");
+    expect(screen.getByRole("spinbutton", { name: "#1 bar" })).toHaveValue(1_700_000_000);
+    expect(screen.getByRole("spinbutton", { name: "#2 price" })).toHaveValue(90);
+
+    await user.click(screen.getByRole("tab", { name: "Visibility" }));
+    expect(screen.getByRole("checkbox", { name: "Minutes" })).toBeChecked();
+    expect(screen.getByRole("checkbox", { name: "Hours" })).toBeChecked();
+    expect(screen.getByRole("checkbox", { name: "Ranges" })).toBeChecked();
+  });
+
+  it("shows a real middle-line control only for Channel", () => {
+    const { unmount } = renderDialog(drawing("rectangle"));
+    expect(screen.queryByRole("checkbox", { name: "Middle line" })).toBeNull();
+    unmount();
+    renderDialog(drawing("channel"));
+    expect(screen.getByRole("checkbox", { name: "Middle line" })).toBeInTheDocument();
+  });
+});
+
+describe("line, freehand, Fibonacci, range and text settings", () => {
+  it("shows line extension and arrow controls without shape background controls", () => {
+    renderDialog(drawing("trendline"));
+    expect(screen.getByRole("dialog", { name: "Trendline settings" })).toHaveAttribute("data-drawing-type", "trendline");
+    expect(screen.getByLabelText("Extend")).toBeInTheDocument();
+    expect(screen.getByRole("checkbox", { name: "Start arrow" })).toBeInTheDocument();
+    expect(screen.getByRole("checkbox", { name: "End arrow" })).toBeInTheDocument();
+    expect(screen.queryByRole("checkbox", { name: "Background" })).toBeNull();
+  });
+
+  it("shows freehand point count and only editable first and last anchors", async () => {
+    const user = userEvent.setup();
+    renderDialog(drawing("brush", { points: [
+      { time: 1_700_000_000, price: 100 },
+      { time: 1_700_000_030, price: 104 },
+      { time: 1_700_000_060, price: 102 },
+    ] }));
+    await user.click(screen.getByRole("tab", { name: "Coordinates" }));
+    expect(screen.getByText("3 points")).toBeInTheDocument();
+    expect(screen.getByRole("spinbutton", { name: "First point price" })).toHaveValue(100);
+    expect(screen.getByRole("spinbutton", { name: "Last point price" })).toHaveValue(102);
+    expect(screen.queryByRole("spinbutton", { name: "Point 2 price" })).toBeNull();
+  });
+
+  it("shows Fibonacci levels and range semantic colours", () => {
+    const { unmount, callbacks } = renderDialog(drawing("fibonacci", { price2: 90, time2: 1_700_000_060 }));
+    expect(screen.getByRole("group", { name: "Levels" })).toBeInTheDocument();
+    fireEvent.click(screen.getByRole("checkbox", { name: "Enable level 1" }));
+    fireEvent.change(screen.getByRole("spinbutton", { name: "Level 2 value" }), { target: { value: "0.4" } });
+    fireEvent.change(screen.getByLabelText("Level 2 color"), { target: { value: "#123456" } });
+    expect(callbacks.onPreview).toHaveBeenLastCalledWith(expect.objectContaining({
+      fibLevelStyles: expect.arrayContaining([expect.objectContaining({ value: 0.4, color: "#123456" })]),
+    }));
+    expect(screen.queryByRole("tab", { name: "Text" })).toBeNull();
+    unmount();
+    renderDialog(drawing("date-price-range"));
+    expect(screen.getByLabelText("Positive color")).toBeInTheDocument();
+    expect(screen.getByLabelText("Negative color")).toBeInTheDocument();
+    expect(screen.getByLabelText("Label mode")).toHaveValue("full");
+  });
+
+  it("uses the renderer's complete defaults for Fibonacci Extension", () => {
+    renderDialog(drawing("fibextension", { price2: 90, time2: 1_700_000_060 }));
+    expect(screen.getAllByRole("spinbutton", { name: /Level \d+ value/ }).map((input) => Number((input as HTMLInputElement).value))).toEqual([
+      0, 0.618, 1, 1.618, 2.618,
+    ]);
+  });
+
+  it("blocks OK and announces an empty Rectangle coordinate", async () => {
+    const user = userEvent.setup();
+    renderDialog(drawing("rectangle", { price2: 90, time2: 1_700_000_060 }));
+    await user.click(screen.getByRole("tab", { name: "Coordinates" }));
+    await user.clear(screen.getByRole("spinbutton", { name: "#1 price" }));
+    expect(screen.getByRole("button", { name: "OK" })).toBeDisabled();
+    expect(screen.getByRole("alert")).toHaveTextContent("Price must be a finite value");
+  });
+
+  it("opens Note on its text editor and keeps style separate", () => {
+    renderDialog(drawing("note", { text: "Review breakout" }));
+    expect(screen.getByRole("textbox", { name: "Text" })).toHaveValue("Review breakout");
+    expect(screen.getByRole("tab", { name: "Text" })).toHaveAttribute("aria-selected", "true");
+  });
+});
+
+describe("position settings", () => {
+  it("provides functional Inputs and reference Style fields without Coordinates", async () => {
+    const user = userEvent.setup();
+    renderDialog(drawing("position", { side: "long", stopPrice: 95, targetPrice: 115 }));
+
+    expect(screen.getByRole("dialog", { name: "Long Position settings" })).toBeInTheDocument();
+
+    for (const label of ["Account size", "Lot size", "Risk", "Entry price", "Leverage", "Target price", "Stop price"]) {
+      expect(screen.getByLabelText(label)).toBeInTheDocument();
+    }
+    expect(screen.getByLabelText("Risk unit")).toHaveValue("percent");
+    expect(screen.getByText("Risk/reward 3.00")).toBeInTheDocument();
+    expect(screen.queryByRole("tab", { name: "Coordinates" })).toBeNull();
+
+    await user.click(screen.getByRole("tab", { name: "Style" }));
+    expect(screen.getByLabelText("Stop color")).toBeInTheDocument();
+    expect(screen.getByLabelText("Target color")).toBeInTheDocument();
+    expect(screen.getByRole("checkbox", { name: "Price labels" })).toBeChecked();
+    expect(screen.getByLabelText("Stats")).toHaveValue("price-offsets");
+    expect(screen.getByRole("checkbox", { name: "Compact stats mode" })).not.toBeChecked();
+    expect(screen.getByRole("checkbox", { name: "Always show stats" })).not.toBeChecked();
+  });
+});
+
+describe("settings keyboard and naming", () => {
+  it("uses roving arrow-key focus across tabs and names every button", () => {
+    renderDialog(drawing("rectangle"));
+    const style = screen.getByRole("tab", { name: "Style" });
+    fireEvent.keyDown(style, { key: "ArrowRight" });
+    expect(screen.getByRole("tab", { name: "Text" })).toHaveFocus();
+    expect(screen.getByRole("tab", { name: "Text" })).toHaveAttribute("aria-selected", "true");
+
+    for (const button of screen.getAllByRole("button")) {
+      expect((button.getAttribute("aria-label") ?? button.textContent ?? "").trim()).not.toBe("");
+    }
+  });
+});
