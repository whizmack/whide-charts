@@ -0,0 +1,59 @@
+import {describe,expect,it} from 'vitest';
+import * as geometryModule from '../lib/chart-plugins/drawing-tools/geometry';
+import * as publicApiModule from '../index';
+
+type Point={x:number;y:number};
+type DataPoint={time:number;price:number};
+type GeometryApi={
+ simplifyPath?:(points:Point[],tolerance:number)=>Point[];
+ quadraticPoint?:(start:Point,control:Point,end:Point,t:number)=>Point;
+ distToPolyline?:(point:Point,line:Point[])=>number;
+ distToQuadratic?:(point:Point,start:Point,control:Point,end:Point)=>number;
+ translateDataPoints?:(points:DataPoint[],timeDelta:number,priceDelta:number)=>DataPoint[];
+ rangeStats?:(startTime:number,endTime:number,startPrice:number,endPrice:number,barTimes:number[])=>{
+  priceChange:number;percentChange:number;bars:number;durationSec:number;
+ };
+};
+type CatalogGroup={tools:Array<{tool:string;label:string}>};
+
+const geometry=geometryModule as GeometryApi;
+const publicApi=publicApiModule as typeof publicApiModule&{DRAWING_TOOL_GROUPS?:CatalogGroup[]};
+const expectedTools=['brush','highlighter','path','polyline','curve','price-range','date-range','date-price-range','anchored-text','note'];
+
+describe('drawing tool catalog',()=>{
+ it('exports every new tool exactly once for rail and future Favorites consumers',()=>{
+  const entries=publicApi.DRAWING_TOOL_GROUPS?.flatMap(group=>group.tools)??[];
+  const ids:string[]=entries.map(entry=>entry.tool);
+  expect(expectedTools.every(tool=>ids.includes(tool))).toBe(true);
+  expect(new Set(ids).size).toBe(ids.length);
+  expect(entries.filter(entry=>expectedTools.includes(entry.tool)).every(entry=>entry.label.length>0)).toBe(true);
+ });
+});
+
+describe('drawing pack geometry',()=>{
+ it('removes duplicate and redundant straight-line pointer samples deterministically',()=>{
+  expect(geometry.simplifyPath?.([{x:0,y:0},{x:0,y:0},{x:1,y:0},{x:2,y:0}],.1)).toEqual([{x:0,y:0},{x:2,y:0}]);
+ });
+
+ it('keeps a visible corner while simplifying a dense pointer path',()=>{
+  expect(geometry.simplifyPath?.([{x:0,y:0},{x:1,y:0},{x:2,y:0},{x:2,y:2},{x:2,y:3}],.25)).toEqual([{x:0,y:0},{x:2,y:0},{x:2,y:3}]);
+ });
+
+ it('resolves a quadratic midpoint and distances to polyline and curve geometry',()=>{
+  expect(geometry.quadraticPoint?.({x:0,y:0},{x:10,y:20},{x:20,y:0},.5)).toEqual({x:10,y:10});
+  expect(geometry.distToPolyline?.({x:5,y:2},[{x:0,y:0},{x:10,y:0}])).toBe(2);
+  expect(geometry.distToQuadratic?.({x:10,y:10},{x:0,y:0},{x:10,y:20},{x:20,y:0})).toBeCloseTo(0,5);
+ });
+
+ it('translates every stored data point without mutating the input',()=>{
+  const input=[{time:1,price:2},{time:4,price:8}];
+  expect(geometry.translateDataPoints?.(input,3,-1)).toEqual([{time:4,price:1},{time:7,price:7}]);
+  expect(input).toEqual([{time:1,price:2},{time:4,price:8}]);
+ });
+
+ it('derives literal ordered, reversed, and missing-bar range statistics',()=>{
+  expect(geometry.rangeStats?.(60,180,100,120,[60,120,180])).toEqual({priceChange:20,percentChange:20,bars:2,durationSec:120});
+  expect(geometry.rangeStats?.(180,60,120,100,[60,120,180])).toEqual({priceChange:-20,percentChange:-16.666666666666664,bars:2,durationSec:120});
+  expect(geometry.rangeStats?.(60,180,0,20,[])).toEqual({priceChange:20,percentChange:0,bars:0,durationSec:120});
+ });
+});
