+import { CHART_COLORS } from "../constants.ts";
+import type { ChartPreferences } from "../../../hooks/useChartPreferences.ts";
+import {
+  SettingsCheckRow,
+  SettingsColorPair,
+  SettingsSection,
+  SettingsSelectRow,
+  type SettingsTabProps,
+} from "./SettingsControls.tsx";
+
+const TIMEZONES = [
+  ["Etc/UTC", "UTC"],
+  ["Europe/Prague", "Europe/Prague"],
+  ["America/New_York", "New York"],
+  ["America/Los_Angeles", "Los Angeles"],
+  ["Asia/Tokyo", "Tokyo"],
+] as const;
+
+export function SymbolTab({ prefs, onChange }: SettingsTabProps<ChartPreferences>) {
+  const timezones = TIMEZONES.some(([value]) => value === prefs.displayTimezone)
+    ? TIMEZONES
+    : [[prefs.displayTimezone, prefs.displayTimezone], ...TIMEZONES] as const;
+  return (
+    <div className="chart-settings-fields">
+      <SettingsSection>Candles</SettingsSection>
+      <SettingsCheckRow label="Color bars based on previous close" checked={prefs.colorBarsByPreviousClose} onChange={(value) => onChange({ colorBarsByPreviousClose: value })} />
+      <SettingsCheckRow label="Wicks" checked={prefs.showWicks} onChange={(value) => onChange({ showWicks: value })} />
+      <SettingsCheckRow label="Candle borders" checked={prefs.showCandleBorders} onChange={(value) => onChange({ showCandleBorders: value })} />
+      <SettingsColorPair label="Body" bullish={prefs.candleBullBodyColor} bearish={prefs.candleBearBodyColor} bullishFallback={CHART_COLORS.dark.up} bearishFallback={CHART_COLORS.dark.down} onBullishChange={(value) => onChange({ candleBullBodyColor: value })} onBearishChange={(value) => onChange({ candleBearBodyColor: value })} />
+      <SettingsColorPair label="Borders" bullish={prefs.candleBullBorderColor} bearish={prefs.candleBearBorderColor} bullishFallback={CHART_COLORS.dark.up} bearishFallback={CHART_COLORS.dark.down} onBullishChange={(value) => onChange({ candleBullBorderColor: value })} onBearishChange={(value) => onChange({ candleBearBorderColor: value })} />
+      <SettingsColorPair label="Wick" bullish={prefs.candleBullWickColor} bearish={prefs.candleBearWickColor} bullishFallback={CHART_COLORS.dark.up} bearishFallback={CHART_COLORS.dark.down} onBullishChange={(value) => onChange({ candleBullWickColor: value })} onBearishChange={(value) => onChange({ candleBearWickColor: value })} />
+
+      <SettingsSection>Data modification</SettingsSection>
+      <SettingsSelectRow label="Precision" value={String(prefs.pricePrecision)} options={[
+        { value: "default", label: "Default" },
+        ...Array.from({ length: 9 }, (_, value) => ({ value: String(value), label: String(value) })),
+      ]} onChange={(value) => onChange({ pricePrecision: value === "default" ? "default" : Number(value) as ChartPreferences["pricePrecision"] })} />
+      <SettingsSelectRow label="Timezone" value={prefs.displayTimezone} options={timezones.map(([value, label]) => ({ value, label }))} onChange={(value) => onChange({ displayTimezone: value })} />
+    </div>
+  );
+}
