+import { cleanup, render, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, describe, expect, it } from "vitest";
+import { TradingViewColorPicker } from "../components/TradingViewColorPicker.tsx";
+
+afterEach(() => cleanup());
+
+describe("TradingViewColorPicker", () => {
+  it("renders the compact eight-row palette used by TradingView", async () => {
+    const user = userEvent.setup();
+    render(<TradingViewColorPicker label="Line color" value="#2962ff" onChange={() => undefined} />);
+
+    await user.click(screen.getByRole("button", { name: "Line color" }));
+
+    const palette = screen.getByRole("grid", { name: "Color palette" });
+    expect(within(palette).getAllByRole("row")).toHaveLength(8);
+  });
+
+  it("renders caller-provided line controls inside the color popover", async () => {
+    const user = userEvent.setup();
+    render(
+      <TradingViewColorPicker
+        label="EMA line color"
+        value="#2962ff"
+        onChange={() => undefined}
+        popoverFooter={
+          <div role="group" aria-label="EMA line options">
+            <button type="button">Thickness 2 px</button>
+            <button type="button">Dashed</button>
+          </div>
+        }
+      />,
+    );
+
+    await user.click(screen.getByRole("button", { name: "EMA line color" }));
+
+    const picker = screen.getByRole("dialog", { name: "EMA line color color picker" });
+    expect(within(picker).getByRole("group", { name: "EMA line options" })).toBeInTheDocument();
+    expect(within(picker).getByRole("button", { name: "Thickness 2 px" })).toBeInTheDocument();
+    expect(within(picker).getByRole("button", { name: "Dashed" })).toBeInTheDocument();
+  });
+});
diff --git a/src/__tests__/chart-settings-dialog.test.tsx b/src/__tests__/chart-settings-dialog.test.tsx
new file mode 100644
index 0000000..9151d2f
--- /dev/null
+++ b/src/__tests__/chart-settings-dialog.test.tsx
@@ -0,0 +1,159 @@
+import { cleanup, fireEvent, render, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { safeStorage } from "../lib/safe-storage.ts";
+import { getChartPreferencesFromStorage } from "../hooks/useChartPreferences.ts";
+import { readChartSettingsTemplates, saveChartSettingsTemplate } from "../pages/trading/chartSettingsTemplates.ts";
+import { ChartSettingsDialog } from "../pages/trading/ChartSettingsDialog.tsx";
+
+function renderSettings(onClose = vi.fn()) {
+  return {
+    onClose,
+    ...render(
+      <ChartSettingsDialog
+        open
+        onClose={onClose}
+        prefs={getChartPreferencesFromStorage()}
+        isDark
+        activePlugins={[]}
+        onOpenNewsConfig={vi.fn()}
+        hasAccount={false}
+      />,
+    ),
+  };
+}
+
+beforeEach(() => {
+  localStorage.clear();
+  Object.defineProperty(HTMLDialogElement.prototype, "showModal", {
+    configurable: true,
+    value: vi.fn(function showModal(this: HTMLDialogElement) { this.open = true; }),
+  });
+  Object.defineProperty(HTMLDialogElement.prototype, "close", {
+    configurable: true,
+    value: vi.fn(function close(this: HTMLDialogElement) { this.open = false; }),
+  });
+});
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+});
+
+describe("ChartSettingsDialog", () => {
+  it("renders the four TradingView settings tabs in reference order", () => {
+    renderSettings();
+    expect(screen.getAllByRole("tab").map((tab) => tab.textContent)).toEqual([
+      "Symbol", "Status line", "Scales and lines", "Canvas",
+    ]);
+    expect(screen.getByRole("tab", { name: "Symbol" })).toHaveAttribute("aria-selected", "true");
+    expect(screen.getByRole("button", { name: "Template" })).toBeInTheDocument();
+    expect(screen.getByRole("button", { name: "Cancel" })).toBeInTheDocument();
+    expect(screen.getByRole("button", { name: "OK" })).toBeInTheDocument();
+  });
+
+  it("lets users turn weekday labels on and off", async () => {
+    const user = userEvent.setup();
+    renderSettings();
+    await user.click(screen.getByRole("tab", { name: "Scales and lines" }));
+
+    const weekdayLabels = screen.getByRole("checkbox", { name: "Day of week on labels" });
+    expect(weekdayLabels).toBeChecked();
+    await user.click(weekdayLabels);
+    expect(weekdayLabels).not.toBeChecked();
+  });
+
+  it("lets users control overlapping price-scale labels", async () => {
+    const user = userEvent.setup();
+    renderSettings();
+    await user.click(screen.getByRole("tab", { name: "Scales and lines" }));
+
+    const noOverlappingLabels = screen.getByRole("checkbox", { name: "No overlapping labels" });
+    expect(noOverlappingLabels).toBeChecked();
+    await user.click(noOverlappingLabels);
+    expect(noOverlappingLabels).not.toBeChecked();
+  });
+
+  it("discards chart settings draft on cancel and commits once on ok", async () => {
+    const user = userEvent.setup();
+    const callbacks = renderSettings();
+    const color = screen.getByLabelText("Bullish body color");
+    fireEvent.change(color, { target: { value: "#123456" } });
+    expect(getChartPreferencesFromStorage().candleBullBodyColor).toBe("");
+    await user.click(screen.getByRole("button", { name: "Cancel" }));
+    expect(getChartPreferencesFromStorage().candleBullBodyColor).toBe("");
+    expect(callbacks.onClose).toHaveBeenCalledOnce();
+    callbacks.unmount();
+
+    const okCallbacks = renderSettings();
+    fireEvent.change(screen.getByLabelText("Bullish body color"), { target: { value: "#654321" } });
+    const write = vi.spyOn(safeStorage, "setItem");
+    await userEvent.setup().click(screen.getByRole("button", { name: "OK" }));
+    expect(write).toHaveBeenCalledTimes(1);
+    expect(getChartPreferencesFromStorage().candleBullBodyColor).toBe("#654321");
+    expect(okCallbacks.onClose).toHaveBeenCalledOnce();
+  });
+
+  it.each(["escape", "backdrop"] as const)("discards the draft on %s dismissal", async (kind) => {
+    const callbacks = renderSettings();
+    fireEvent.change(screen.getByLabelText("Bullish body color"), { target: { value: "#123456" } });
+    const dialog = screen.getByRole("dialog", { name: "Chart settings" });
+    if (kind === "escape") {
+      fireEvent(dialog, new Event("cancel", { bubbles: false, cancelable: true }));
+    } else {
+      fireEvent.click(dialog.querySelector(".chart-settings-screen")!);
+    }
+    expect(getChartPreferencesFromStorage().candleBullBodyColor).toBe("");
+    expect(callbacks.onClose).toHaveBeenCalledOnce();
+  });
+
+  it("returns focus to the settings opener when dismissed", async () => {
+    const opener = document.createElement("button");
+    opener.textContent = "Chart settings opener";
+    document.body.append(opener);
+    opener.focus();
+    renderSettings();
+
+    await userEvent.setup().click(screen.getByRole("button", { name: "Close chart settings" }));
+
+    expect(opener).toHaveFocus();
+    opener.remove();
+  });
+
+  it("reset affects only the active tab draft", async () => {
+    const user = userEvent.setup();
+    renderSettings();
+    fireEvent.change(screen.getByLabelText("Bullish body color"), { target: { value: "#123456" } });
+    await user.click(screen.getByRole("tab", { name: "Canvas" }));
+    const topMargin = screen.getByRole("spinbutton", { name: /Top/ });
+    await user.clear(topMargin);
+    await user.type(topMargin, "35");
+    await user.click(screen.getByRole("button", { name: "Template" }));
+    await user.click(screen.getByRole("menuitem", { name: "Reset current tab" }));
+    expect(topMargin).toHaveValue(20);
+    await user.click(screen.getByRole("tab", { name: "Symbol" }));
+    expect(screen.getByLabelText("Bullish body color")).toHaveValue("#123456");
+  });
+
+  it("applies, saves, replaces, and removes templates through the footer menu", async () => {
+    const user = userEvent.setup();
+    saveChartSettingsTemplate("Night", { ...getChartPreferencesFromStorage(), colorBackground: "#141920" });
+    renderSettings();
+
+    await user.click(screen.getByRole("button", { name: "Template" }));
+    await user.click(screen.getByRole("menuitem", { name: "Apply Night" }));
+    await user.click(screen.getByRole("tab", { name: "Canvas" }));
+    expect(screen.getByLabelText("Background color")).toHaveValue("#141920");
+
+    await user.click(screen.getByRole("button", { name: "Template" }));
+    const name = screen.getByRole("textbox", { name: "Template name" });
+    await user.type(name, "Night");
+    await user.click(screen.getByRole("button", { name: "Save template" }));
+    expect(readChartSettingsTemplates()).toHaveLength(1);
+
+    await user.click(screen.getByRole("button", { name: "Template" }));
+    await user.click(screen.getByRole("button", { name: "Delete Night" }));
+    expect(readChartSettingsTemplates()).toHaveLength(0);
+    expect(within(screen.getByRole("menu")).getByText("No templates yet")).toBeInTheDocument();
+  });
+});
diff --git a/src/__tests__/chart-settings-options.test.ts b/src/__tests__/chart-settings-options.test.ts
new file mode 100644
index 0000000..b455781
--- /dev/null
+++ b/src/__tests__/chart-settings-options.test.ts
@@ -0,0 +1,162 @@
+import { describe, expect, it } from "vitest";
+import {
+  LineStyle,
+  TickMarkType,
+  type TickMarkFormatter,
+  type UTCTimestamp,
+} from "lightweight-charts";
+import { getChartPreferencesFromStorage } from "../hooks/useChartPreferences.ts";
+import { CHART_COLORS } from "../pages/trading/constants.ts";
+import {
+  buildCandlestickSettingsOptions,
+  buildChartSettingsOptions,
+} from "../pages/trading/chartSettingsOptions.ts";
+
+function prefs(patch: Record<string, unknown> = {}) {
+  return { ...getChartPreferencesFromStorage(), ...patch } as ReturnType<
+    typeof getChartPreferencesFromStorage
+  >;
+}
+
+describe("chart settings option mapping", () => {
+  it("maps independent candle colors to body, border, and wick options", () => {
+    const options = buildCandlestickSettingsOptions(
+      prefs({
+        candleBullBodyColor: "#11aa88",
+        candleBearBodyColor: "#dd4455",
+        candleBullBorderColor: "#008866",
+        candleBearBorderColor: "#bb2233",
+        candleBullWickColor: "#33ccaa",
+        candleBearWickColor: "#ff6677",
+        showWicks: false,
+        showCandleBorders: false,
+        pricePrecision: 4,
+      }),
+      CHART_COLORS.dark,
+      2,
+      0.01,
+    );
+
+    expect(options).toMatchObject({
+      upColor: "#11aa88",
+      downColor: "#dd4455",
+      borderUpColor: "#008866",
+      borderDownColor: "#bb2233",
+      wickUpColor: "#33ccaa",
+      wickDownColor: "#ff6677",
+      wickVisible: false,
+      borderVisible: false,
+      priceFormat: { precision: 4, minMove: 0.0001 },
+    });
+  });
+
+  it("maps vertical and horizontal grid preferences independently", () => {
+    const options = buildChartSettingsOptions(
+      prefs({
+        showVerticalGrid: false,
+        showHorizontalGrid: true,
+        colorVerticalGrid: "#102030",
+        colorHorizontalGrid: "#405060",
+      }),
+      CHART_COLORS.dark,
+      "5m",
+    );
+
+    expect(options.grid).toMatchObject({
+      vertLines: { visible: false, color: "#102030" },
+      horzLines: { visible: true, color: "#405060" },
+    });
+  });
+
+  it("maps scale, margins, crosshair, watermark, and time formatting options", () => {
+    const options = buildChartSettingsOptions(
+      prefs({
+        displayTimezone: "America/New_York",
+        priceScaleMode: "percentage",
+        priceScaleSide: "left",
+        priceScaleTopMargin: 0.15,
+        priceScaleBottomMargin: 0.25,
+        timeScaleRightOffset: 6,
+        timeScaleTimeFormat: "12-hour",
+        watermarkMode: "symbol",
+        crosshairLineStyle: "dashed",
+        showScaleBorder: false,
+        scaleTextSize: 14,
+        showPriceScale: true,
+        showTimeScale: true,
+      }),
+      CHART_COLORS.dark,
+      "5m",
+    );
+
+    expect(options).toMatchObject({
+      leftPriceScale: {
+        visible: true,
+        mode: 2,
+        borderVisible: false,
+        scaleMargins: { top: 0.15, bottom: 0.25 },
+      },
+      rightPriceScale: { visible: false },
+      timeScale: { visible: true, rightOffset: 6 },
+      crosshair: {
+        vertLine: { color: CHART_COLORS.dark.crosshair, style: LineStyle.Dashed },
+        horzLine: { color: CHART_COLORS.dark.crosshair, style: LineStyle.Dashed },
+      },
+      watermark: { visible: true, text: "" },
+      layout: { fontSize: 14 },
+    });
+    expect(options.timeScale?.tickMarkFormatter).toBeTypeOf("function");
+  });
+
+  it("inverts only the selected price scale when requested", () => {
+    const options = buildChartSettingsOptions(
+      prefs({ priceScaleInverted: true, priceScaleSide: "left" }),
+      CHART_COLORS.dark,
+      "5m",
+    );
+
+    expect(options.leftPriceScale).toMatchObject({ invertScale: true });
+    expect(options.rightPriceScale).toMatchObject({ invertScale: false });
+  });
+
+  it("maps the no-overlapping-labels preference to both price scales", () => {
+    const options = buildChartSettingsOptions(
+      prefs({ noOverlappingLabels: false }),
+      CHART_COLORS.dark,
+      "5m",
+    );
+
+    expect(options.leftPriceScale).toMatchObject({ alignLabels: false });
+    expect(options.rightPriceScale).toMatchObject({ alignLabels: false });
+  });
+
+  it("formats axis labels in the selected timezone without changing timestamps", () => {
+    const timestamp = (Date.UTC(2026, 2, 1, 0, 30) / 1_000) as UTCTimestamp;
+    const options = buildChartSettingsOptions(
+      prefs({ displayTimezone: "America/New_York", timeScaleTimeFormat: "24-hour" }),
+      CHART_COLORS.dark,
+      "5m",
+    );
+    const formatter = options.timeScale?.tickMarkFormatter as TickMarkFormatter | undefined;
+
+    expect(formatter?.(timestamp, TickMarkType.Time, "en-US")).toBe("19:30");
+    expect(timestamp).toBe(Date.UTC(2026, 2, 1, 0, 30) / 1_000);
+  });
+
+  it("adds the selected weekday to day-of-month labels without changing timestamps", () => {
+    const timestamp = (Date.UTC(2026, 2, 1, 0, 30) / 1_000) as UTCTimestamp;
+    const options = buildChartSettingsOptions(
+      prefs({
+        displayTimezone: "America/New_York",
+        timeScaleDateFormat: "locale",
+        timeScaleShowDayOfWeek: true,
+      }),
+      CHART_COLORS.dark,
+      "5m",
+    );
+    const formatter = options.timeScale?.tickMarkFormatter as TickMarkFormatter | undefined;
+
+    expect(formatter?.(timestamp, TickMarkType.DayOfMonth, "en-US")).toBe("Sat, Feb 28, 2026");
+    expect(timestamp).toBe(Date.UTC(2026, 2, 1, 0, 30) / 1_000);
+  });
+});
