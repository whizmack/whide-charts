+import { beforeEach, describe, expect, it } from "vitest";
+import { getChartPreferencesFromStorage } from "../hooks/useChartPreferences.ts";
+import { useAuthStore } from "../services/store.tsx";
+
+function storePrefs(prefs: Record<string, unknown>): void {
+  localStorage.setItem("trader_prefs", JSON.stringify(prefs));
+}
+
+describe("chart settings preference migration", () => {
+  beforeEach(() => {
+    localStorage.clear();
+    useAuthStore.setState((state) => ({ ...state, user: null }));
+  });
+
+  it("migrates legacy candle colors and combined grid settings", () => {
+    storePrefs({
+      candleUpColor: "#118877",
+      candleDownColor: "#cc3344",
+      showGrid: "false",
+    });
+
+    expect(getChartPreferencesFromStorage()).toMatchObject({
+      candleBullBodyColor: "#118877",
+      candleBullBorderColor: "#118877",
+      candleBullWickColor: "#118877",
+      candleBearBodyColor: "#cc3344",
+      candleBearBorderColor: "#cc3344",
+      candleBearWickColor: "#cc3344",
+      showVerticalGrid: false,
+      showHorizontalGrid: false,
+    });
+  });
+
+  it("uses safe defaults for absent or malformed settings", () => {
+    storePrefs({
+      candleBullBodyColor: "javascript:alert(1)",
+      displayTimezone: "Not/A_Timezone",
+      pricePrecision: "-100",
+      priceScaleMode: "untrusted-mode",
+      priceScaleSide: "center",
+      scaleTextSize: "900",
+      showVerticalGrid: "sometimes",
+      timeScaleSecondsVisible: "sometimes",
+      watermarkMode: "unsupported",
+      timeScaleRightOffset: "99999",
+    });
+
+    expect(getChartPreferencesFromStorage()).toMatchObject({
+      candleBullBodyColor: "",
+      candleBearBodyColor: "",
+      candleBullBorderColor: "",
+      candleBearBorderColor: "",
+      candleBullWickColor: "",
+      candleBearWickColor: "",
+      colorBarsByPreviousClose: false,
+      displayTimezone: "Etc/UTC",
+      pricePrecision: "default",
+      priceScaleMode: "normal",
+      priceScaleSide: "right",
+      showPriceScale: true,
+      showTimeScale: true,
+      showPriceLine: true,
+      showLastValue: true,
+      priceScaleTopMargin: 0.2,
+      priceScaleBottomMargin: 0.1,
+      timeScaleDateFormat: "locale",
+      timeScaleTimeFormat: "24-hour",
+      timeScaleSecondsVisible: "auto",
+      timeScaleRightOffset: "default",
+      watermarkMode: "symbol",
+      crosshairLineStyle: "large-dashed",
+      chartBackgroundMode: "solid",
+      scaleTextSize: 12,
+      showScaleBorder: true,
+      enableChartScroll: true,
+      enableChartScale: true,
+      showVerticalGrid: true,
+      showHorizontalGrid: true,
+      colorVerticalGrid: "",
+      colorHorizontalGrid: "",
+      showStatusLineSymbol: true,
+      showStatusLineMarketState: false,
+      showStatusLineChange: true,
+      showStatusLineVolume: true,
+      showStatusLineStudyTitle: true,
+      showStatusLineStudyInputs: true,
+      showStatusLineStudyValues: true,
+      showStatusLineStudyBackground: true,
+    });
+  });
+
+  it("defaults weekday labels on and honors a stored preference", () => {
+    expect(getChartPreferencesFromStorage().timeScaleShowDayOfWeek).toBe(true);
+
+    storePrefs({ timeScaleShowDayOfWeek: "false" });
+
+    expect(getChartPreferencesFromStorage().timeScaleShowDayOfWeek).toBe(false);
+  });
+
+  it("defaults price scale inversion off and honors a stored preference", () => {
+    expect(getChartPreferencesFromStorage().priceScaleInverted).toBe(false);
+
+    storePrefs({ priceScaleInverted: "true" });
+
+    expect(getChartPreferencesFromStorage().priceScaleInverted).toBe(true);
+  });
+
+  it("defaults to preventing overlapping labels and honors a stored preference", () => {
+    expect(getChartPreferencesFromStorage().noOverlappingLabels).toBe(true);
+
+    storePrefs({ noOverlappingLabels: "false" });
+
+    expect(getChartPreferencesFromStorage().noOverlappingLabels).toBe(false);
+  });
+});
