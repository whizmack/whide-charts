+.tv-color-trigger {
+  display: inline-flex;
+  min-width: 42px;
+  height: 27px;
+  align-items: center;
+  justify-content: center;
+  gap: 5px;
+  padding: 3px 5px;
+  border: 1px solid #3b3d43;
+  border-radius: 3px;
+  background: #17181b;
+  color: #aeb0b7;
+  cursor: pointer;
+}
+.tv-color-trigger:hover,
+.tv-color-trigger[aria-expanded="true"] { border-color: #666970; background: #202125; }
+.tv-color-trigger:focus-visible { outline: 2px solid #76a6f5; outline-offset: 2px; }
+.tv-color-trigger__swatch {
+  width: 18px;
+  height: 17px;
+  border: 1px solid rgb(255 255 255 / 24%);
+  border-radius: 2px;
+  background-color: #242528;
+  background-image: linear-gradient(var(--picker-current-color), var(--picker-current-color)), repeating-conic-gradient(#4a4c50 0% 25%, #242528 0% 50%);
+  background-size: 100% 100%, 8px 8px;
+}
+
+.tv-color-trigger__chevron { font-size: 9px; line-height: 1; color: #8a8d94; }
+
+.tv-color-picker {
+  position: fixed;
+  z-index: 2147483002;
+  width: min(500px, calc(100vw - 16px));
+  max-height: calc(100dvh - 16px);
+  overflow: auto;
+  padding: 24px;
+  border: 1px solid #1e2024;
+  border-radius: 9px;
+  background: #131416;
+  box-shadow: 0 8px 26px rgb(0 0 0 / 48%), 0 1px 3px rgb(0 0 0 / 55%);
+  color: #d1d2d5;
+  font: 13px/1.35 Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  font-variant-numeric: tabular-nums;
+}
+.tv-color-picker__palette { display: grid; gap: 11px; }
+.tv-color-picker__gridcell { min-width: 0; }
+.tv-color-picker__row {
+  display: grid;
+  grid-template-columns: repeat(10, minmax(0, 1fr));
+  gap: 11px;
+}
+.tv-color-picker__swatch,
+.tv-color-picker__recent-swatch {
+  position: relative;
+  min-width: 0;
+  aspect-ratio: 1;
+  border: 0;
+  border-radius: 3px;
+  padding: 0;
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 8%);
+  cursor: pointer;
+}
+.tv-color-picker__swatch { display: block; width: 100%; height: auto; min-height: 0; }
+
+.tv-color-picker__swatch:hover,
+.tv-color-picker__recent-swatch:hover { filter: brightness(1.16); }
+.tv-color-picker__swatch.is-selected::after {
+  position: absolute;
+  inset: -5px;
+  border: 3px solid #aeb1b7;
+  border-radius: 8px;
+  box-shadow: 0 0 0 2px #131416;
+  content: "";
+  pointer-events: none;
+}
+.tv-color-picker__swatch:focus-visible,
+.tv-color-picker__recent-swatch:focus-visible,
+.tv-color-picker__custom:focus-visible {
+  outline: 2px solid #d4d5d8;
+  outline-offset: 3px;
+  z-index: 1;
+}
+.tv-color-picker__recent {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin-top: 30px;
+  padding-top: 30px;
+  border-top: 1px solid #4b4d52;
+}
+.tv-color-picker__recent-swatch { width: 34px; height: 34px; min-height: 34px; flex: 0 0 34px; }
+.tv-color-picker__recent-swatch--current {
+  background-color: #292b30;
+  background-image: linear-gradient(var(--picker-current-color), var(--picker-current-color)), repeating-conic-gradient(#55585e 0% 25%, #292b30 0% 50%);
+  background-size: 100% 100%, 8px 8px;
+}
+.tv-color-picker__custom {
+  display: grid;
+  width: 34px;
+  height: 34px;
+  min-height: 34px;
+  flex: 0 0 34px;
+  place-items: center;
+  border: 0;
+  background: transparent;
+  color: #d1d2d5;
+  cursor: pointer;
+}
+.tv-color-picker__custom span { font: 300 32px/1 Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
+.tv-color-picker__native-input { position: fixed; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
+.tv-color-picker__opacity { margin-top: 26px; }
+.tv-color-picker__opacity > label { display: block; margin-bottom: 9px; color: #898c92; font-size: 18px; }
+.tv-color-picker__opacity-row { display: flex; align-items: center; gap: 17px; }
+.tv-color-picker__opacity-row > input[type="range"] {
+  width: 100%;
+  height: 20px;
+  min-width: 0;
+  flex: 1;
+  appearance: none;
+  border: 1px solid #0a8f7b;
+  border-radius: 12px;
+  padding: 0;
+  background-color: #25272a;
+  background-image: linear-gradient(to right, transparent, var(--picker-color)), repeating-conic-gradient(#42454a 0% 25%, #292b30 0% 50%);
+  background-position: 0 0, center;
+  background-size: 100% 100%, 8px 8px;
+  cursor: pointer;
+}
+.tv-color-picker__opacity-row > input[type="range"]::-webkit-slider-thumb {
+  width: 22px;
+  height: 22px;
+  appearance: none;
+  border: 3px solid #fff;
+  border-radius: 50%;
+  background: #141517;
+  box-shadow: 0 0 0 1px #18191c;
+}
+.tv-color-picker__opacity-row > input[type="range"]::-moz-range-thumb {
+  width: 16px;
+  height: 16px;
+  border: 3px solid #fff;
+  border-radius: 50%;
+  background: #141517;
+  box-shadow: 0 0 0 1px #18191c;
+}
+.tv-color-picker__percentage {
+  display: flex;
+  height: 42px;
+  flex: 0 0 94px;
+  align-items: center;
+  justify-content: center;
+  gap: 2px;
+  border: 1px solid #55585e;
+  border-radius: 8px;
+  color: #d3d4d7;
+  font-size: 16px;
+}
+.tv-color-picker__percentage input {
+  width: 3.1ch;
+  min-width: 0;
+  border: 0;
+  padding: 0;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  text-align: right;
+  outline: 0;
+  appearance: textfield;
+}
+.tv-color-picker__percentage input::-webkit-inner-spin-button,
+.tv-color-picker__percentage input::-webkit-outer-spin-button { appearance: none; margin: 0; }
+.tv-color-picker__percentage:focus-within { border-color: #8a8d94; }
+.tv-color-picker__state { position: absolute; width: 0; height: 0; overflow: hidden; }
+@media (max-width: 520px) {
+  .tv-color-picker { padding: 16px; }
+  .tv-color-picker__row { gap: 6px; }
+  .tv-color-picker__palette { gap: 7px; }
+  .tv-color-picker__recent { gap: 7px; margin-top: 20px; padding-top: 20px; }
+  .tv-color-picker__recent-swatch,
+  .tv-color-picker__custom { width: 28px; height: 28px; min-height: 28px; flex-basis: 28px; }
+  .tv-color-picker__opacity > label { font-size: 15px; }
+}
