+import { describe, expect, it } from "vitest";
+import type { DrawingLine, DrawingType } from "../pages/trading/constants.ts";
+import { pickStyle } from "../pages/trading/drawingStyles.ts";
+import {
+  isDrawingVisibleOnTimeframe,
+  normalizeDrawingSettings,
+  positionMetrics,
+  settingsTabsFor,
+  validateDrawingSettings,
+} from "../pages/trading/drawingSettingsModel.ts";
+
+function drawing(type: DrawingType, patch: Partial<DrawingLine> = {}): DrawingLine {
+  return {
+    id: `${type}-1`,
+    type,
+    price: 100,
+    time: 1_700_000_000,
+    color: "#2962ff",
+    ...patch,
+  };
+}
+
+describe("drawing settings normalization", () => {
+  it("gives a legacy rectangle the reference-compatible visual defaults", () => {
+    const draft = normalizeDrawingSettings(
+      drawing("rectangle", { price2: 90, time2: 1_700_000_060 }),
+    );
+
+    expect(draft).toMatchObject({
+      opacity: 1,
+      fillColor: "#2962ff",
+      fillOpacity: 0.14,
+      textAlign: "center",
+      textPlacement: "inside",
+      visibility: "all",
+    });
+  });
+
+  it("gives a legacy position safe drawing-only risk defaults", () => {
+    const draft = normalizeDrawingSettings(
+      drawing("position", { side: "long", stopPrice: 95, targetPrice: 115 }),
+    );
+
+    expect(draft).toMatchObject({
+      accountSize: 1_000,
+      lotSize: 1,
+      leverage: 1,
+      riskValue: 1,
+      riskUnit: "percent",
+      quantityPrecision: "default",
+      stopColor: "#f23645",
+      targetColor: "#089981",
+      labelColor: "#ffffff",
+      showPriceLabels: true,
+      statsMode: "price-offsets",
+      compactStats: false,
+      alwaysShowStats: false,
+    });
+  });
+});
+
+describe("drawing interval visibility", () => {
+  it("combines exact-timeframe scope with interval-family rules", () => {
+    const scoped = drawing("rectangle", {
+      createdTf: "5m",
+      visibility: "tf",
+      visibilityRules: {
+        ticks: true,
+        seconds: true,
+        minutes: true,
+        hours: true,
+        days: true,
+        weeks: true,
+        months: true,
+        ranges: true,
+      },
+    });
+
+    expect(isDrawingVisibleOnTimeframe(scoped, "5m")).toBe(true);
+    expect(isDrawingVisibleOnTimeframe(scoped, "15m")).toBe(false);
+  });
+
+  it.each([
+    ["1m", "minutes"],
+    ["4h", "hours"],
+    ["1D", "days"],
+    ["1W", "weeks"],
+    ["1M", "months"],
+    ["10s", "seconds"],
+    ["100T", "ticks"],
+    ["10R", "ranges"],
+  ] as const)("maps %s to the %s visibility family", (timeframe, disabledFamily) => {
+    const visibilityRules = {
+      ticks: true,
+      seconds: true,
+      minutes: true,
+      hours: true,
+      days: true,
+      weeks: true,
+      months: true,
+      ranges: true,
+      [disabledFamily]: false,
+    };
+
+    expect(isDrawingVisibleOnTimeframe(drawing("trendline", { visibilityRules }), timeframe)).toBe(false);
+  });
+
+  it("keeps legacy drawings visible on every interval", () => {
+    expect(isDrawingVisibleOnTimeframe(drawing("trendline"), "4h")).toBe(true);
+  });
+});
+
+describe("drawing settings tab matrix", () => {
+  it.each([
+    ["trendline", ["style", "text", "coordinates", "visibility"]],
+    ["brush", ["style", "text", "coordinates", "visibility"]],
+    ["curve", ["style", "text", "coordinates", "visibility"]],
+    ["rectangle", ["style", "text", "coordinates", "visibility"]],
+    ["channel", ["style", "text", "coordinates", "visibility"]],
+    ["fibonacci", ["style", "coordinates", "visibility"]],
+    ["price-range", ["style", "coordinates", "visibility"]],
+    ["text", ["text", "style", "coordinates", "visibility"]],
+    ["note", ["text", "style", "coordinates", "visibility"]],
+    ["position", ["inputs", "style", "visibility"]],
+  ] satisfies Array<[DrawingType, string[]]>)
+  ("returns contextual tabs for %s", (type, expected) => {
+    expect(settingsTabsFor(type)).toEqual(expected);
+  });
+});
+
+describe("position settings metrics", () => {
+  it("derives finite long-position size, target and stop values from anchors", () => {
+    const draft = normalizeDrawingSettings(
+      drawing("position", {
+        side: "long",
+        price: 100,
+        stopPrice: 95,
+        targetPrice: 115,
+        accountSize: 10_000,
+        riskValue: 2,
+        riskUnit: "percent",
+        lotSize: 1,
+        leverage: 10,
+        tickSize: 0.1,
+      }),
+    );
+
+    expect(positionMetrics(draft)).toEqual({
+      riskAmount: 200,
+      quantity: 40,
+      notional: 4_000,
+      margin: 400,
+      targetAmount: 600,
+      targetDistance: 15,
+      targetPercent: 15,
+      targetTicks: 150,
+      stopAmount: 200,
+      stopDistance: 5,
+      stopPercent: 5,
+      stopTicks: 50,
+      riskReward: 3,
+    });
+  });
+
+  it("uses short direction and fixed-currency risk without changing geometry", () => {
+    const draft = normalizeDrawingSettings(
+      drawing("position", {
+        side: "short",
+        price: 200,
+        stopPrice: 210,
+        targetPrice: 170,
+        accountSize: 5_000,
+        riskValue: 125,
+        riskUnit: "currency",
+        lotSize: 1,
+        leverage: 5,
+        tickSize: 0.5,
+      }),
+    );
+
+    expect(positionMetrics(draft)).toMatchObject({
+      riskAmount: 125,
+      quantity: 12.5,
+      targetTicks: 60,
+      stopTicks: 20,
+      targetPercent: 15,
+      stopPercent: 5,
+      riskReward: 3,
+    });
+  });
+});
+
+describe("position settings validation", () => {
+  it.each([
+    ["accountSize", 0, "Account size must be greater than 0"],
+    ["lotSize", -1, "Lot size must be greater than 0"],
+    ["leverage", Number.POSITIVE_INFINITY, "Leverage must be a finite value greater than 0"],
+    ["riskValue", 0, "Risk must be greater than 0"],
+  ] as const)("rejects invalid %s", (field, value, message) => {
+    const draft = normalizeDrawingSettings(
+      drawing("position", { side: "long", stopPrice: 95, targetPrice: 115 }),
+    );
+    const errors = validateDrawingSettings({ ...draft, [field]: value });
+    expect(errors[field]).toBe(message);
+  });
+
+  it.each([
+    ["long", 105, 115, "Stop must be below entry for a long position"],
+    ["long", 95, 90, "Target must be above entry for a long position"],
+    ["short", 95, 70, "Stop must be above entry for a short position"],
+    ["short", 210, 220, "Target must be below entry for a short position"],
+  ] as const)("validates %s stop and target ordering", (side, stopPrice, targetPrice, message) => {
+    const draft = normalizeDrawingSettings(
+      drawing("position", { side, stopPrice, targetPrice }),
+    );
+    expect(Object.values(validateDrawingSettings(draft))).toContain(message);
+  });
+});
+
+describe("coordinate settings validation", () => {
+  it.each([
+    ["rectangle anchor", drawing("rectangle", { price2: Number.NaN, time2: 1_700_000_060 }), "price2"],
+    ["freehand point", drawing("brush", { points: [{ time: 1_700_000_000, price: Number.NaN }] }), "points"],
+    ["curve control", drawing("curve", { price2: 90, time2: 1_700_000_060, controlPrice: Number.NaN, controlTime: 1_700_000_030 }), "controlPrice"],
+  ] as const)("rejects a non-finite %s", (_name, value, field) => {
+    const errors = validateDrawingSettings(normalizeDrawingSettings(value));
+    expect(errors[field]).toBeTruthy();
+  });
+
+  it("rejects a temporarily empty Fibonacci level", () => {
+    const draft = normalizeDrawingSettings(drawing("fibonacci", {
+      price2: 90,
+      time2: 1_700_000_060,
+      fibLevelStyles: [{ value: Number.NaN, enabled: true, color: "#ff0000" }],
+    }));
+    expect(validateDrawingSettings(draft).fibLevelStyles).toBe("Fibonacci level values must be finite");
+  });
+});
+
+describe("drawing style templates", () => {
+  it("keeps visual fields and excludes geometry, visibility and risk metadata", () => {
+    const style = pickStyle(
+      drawing("position", {
+        price2: 110,
+        time2: 1_700_000_060,
+        opacity: 0.8,
+        fillColor: "#112233",
+        fillOpacity: 0.2,
+        textAlign: "right",
+        textPlacement: "inside",
+        stopColor: "#aa0000",
+        targetColor: "#00aa88",
+        labelColor: "#f5f5f5",
+        showPriceLabels: false,
+        statsMode: "risk-reward",
+        compactStats: true,
+        alwaysShowStats: true,
+        visibility: "tf",
+        createdTf: "5m",
+        accountSize: 50_000,
+        riskValue: 500,
+        leverage: 20,
+      }),
+    );
+
+    expect(style).toMatchObject({
+      opacity: 0.8,
+      fillColor: "#112233",
+      fillOpacity: 0.2,
+      textAlign: "right",
+      textPlacement: "inside",
+      stopColor: "#aa0000",
+      targetColor: "#00aa88",
+      labelColor: "#f5f5f5",
+      showPriceLabels: false,
+      statsMode: "risk-reward",
+      compactStats: true,
+      alwaysShowStats: true,
+    });
+    expect(style).not.toHaveProperty("price");
+    expect(style).not.toHaveProperty("time");
+    expect(style).not.toHaveProperty("visibility");
+    expect(style).not.toHaveProperty("accountSize");
+    expect(style).not.toHaveProperty("riskValue");
+    expect(style).not.toHaveProperty("leverage");
+  });
+});
