diff --git a/src/pages/trading/chartSettingsOptions.ts b/src/pages/trading/chartSettingsOptions.ts
new file mode 100644
index 0000000..45a05ab
--- /dev/null
+++ b/src/pages/trading/chartSettingsOptions.ts
@@ -0,0 +1,268 @@
+import {
+  ColorType,
+  LineStyle,
+  PriceScaleMode,
+  TickMarkType,
+  type CandlestickSeriesOptions,
+  type ChartOptions,
+  type DeepPartial,
+  type Time,
+  type TickMarkFormatter,
+} from "lightweight-charts";
+import type {
+  ChartColors,
+  Timeframe,
+} from "./constants.ts";
+import { CHART_SETTINGS_DEFAULTS } from "./constants.ts";
+import type { ChartPreferences } from "../../hooks/useChartPreferences.ts";
+
+const DEFAULT_TIMEZONE = "Etc/UTC";
+
+function validTimezone(input: string): string {
+  try {
+    new Intl.DateTimeFormat("en", { timeZone: input });
+    return input;
+  } catch {
+    return DEFAULT_TIMEZONE;
+  }
+}
+
+function dateForChartTime(time: Time): Date | null {
+  if (typeof time === "number") {
+    const date = new Date(time * 1_000);
+    return Number.isNaN(date.getTime()) ? null : date;
+  }
+
+  if (typeof time === "string") {
+    const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(time);
+    if (!match) return null;
+    return new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])));
+  }
+
+  return new Date(Date.UTC(time.year, time.month - 1, time.day));
+}
+
+function dateParts(date: Date, timezone: string, locale: string, showWeekday: boolean): Record<string, string> {
+  return Object.fromEntries(
+    new Intl.DateTimeFormat(locale, {
+      timeZone: timezone,
+      year: "numeric",
+      month: "short",
+      day: "2-digit",
+      ...(showWeekday ? { weekday: "short" as const } : {}),
+    })
+      .formatToParts(date)
+      .map(({ type, value }) => [type, value]),
+  );
+}
+
+export function formatChartTimeLabel(
+  time: Time,
+  timezone: string,
+  timeFormat: ChartPreferences["timeScaleTimeFormat"],
+  dateFormat: ChartPreferences["timeScaleDateFormat"],
+  locale: string,
+  tickMarkType: TickMarkType,
+  showDayOfWeek = false,
+): string {
+  const date = dateForChartTime(time);
+  if (!date) return "";
+  const resolvedTimezone = validTimezone(timezone);
+
+  if (tickMarkType === TickMarkType.Year) {
+    return new Intl.DateTimeFormat(locale, { timeZone: resolvedTimezone, year: "numeric" }).format(date);
+  }
+  if (tickMarkType === TickMarkType.Month) {
+    return new Intl.DateTimeFormat(locale, { timeZone: resolvedTimezone, month: "short" }).format(date);
+  }
+  if (tickMarkType === TickMarkType.Time || tickMarkType === TickMarkType.TimeWithSeconds) {
+    const use12HourClock = timeFormat === "12-hour";
+    return new Intl.DateTimeFormat(locale, {
+      timeZone: resolvedTimezone,
+      hour: "numeric",
+      minute: "2-digit",
+      ...(tickMarkType === TickMarkType.TimeWithSeconds ? { second: "2-digit" as const } : {}),
+      hourCycle: use12HourClock ? "h12" : "h23",
+    }).format(date);
+  }
+
+  const prefix = showDayOfWeek && tickMarkType === TickMarkType.DayOfMonth;
+
+  if (dateFormat === "locale") {
+    return new Intl.DateTimeFormat(locale, {
+      timeZone: resolvedTimezone,
+      year: "numeric",
+      month: "short",
+      day: "2-digit",
+      ...(prefix ? { weekday: "short" as const } : {}),
+    }).format(date);
+  }
+  const parts = dateParts(date, resolvedTimezone, locale, prefix);
+  const formattedDate =
+    dateFormat === "yyyy-MM-dd"
+      ? `${parts.year}-${parts.month}-${parts.day}`
+      : dateFormat === "dd MMM yyyy"
+        ? `${parts.day} ${parts.month} ${parts.year}`
+        : `${parts.month} ${parts.day}, ${parts.year}`;
+  return prefix ? `${parts.weekday}, ${formattedDate}` : formattedDate;
+}
+
+function mapPriceScaleMode(mode: ChartPreferences["priceScaleMode"]): PriceScaleMode {
+  switch (mode) {
+    case "logarithmic":
+      return PriceScaleMode.Logarithmic;
+    case "percentage":
+      return PriceScaleMode.Percentage;
+    case "indexedTo100":
+      return PriceScaleMode.IndexedTo100;
+    default:
+      return PriceScaleMode.Normal;
+  }
+}
+
+function mapCrosshairLineStyle(style: ChartPreferences["crosshairLineStyle"]): LineStyle {
+  switch (style) {
+    case "solid":
+      return LineStyle.Solid;
+    case "dotted":
+      return LineStyle.Dotted;
+    case "dashed":
+      return LineStyle.Dashed;
+    default:
+      return LineStyle.LargeDashed;
+  }
+}
+
+function boundedMargin(value: number): number {
+  return Number.isFinite(value) ? Math.min(0.45, Math.max(0, value)) : 0.2;
+}
+
+export function buildChartSettingsOptions(
+  prefs: ChartPreferences,
+  colors: ChartColors,
+  timeframe: Timeframe,
+): DeepPartial<ChartOptions> {
+  const timezone = validTimezone(prefs.displayTimezone);
+  const lineStyle = mapCrosshairLineStyle(prefs.crosshairLineStyle);
+  const rightOffset =
+    prefs.timeScaleRightOffset === "default"
+      ? timeframe === "1m"
+        ? CHART_SETTINGS_DEFAULTS.oneMinuteRightOffset
+        : CHART_SETTINGS_DEFAULTS.rightOffset
+      : prefs.timeScaleRightOffset;
+  const secondsVisible =
+    prefs.timeScaleSecondsVisible === "auto"
+      ? timeframe === "1m"
+      : prefs.timeScaleSecondsVisible;
+  const tickMarkFormatter: TickMarkFormatter = (time, tickMarkType, locale) =>
+    formatChartTimeLabel(
+      time,
+      timezone,
+      prefs.timeScaleTimeFormat,
+      prefs.timeScaleDateFormat,
+      locale,
+      tickMarkType,
+      prefs.timeScaleShowDayOfWeek,
+    );
+  const chartBackground =
+    prefs.chartBackgroundMode === "transparent"
+      ? "rgba(0, 0, 0, 0)"
+      : prefs.colorBackground || colors.background;
+  const sideVisible = prefs.showPriceScale;
+  const selectedMode = mapPriceScaleMode(prefs.priceScaleMode);
+  const scaleMargins = {
+    top: boundedMargin(prefs.priceScaleTopMargin),
+    bottom: boundedMargin(prefs.priceScaleBottomMargin),
+  };
+
+  return {
+    layout: {
+      background: { type: ColorType.Solid, color: chartBackground },
+      textColor: prefs.colorScaleText || colors.text,
+      fontSize: prefs.scaleTextSize,
+    },
+    grid: {
+      vertLines: {
+        visible: prefs.showVerticalGrid,
+        color: prefs.colorVerticalGrid || colors.grid,
+      },
+      horzLines: {
+        visible: prefs.showHorizontalGrid,
+        color: prefs.colorHorizontalGrid || colors.grid,
+      },
+    },
+    leftPriceScale: {
+      visible: sideVisible && prefs.priceScaleSide === "left",
+      mode: selectedMode,
+      invertScale: prefs.priceScaleInverted && prefs.priceScaleSide === "left",
+      alignLabels: prefs.noOverlappingLabels,
+      borderVisible: prefs.showScaleBorder,
+      borderColor: prefs.colorGrid || colors.grid,
+      textColor: prefs.colorScaleText || colors.text,
+      scaleMargins,
+    },
+    rightPriceScale: {
+      visible: sideVisible && prefs.priceScaleSide === "right",
+      mode: selectedMode,
+      invertScale: prefs.priceScaleInverted && prefs.priceScaleSide === "right",
+      alignLabels: prefs.noOverlappingLabels,
+      borderVisible: prefs.showScaleBorder,
+      borderColor: prefs.colorGrid || colors.grid,
+      textColor: prefs.colorScaleText || colors.text,
+      scaleMargins,
+    },
+    timeScale: {
+      visible: prefs.showTimeScale,
+      rightOffset,
+      secondsVisible,
+      tickMarkFormatter,
+    },
+    localization: {
+      timeFormatter: (time: Time) =>
+        formatChartTimeLabel(
+          time,
+          timezone,
+          prefs.timeScaleTimeFormat,
+          prefs.timeScaleDateFormat,
+          typeof navigator === "undefined" ? "en-US" : navigator.language || "en-US",
+          TickMarkType.Time,
+        ),
+    },
+    crosshair: {
+      vertLine: { color: prefs.colorCrosshair || colors.crosshair, labelBackgroundColor: prefs.colorCrosshair || colors.crosshair, style: lineStyle },
+      horzLine: { color: prefs.colorCrosshair || colors.crosshair, labelBackgroundColor: prefs.colorCrosshair || colors.crosshair, style: lineStyle },
+    },
+    watermark: {
+      visible: prefs.watermarkMode !== "none",
+      text: "",
+      color: colors.watermark,
+    },
+    handleScroll: prefs.enableChartScroll,
+    handleScale: prefs.enableChartScale,
+  };
+}
+
+export function buildCandlestickSettingsOptions(
+  prefs: ChartPreferences,
+  colors: ChartColors,
+  pipDigits: number,
+  minMove: number,
+): DeepPartial<CandlestickSeriesOptions> {
+  const precision = prefs.pricePrecision === "default" ? pipDigits : prefs.pricePrecision;
+  const computedMinMove = prefs.pricePrecision === "default" ? minMove : 10 ** -precision;
+
+  return {
+    upColor: prefs.candleBullBodyColor || colors.up,
+    downColor: prefs.candleBearBodyColor || colors.down,
+    borderUpColor: prefs.candleBullBorderColor || colors.up,
+    borderDownColor: prefs.candleBearBorderColor || colors.down,
+    wickUpColor: prefs.candleBullWickColor || colors.up,
+    wickDownColor: prefs.candleBearWickColor || colors.down,
+    wickVisible: prefs.showWicks,
+    borderVisible: prefs.showCandleBorders,
+    priceLineVisible: prefs.showPriceLine,
+    lastValueVisible: prefs.showLastValue,
+    priceScaleId: prefs.priceScaleSide,
+    priceFormat: { type: "price", precision, minMove: computedMinMove },
+  };
+}
