diff --git a/src/components/TradingViewColorPicker.tsx b/src/components/TradingViewColorPicker.tsx
new file mode 100644
index 0000000..e3c7675
--- /dev/null
+++ b/src/components/TradingViewColorPicker.tsx
@@ -0,0 +1,351 @@
+import { useEffect, useId, useLayoutEffect, useRef, useState, type ReactNode } from "react";
+import { createPortal } from "react-dom";
+
+export interface TradingViewColorPickerProps {
+  label: string;
+  value: string;
+  onChange: (value: string) => void;
+  name?: string;
+  opacity?: number;
+  onOpacity?: (opacity: number) => void;
+  className?: string;
+  popoverFooter?: ReactNode;
+}
+
+type ParsedColor = { hex: string; opacity: number };
+
+const BASE_COLORS = [
+  "#f23645", "#ff9800", "#ffeb3b", "#4caf50", "#089981",
+  "#00bcd4", "#2962ff", "#673ab7", "#9c27b0", "#e91e63",
+];
+const GRAYSCALE = [
+  "#ffffff", "#d9d9d9", "#bfbfbf", "#a6a6a6", "#8c8c8c",
+  "#737373", "#595959", "#404040", "#262626", "#000000",
+];
+const RECENT_LIMIT = 8;
+let recentColors: string[] = [];
+
+function parseColor(input: string): ParsedColor {
+  const match = /^#([\da-f]{3,4}|[\da-f]{6}|[\da-f]{8})$/i.exec(input.trim());
+  if (!match) return { hex: "#2962ff", opacity: 1 };
+  let value = match[1]!.toLowerCase();
+  if (value.length === 3 || value.length === 4) {
+    value = value.split("").map((char) => char + char).join("");
+  }
+  const alpha = value.length === 8 ? parseInt(value.slice(6, 8), 16) / 255 : 1;
+  return { hex: "#" + value.slice(0, 6), opacity: alpha };
+}
+
+function encodeColor(hex: string, opacity: number): string {
+  const alpha = Math.round(Math.max(0, Math.min(1, opacity)) * 255);
+  return alpha === 255 ? hex : hex + alpha.toString(16).padStart(2, "0");
+}
+
+function mixColor(color: string, target: string, amount: number): string {
+  const source = parseColor(color).hex.slice(1);
+  const destination = parseColor(target).hex.slice(1);
+  const channels = [0, 2, 4].map((index) => {
+    const start = parseInt(source.slice(index, index + 2), 16);
+    const end = parseInt(destination.slice(index, index + 2), 16);
+    return Math.round(start + (end - start) * amount).toString(16).padStart(2, "0");
+  });
+  return "#" + channels.join("");
+}
+
+function paletteRows(): string[][] {
+  return [
+    GRAYSCALE,
+    BASE_COLORS,
+    ...[0.82, 0.64, 0.46, 0.28].map((amount) => BASE_COLORS.map((color) => mixColor(color, "#ffffff", amount))),
+    ...[0.28, 0.58].map((amount) => BASE_COLORS.map((color) => mixColor(color, "#000000", amount))),
+  ];
+}
+
+const COLOR_ROWS = paletteRows();
+const PALETTE_COLORS = COLOR_ROWS.flat();
+
+function rememberColor(color: string): void {
+  recentColors = [color, ...recentColors.filter((item) => item !== color)].slice(0, RECENT_LIMIT);
+}
+
+function clampOpacity(value: number): number {
+  return Math.max(0, Math.min(1, value));
+}
+
+export function TradingViewColorPicker({
+  label,
+  value,
+  onChange,
+  name,
+  opacity,
+  onOpacity,
+  className = "",
+  popoverFooter,
+}: TradingViewColorPickerProps) {
+  const trigger = useRef<HTMLButtonElement>(null);
+  const popover = useRef<HTMLDivElement>(null);
+  const customInput = useRef<HTMLInputElement>(null);
+  const id = useId();
+  const [open, setOpen] = useState(false);
+  const [portalTarget, setPortalTarget] = useState<Element | null>(null);
+  const [position, setPosition] = useState({ top: 8, left: 8 });
+  const [recent, setRecent] = useState<string[]>(() => recentColors.slice());
+  const [activeColor, setActiveColor] = useState("#2962ff");
+  const parsed = parseColor(value);
+  const managesOpacity = opacity !== undefined && onOpacity !== undefined;
+  const activeOpacity = clampOpacity(managesOpacity ? opacity : parsed.opacity);
+  const [opacityText, setOpacityText] = useState(String(Math.round(activeOpacity * 100)));
+
+  useEffect(() => {
+    setOpacityText(String(Math.round(activeOpacity * 100)));
+  }, [activeOpacity]);
+
+  const updateColor = (nextColor: string) => {
+    const color = parseColor(nextColor).hex;
+    rememberColor(color);
+    setRecent(recentColors.slice());
+    if (managesOpacity) onChange(color);
+    else onChange(encodeColor(color, activeOpacity));
+  };
+
+  const updateOpacity = (nextOpacity: number) => {
+    const next = clampOpacity(nextOpacity);
+    setOpacityText(String(Math.round(next * 100)));
+    if (managesOpacity) onOpacity(next);
+    else onChange(encodeColor(parsed.hex, next));
+  };
+
+  const openPicker = () => {
+    if (open) {
+      setOpen(false);
+      return;
+    }
+    setPortalTarget(trigger.current?.closest("dialog") ?? document.body);
+    setRecent(recentColors.slice());
+    setActiveColor(PALETTE_COLORS.includes(parsed.hex) ? parsed.hex : "#2962ff");
+    setOpen(true);
+  };
+
+  useLayoutEffect(() => {
+    if (!open) return;
+    const place = () => {
+      const anchor = trigger.current?.getBoundingClientRect();
+      const popup = popover.current;
+      if (!anchor || !popup) return;
+      const gutter = 8;
+      const width = popup.offsetWidth;
+      const height = popup.offsetHeight;
+      const left = Math.max(gutter, Math.min(anchor.left, window.innerWidth - width - gutter));
+      const below = anchor.bottom + 6;
+      const top = below + height <= window.innerHeight - gutter
+        ? below
+        : Math.max(gutter, anchor.top - height - 6);
+      setPosition({ top, left });
+    };
+    const frame = requestAnimationFrame(() => {
+      place();
+      popover.current?.querySelector<HTMLButtonElement>('[data-palette-color="' + activeColor + '"]')?.focus();
+    });
+    window.addEventListener("resize", place);
+    window.addEventListener("scroll", place, true);
+    return () => {
+      cancelAnimationFrame(frame);
+      window.removeEventListener("resize", place);
+      window.removeEventListener("scroll", place, true);
+    };
+  }, [open, portalTarget, activeColor]);
+
+  useEffect(() => {
+    if (!open) return;
+    const onPointerDown = (event: PointerEvent) => {
+      const target = event.target;
+      if (!(target instanceof Node)) return;
+      if (trigger.current?.contains(target) || popover.current?.contains(target)) return;
+      setOpen(false);
+    };
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key !== "Escape") return;
+      event.preventDefault();
+      setOpen(false);
+      requestAnimationFrame(() => trigger.current?.focus());
+    };
+    document.addEventListener("pointerdown", onPointerDown, true);
+    document.addEventListener("keydown", onKeyDown, true);
+    return () => {
+      document.removeEventListener("pointerdown", onPointerDown, true);
+      document.removeEventListener("keydown", onKeyDown, true);
+    };
+  }, [open]);
+
+  const chooseColor = (color: string) => updateColor(color);
+  const rows = COLOR_ROWS;
+  const visibleRecent = recent.filter((color) => color !== parsed.hex).slice(0, RECENT_LIMIT - 1);
+  const percent = Math.round(activeOpacity * 100);
+  const popoverNode = open && portalTarget ? (
+    <div
+      ref={popover}
+      className="tv-color-picker"
+      role="dialog"
+      aria-label={label + " color picker"}
+      style={{ top: position.top, left: position.left }}
+    >
+      <div className="tv-color-picker__palette" role="grid" aria-label="Color palette">
+        {rows.map((row, rowIndex) => (
+          <div className="tv-color-picker__row" role="row" key={rowIndex}>
+            {row.map((color, columnIndex) => (
+              <div className="tv-color-picker__gridcell" role="gridcell" key={color}>
+                <button
+                  type="button"
+                  data-palette-color={color}
+                  tabIndex={activeColor === color ? 0 : -1}
+                  className={"tv-color-picker__swatch" + (parsed.hex === color ? " is-selected" : "")}
+                  style={{ backgroundColor: color }}
+                  title={color.toUpperCase()}
+                  aria-label={"Choose color " + color.toUpperCase()}
+                  aria-pressed={parsed.hex === color}
+                  onClick={() => {
+                    setActiveColor(color);
+                    chooseColor(color);
+                  }}
+                  onKeyDown={(event) => {
+                    const currentIndex = rowIndex * 10 + columnIndex;
+                    let nextIndex = currentIndex;
+                    if (event.key === "ArrowRight") nextIndex = Math.min(PALETTE_COLORS.length - 1, currentIndex + 1);
+                    else if (event.key === "ArrowLeft") nextIndex = Math.max(0, currentIndex - 1);
+                    else if (event.key === "ArrowDown") nextIndex = Math.min(PALETTE_COLORS.length - 1, currentIndex + 10);
+                    else if (event.key === "ArrowUp") nextIndex = Math.max(0, currentIndex - 10);
+                    else if (event.key === "Home") nextIndex = Math.floor(currentIndex / 10) * 10;
+                    else if (event.key === "End") nextIndex = Math.min(PALETTE_COLORS.length - 1, Math.floor(currentIndex / 10) * 10 + 9);
+                    else return;
+                    event.preventDefault();
+                    const nextColor = PALETTE_COLORS[nextIndex]!;
+                    setActiveColor(nextColor);
+                    requestAnimationFrame(() => popover.current?.querySelector<HTMLButtonElement>('[data-palette-color="' + nextColor + '"]')?.focus());
+                  }}
+                />
+              </div>
+            ))}
+          </div>
+        ))}
+      </div>
+
+      <div className="tv-color-picker__recent" role="group" aria-label="Recent colors">
+        <button
+          type="button"
+          className="tv-color-picker__recent-swatch tv-color-picker__recent-swatch--current"
+          style={{ ["--picker-current-color" as string]: "rgba(" + parseInt(parsed.hex.slice(1, 3), 16) + ", " + parseInt(parsed.hex.slice(3, 5), 16) + ", " + parseInt(parsed.hex.slice(5, 7), 16) + ", " + activeOpacity + ")" }}
+          title={"Current color " + parsed.hex.toUpperCase()}
+          aria-label={"Current color " + parsed.hex.toUpperCase()}
+          onClick={() => chooseColor(parsed.hex)}
+        />
+        {visibleRecent.map((color) => (
+          <button
+            key={color}
+            type="button"
+            className="tv-color-picker__recent-swatch"
+            style={{ backgroundColor: color }}
+            title={color.toUpperCase()}
+            aria-label={"Choose recent color " + color.toUpperCase()}
+            onClick={() => chooseColor(color)}
+          />
+        ))}
+        <button
+          type="button"
+          className="tv-color-picker__custom"
+          aria-label="Choose custom color"
+          title="Choose custom color"
+          onClick={() => customInput.current?.click()}
+        >
+          <span aria-hidden="true">+</span>
+        </button>
+        <input
+          ref={customInput}
+          className="tv-color-picker__native-input"
+          type="color"
+          aria-label="Custom color"
+          tabIndex={-1}
+          value={parsed.hex}
+          onChange={(event) => chooseColor(event.target.value)}
+        />
+      </div>
+
+      <div className="tv-color-picker__opacity">
+        <label htmlFor={id + "-opacity"}>Opacity</label>
+        <div className="tv-color-picker__opacity-row">
+          <input
+            id={id + "-opacity"}
+            type="range"
+            min="0"
+            max="100"
+            step="1"
+            value={percent}
+            aria-label="Opacity"
+            style={{ ["--picker-color" as string]: parsed.hex }}
+            onChange={(event) => updateOpacity(Number(event.target.value) / 100)}
+          />
+          <span className="tv-color-picker__percentage">
+            <input
+              type="text"
+              inputMode="numeric"
+              maxLength={3}
+              value={opacityText}
+              aria-label="Opacity percentage"
+              onChange={(event) => {
+                const nextText = event.target.value.replace(/[^\d]/g, "").slice(0, 3);
+                setOpacityText(nextText);
+                if (nextText !== "") updateOpacity(Number(nextText) / 100);
+              }}
+              onBlur={() => {
+                if (opacityText === "") setOpacityText(String(percent));
+                else updateOpacity(Number(opacityText) / 100);
+              }}
+              onKeyDown={(event) => {
+                if (event.key === "Enter") {
+                  event.preventDefault();
+                  event.currentTarget.blur();
+                }
+              }}
+            />
+            <span aria-hidden="true">%</span>
+          </span>
+        </div>
+      </div>
+      {popoverFooter ? <div className="tv-color-picker__footer">{popoverFooter}</div> : null}
+    </div>
+  ) : null;
+
+  return (
+    <>
+      {name ? <input type="hidden" name={name} value={value} /> : null}
+      <span className="opencharts tv-color-picker-trigger-host">
+      <button
+        ref={trigger}
+        type="button"
+        className={"tv-color-trigger " + className}
+        aria-label={label}
+        aria-haspopup="dialog"
+        aria-expanded={open}
+        onClick={openPicker}
+        onKeyDown={(event) => {
+          if (!open && (event.key === "ArrowDown" || event.key === "ArrowUp")) {
+            event.preventDefault();
+            openPicker();
+          }
+        }}
+      >
+        <span
+          className="tv-color-trigger__swatch"
+          style={{
+            ["--picker-current-color" as string]: "rgba(" + parseInt(parsed.hex.slice(1, 3), 16) + ", " + parseInt(parsed.hex.slice(3, 5), 16) + ", " + parseInt(parsed.hex.slice(5, 7), 16) + ", " + activeOpacity + ")",
+          }}
+        />
+        <span className="tv-color-trigger__chevron" aria-hidden="true">▾</span>
+      </button>
+      </span>
+      {portalTarget && popoverNode ? createPortal(
+        <div className="opencharts"><div className="tv-color-picker-portal">{popoverNode}</div></div>,
+        portalTarget,
+      ) : null}
+    </>
+  );
+}
